<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Los diálogos de error fatal, salida, archivos en uso y fuentes NO se definen acá:
       vienen de WixUI_Common (ver Product.wxs), que es el conjunto de la extensión de
       WiX hecho justamente para eso. Acá está solo el asistente de WinForge. -->
  <!-- =========================================================================
       Interfaz del instalador (Id="WixUI_WinForge", referenciada por Product.wxs).

       Es una UI propia, escrita a mano, y no el set genérico de la extensión de
       WiX: así no dependemos de sus diálogos ni arrastramos páginas que ya no
       aplican. Las páginas son:

         WFDirDlg     instalación nueva: bienvenida y qué se instala
         WFMaintDlg   ya instalado: reparar o quitar
         WFVerifyDlg  última confirmación (carpeta, accesos, tiempo)
         WFProgressDlg barra de progreso (la muestra el motor durante la copia)
         WFFinishDlg  terminó bien
         WFRemovedDlg terminó la desinstalación
         WFCancelDlg  confirmación de cancelar

       Estilo: el motor del MSI no deja cambiar el fondo de un diálogo ni la
       tipografía de un control suelto por CSS, así que la identidad visual entra
       por dos lados que sí son válidos en la tabla Control:
         * un Bitmap de 370x64 arriba (branding\banner.bmp): logo, marca, BETA y
           el filo de acento del tema;
         * TextStyle propios, aplicados por texto con el prefijo {\Estilo}.
       El resto es aire y jerarquía: título grande, cuerpo corto y ningún dato
       repetido entre páginas.

       Sobre la selección de pestañas: el instalador viejo tenía una página con las
       pestañas a mostrar (propiedades WF_TAB_*). Desde que el Workshop instala los
       componentes, la app LEE SOLO el set core (ComponentRegistry.CoreTags) e
       ignora el resto, así que una página con esos checks sería una mentira: se
       sacó a propósito y los valores de respaldo quedan en Product.wxs.
       ========================================================================= -->
  <Fragment>
    <!-- Branding: una sola franja para todas las páginas (ver Ui.wxs y
         installer/branding/banner.bmp). -->
    <Binary Id="WFBanner" SourceFile="branding\banner.bmp" />

    <UI Id="WixUI_WinForge">

      <!-- ===== Instalación nueva ===== -->
      <Dialog Id="WFDirDlg" Width="370" Height="270" Title="Instalar WinForge" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}Bienvenido a WinForge" />
        <Control Id="Intro" Type="Text" X="18" Y="104" Width="334" Height="30" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Optimizador, monitor y herramientas del sistema para Windows 10 y 11." />
        <Control Id="Bullet1" Type="Text" X="18" Y="140" Width="334" Height="14" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}•  Modo juego y biblioteca con cartuchos 3D" />
        <Control Id="Bullet2" Type="Text" X="18" Y="156" Width="334" Height="14" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}•  Monitoreo en vivo y optimizaciones de Windows" />
        <Control Id="Bullet3" Type="Text" X="18" Y="172" Width="334" Height="14" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}•  Instalación para todos los usuarios (pide administrador)" />
        <Control Id="Note" Type="Text" X="18" Y="204" Width="334" Height="14" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Se puede desinstalar desde Agregar o quitar programas." />
        <Control Id="Version" Type="Text" X="18" Y="220" Width="334" Height="14" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Versión [ProductVersion]" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Atrás" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Siguiente">
          <Publish Event="NewDialog" Value="WFVerifyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="WFCancelDlg" />
        </Control>
      </Dialog>

      <!-- ===== Ya está instalado: reparar o quitar ===== -->
      <Dialog Id="WFMaintDlg" Width="370" Height="270" Title="WinForge ya está instalado" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}WinForge ya está instalado" />
        <Control Id="Intro" Type="Text" X="18" Y="104" Width="334" Height="40" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Podés reparar la instalación (vuelve a copiar los archivos y los accesos directos) o quitar WinForge de este equipo." />
        <Control Id="FolderCaption" Type="Text" X="18" Y="150" Width="334" Height="12" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Instalado en" />
        <Control Id="FolderValue" Type="Text" X="18" Y="164" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFPath}[INSTALLFOLDER]" />

        <Control Id="Repair" Type="PushButton" X="18" Y="204" Width="90" Height="20" Default="yes" Text="Reparar">
          <Publish Property="REMOVE" Value="{}" />
          <Publish Property="REINSTALL" Value="ALL" />
          <Publish Property="REINSTALLMODE" Value="vomus" />
          <Publish Event="NewDialog" Value="WFProgressDlg" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="114" Y="204" Width="90" Height="20" Text="Quitar">
          <Publish Property="REINSTALL" Value="{}" />
          <Publish Property="REMOVE" Value="ALL" />
          <Publish Event="NewDialog" Value="WFProgressDlg" />
        </Control>

        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="WFCancelDlg" />
        </Control>
      </Dialog>

      <!-- ===== Última confirmación ===== -->
      <Dialog Id="WFVerifyDlg" Width="370" Height="270" Title="Listo para instalar" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}Listo para instalar" />
        <Control Id="Intro" Type="Text" X="18" Y="104" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Esto es lo que va a quedar configurado." />

        <Control Id="FolderCaption" Type="Text" X="18" Y="132" Width="334" Height="12" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Carpeta de instalación" />
        <Control Id="FolderValue" Type="Text" X="18" Y="146" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFPath}[INSTALLFOLDER]" />

        <Control Id="ShortcutCaption" Type="Text" X="18" Y="172" Width="334" Height="12" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Accesos directos" />
        <Control Id="ShortcutValue" Type="Text" X="18" Y="186" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Escritorio y menú Inicio" />

        <Control Id="Note" Type="Text" X="18" Y="212" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}La copia tarda menos de un minuto." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Atrás">
          <Publish Event="NewDialog" Value="WFDirDlg" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="WFMaintDlg" Condition="Installed" />
        </Control>
        <Control Id="Install" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 ElevationShield="yes" Text="Instalar">
          <!-- EndDialog Return devuelve el control a la secuencia de UI: el motor
               muestra la barra de progreso y ejecuta la instalación de verdad. -->
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancelar">
          <Publish Event="SpawnDialog" Value="WFCancelDlg" />
        </Control>
      </Dialog>

      <!-- ===== Progreso (lo muestra el motor durante la copia de archivos) ===== -->
      <!-- Modeless="yes" es OBLIGATORIO acá: esta es la ventana que queda visible durante
           ExecuteAction. Modal y sin botones (como estaba) hace que el motor quede esperando
           el EndDialog de una ventana que nunca lo publica — el asistente se cuelga "cargando"
           para siempre justo al entrar a la barra de progreso (medido: el log muere en
           'La acción se inició: WFProgressDlg' y nunca arranca la secuencia de ejecución).
           Es exactamente como lo definen los instaladores estándar de Windows. -->
      <Dialog Id="WFProgressDlg" Width="370" Height="270" Title="Instalando WinForge" Modeless="yes" NoMinimize="yes">
        <!-- TabSkip="no": la página de progreso no tiene botones, y el motor exige un
             control al que se pueda ir con el teclado (si no, la ventana queda sin foco). -->
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes" TabSkip="no"
                 Text="{\WFTitle}Instalando WinForge" />
        <Control Id="Intro" Type="Text" X="18" Y="104" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}No cierres esta ventana." />
        <!-- Los Id ActionText / ActionData / ProgressBar son los que usa el motor
             para contar el avance: no se renombran. -->
        <Control Id="ActionText" Type="Text" X="18" Y="144" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}[ActionText]" />
        <Control Id="ActionData" Type="Text" X="18" Y="162" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}[ActionData]" />
        <Control Id="ProgressBar" Type="ProgressBar" X="18" Y="192" Width="334" Height="12" ProgressBlocks="yes"
                 Text="Esto puede tardar un minuto." />
        <Control Id="ProgressText" Type="Text" X="18" Y="212" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}[Progress]" />
      </Dialog>

      <!-- ===== Terminó bien (instalación o desinstalación) =====
           Un solo diálogo para los dos casos, con los textos alternados por condición,
           así no aparecen dos ventanas seguidas. En la secuencia se despliega como
           "virtual ... OnExit=success": eso le da el nombre estándar Exit que el motor
           busca (ver Product.wxs) sin tener que llamar al diálogo Exit. -->
      <Dialog Id="WFFinishDlg" Width="370" Height="270" Title="WinForge" NoMinimize="yes">
        <!-- Cada variante necesita Show + Hide: el estado por defecto de un control es
             visible, y una condición Show falsa NO lo oculta (solo un evento Hide lo hace).
             Sin el Hide, al desinstalar quedaban los dos textos superpuestos en la misma
             posición (volcado de la tabla ControlCondition: solo había filas Show). -->
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}WinForge está listo" ShowCondition="NOT REMOVE=&quot;ALL&quot;" HideCondition="REMOVE=&quot;ALL&quot;" />
        <Control Id="TitleRemoved" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}WinForge se quitó del equipo" ShowCondition="REMOVE=&quot;ALL&quot;" HideCondition="NOT REMOVE=&quot;ALL&quot;" />

        <Control Id="IntroInstall" Type="Text" X="18" Y="104" Width="334" Height="40" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Se copiaron los archivos y se crearon los accesos directos."
                 ShowCondition="NOT REMOVE=&quot;ALL&quot;" HideCondition="REMOVE=&quot;ALL&quot;" />
        <Control Id="HintInstall" Type="Text" X="18" Y="150" Width="334" Height="16" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Abrí WinForge desde el escritorio o el menú Inicio."
                 ShowCondition="NOT REMOVE=&quot;ALL&quot;" HideCondition="REMOVE=&quot;ALL&quot;" />

        <Control Id="IntroRemoved" Type="Text" X="18" Y="104" Width="334" Height="40" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Se borraron los archivos y los accesos directos."
                 ShowCondition="REMOVE=&quot;ALL&quot;" HideCondition="NOT REMOVE=&quot;ALL&quot;" />
        <Control Id="HintRemoved" Type="Text" X="18" Y="150" Width="334" Height="40" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Tus datos (configuración, componentes descargados) quedan en tu perfil por si volvés a instalar."
                 ShowCondition="REMOVE=&quot;ALL&quot;" HideCondition="NOT REMOVE=&quot;ALL&quot;" />

        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finalizar">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- ===== Confirmar cancelación ===== -->
      <Dialog Id="WFCancelDlg" Width="260" Height="95" Title="Cancelar" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="12" Width="230" Height="20" NoPrefix="yes"
                 Text="{\WFTitle}¿Cancelar la instalación?" />
        <Control Id="Question" Type="Text" X="15" Y="38" Width="230" Height="26" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}No se va a cambiar nada en el equipo." />
        <Control Id="Yes" Type="PushButton" X="72" Y="67" Width="56" Height="17" Default="yes" Text="Sí">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="132" Y="67" Width="56" Height="17" Cancel="yes" Text="No">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

    </UI>
  </Fragment>

  <!-- =========================================================================
       Diálogos que el MOTOR de Windows Installer muestra por su cuenta, no el flujo
       del asistente: cuando la instalación falla, cuando el usuario cancela, cuando
       un archivo está en uso y cuando el motor necesita preguntar algo.

       Se escriben acá a mano y en español (en vez de usar los de la extensión de WiX)
       por tres razones concretas:
         * los nombres y los identificadores son los que el motor busca, y son fijos:
           los diálogos se llaman FatalError, UserExit, Exit y FilesInUse, y los botones
           del diálogo de error se llaman Y, A, C, I, N, O, R (el motor muestra u oculta
           cada uno según el error);
         * los de la extensión están en inglés salvo que se arrastre su localización
           completa, y esta app es en español;
         * la extensión trae bitmaps y textos que no usamos (WixUI_Common solo aporta
           una tabla de textos interna, no estos diálogos: sin ellos, un fallo o una
           cancelación terminaban sin ningún mensaje en pantalla).
       ========================================================================= -->
  <Fragment>
    <UI Id="WixUI_WinForgeErrores">
      <!-- Fuente de la interfaz: el motor la exige (ICE31) y sin ella sus propios
           diálogos salen con la fuente del sistema. El estilo y las propiedades van
           adentro del UI porque ahí es donde WiX los declara.

           Los estilos extra son la ÚNICA forma de dar jerarquía tipográfica en un MSI:
           el Control no tiene fuente propia, se le pone el prefijo {\Id} al texto. -->
      <TextStyle Id="WFFont" FaceName="Segoe UI" Size="9" Red="0" Green="0" Blue="0" />
      <Property Id="DefaultUIFont" Value="WFFont" />
      <TextStyle Id="WFTitle" FaceName="Segoe UI" Size="15" Bold="yes" Red="12" Green="21" Blue="36" />
      <TextStyle Id="WFBody" FaceName="Segoe UI" Size="9" Red="62" Green="70" Blue="82" />
      <TextStyle Id="WFMuted" FaceName="Segoe UI" Size="8" Red="112" Green="120" Blue="132" />
      <TextStyle Id="WFPath" FaceName="Consolas" Size="9" Red="20" Green="32" Blue="52" />

      <!-- Diálogo de error del motor (el que pregunta "Reintentar/Cancelar"): nunca lo
           mostramos nosotros, lo abre el motor cuando necesita preguntar algo (por
           ejemplo si un archivo quedó bloqueado). Se declara acá la propiedad que lo
           habilita y el diálogo lo aporta la extensión de WiX: es el único de estos
           diálogos que no se reescribe, porque sus botones (Sí/No/Cancelar/Ignorar/
           Anular/Reintentar) los muestra u oculta el propio motor según el error, y
           duplicarlo a mano choca con el que trae la extensión. Su texto sale en el
           idioma del paquete (ver -culture en build-installer.ps1). -->
      <PropertyRef Id="ErrorDialog" />


      <Dialog Id="WFFatalErrorDlg" Width="370" Height="270" Title="WinForge" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}La instalación no se pudo completar" />
        <Control Id="Description" Type="Text" X="18" Y="104" Width="334" Height="110" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}Windows Installer no pudo terminar la operación. Si estaba instalando, no se aplicó ningún cambio; si estaba desinstalando, WinForge sigue instalado y podés volver a intentarlo. El detalle exacto del error queda en el registro del instalador (msiexec /l*v)." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Atrás" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finalizar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancelar" />
      </Dialog>

      <Dialog Id="WFUserExitDlg" Width="370" Height="270" Title="WinForge" NoMinimize="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}Se canceló la instalación" />
        <Control Id="Description" Type="Text" X="18" Y="104" Width="334" Height="110" NoPrefix="yes" Transparent="yes"
                 Text="{\WFBody}No se cambió nada en el equipo: los archivos copiados se revierten." />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Atrás" />
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Finalizar">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancelar" />
      </Dialog>

      <!-- Archivos en uso: lo abre el motor durante InstallValidate cuando algo quedó
           abierto (por ejemplo WinForge corriendo). Los identificadores de los botones y
           la lista NO se cambian: el motor escribe en FileInUseProcess y espera
           exactamente Retry / Ignore / Exit. -->
      <Dialog Id="FilesInUse" Width="370" Height="270" Title="Archivos en uso" NoMinimize="yes" KeepModeless="yes">
        <Control Id="Banner" Type="Bitmap" X="0" Y="0" Width="370" Height="64" TabSkip="no" Text="WFBanner" />
        <Control Id="Title" Type="Text" X="18" Y="76" Width="334" Height="26" NoPrefix="yes"
                 Text="{\WFTitle}Algunos archivos están en uso" />
        <Control Id="Description" Type="Text" X="18" Y="104" Width="334" Height="16" Transparent="yes" NoPrefix="yes"
                 Text="{\WFBody}Cerrá los programas de la lista y elegí Reintentar." />
        <Control Id="Text" Type="Text" X="18" Y="126" Width="334" Height="34" NoPrefix="yes" Transparent="yes"
                 Text="{\WFMuted}Windows no puede reemplazar los archivos que están abiertos. Si no los cerrás, vas a tener que reiniciar el equipo para que la instalación termine." />
        <Control Id="List" Type="ListBox" X="18" Y="168" Width="334" Height="60" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="Retry" Type="PushButton" X="304" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="Reintentar">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="235" Y="243" Width="56" Height="17" Text="Ignorar">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Exit" Type="PushButton" X="166" Y="243" Width="56" Height="17" Text="Salir">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

    </UI>
  </Fragment>
</Wix>
