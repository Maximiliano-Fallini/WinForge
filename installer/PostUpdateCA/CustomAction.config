<?xml version="1.0" encoding="utf-8" ?>
<!--
  Este archivo es lo que hace que la CustomAction administrada cargue.

  Por qué existe: el stub SfxCA que ejecuta el motor de Windows Installer intenta
  enlazar con CLR 2.0 (v2.0.50727) por compatibilidad histórica, y entonces cualquier
  ensamblado compilado para .NET 4.x falla con BadImageFormatException ("este ensamblado
  se creó con un tiempo de ejecución más reciente que el tiempo de ejecución cargado").

  SfxCA lee este archivo (tiene que llamarse exactamente así y viajar dentro de
  PostUpdateCA.CA.dll) para saber qué runtime pedir. Declaramos CLR 4 y el perfil de
  .NET Framework con el que se compila PostUpdateCA (net462 en el .csproj): así el
  motor carga el runtime correcto y la CA corre.

  useLegacyV2RuntimeActivationPolicy="true" es la convención de DTF: permite que un
  host de CLR 4 cargue ensamblados mixtos (C++/CLI) como el propio stub.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
</configuration>
