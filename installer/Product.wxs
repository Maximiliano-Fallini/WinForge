<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- ProductCode: nuevo por versión porque cambió el contenido (major upgrade)
       (el UpgradeCode queda igual para que el MSI nuevo reemplace al anterior) -->
  <Package Name="WinForge"
           Manufacturer="WinForge"
           Version="0.6.6"
           ProductCode="{FCFB6A44-C51F-46BB-ACC5-D19CA1669906}"
           UpgradeCode="{67AA0858-5D06-4CA6-9B86-8892395BF0C4}"
           Language="3082"
           Scope="perMachine"
           InstallerVersion="500">

    <!-- Actualizaciones: reemplaza la versión anterior sin dejar restos -->
    <MajorUpgrade DowngradeErrorMessage="Ya existe una versión más reciente de WinForge instalada." />

    <!-- Log automático de cada instalación: con esta propiedad en la tabla, Windows
         Installer escribe %TEMP%\MSI*.LOG por su cuenta, sin que nadie tenga que
         acordarse de /l*v. Es lo que permite diagnosticar un "se quedó quieta la barra
         de progreso": el log dice exactamente en qué acción estaba y qué error hubo.
         (El valor son las categorías de mensajes: status, warnings, errores, arranque de
         acciones, registros por acción, peticiones del usuario, params de UI, memoria,
         disco, propiedades, verbose y debugging). -->
    <Property Id="MsiLogging" Value="voicewarmupx" />

    <!-- Todo comprimido dentro del .msi (un solo archivo) -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />


    <!-- Icono para accesos directos y el panel de Programas -->
    <Icon Id="WinForgeIco" SourceFile="publish\Assets\WinForge.ico" />
    <Property Id="ARPPRODUCTICON" Value="WinForgeIco" />
    <Property Id="ARPPUBLISHER" Value="WinForge" />
    <Property Id="ARPCONTACT" Value="WinForge" />
    <Property Id="ARPCOMMENTS" Value="WinForge 0.6.6 Beta - optimizador y monitor del sistema" />

    <!-- Accesos directos opcionales: los elige el usuario en la última página del
         asistente (WFVerifyDlg) con dos checks. Nacen en 1 para que una instalación
         silenciosa (el auto-updater) los cree igual, y Secure="yes" los pasa a la
         parte elevada del instalador, que es donde se evalúa la condición de cada
         componente: sin eso, un check destildado no llegaría al tramo que copia. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="STARTMENUSHORTCUT" Value="1" Secure="yes" />

    <!-- Cierra WinForge antes de tocar archivos (instala, repara, actualiza o desinstala).
         Por qué ANTES de InstallValidate y SIEMPRE: con la app abierta, el motor del MSI
         detecta los archivos en uso justo ahí y muestra el diálogo "estas aplicaciones están
         usando archivos que hay que actualizar" — que en el asistente completo puede quedar
         DETRÁS de la ventana de progreso y el usuario ve una barra congelada sin saber que
         hay un diálogo esperando atrás. Cerrarla antes evita el diálogo.

         Por qué INMEDIATA (no diferida): ICE77 prohíbe CAs diferidas fuera del tramo
         InstallInitialize..InstallFinalize, e InstallValidate es anterior a ese tramo. Una
         CA inmediata corre con los privilegios del proceso del instalador (elevado: puede
         matar también a la app elevada) y Return="ignore" hace que un taskkill sin nada
         que matar no importe (app ya cerrada: caso normal en primera instalación). -->
    <CustomAction Id="KillWinForge"
                  Directory="System64Folder"
                  ExeCommand="taskkill.exe /IM WinForge.exe /F"
                  Return="ignore" />
    <!-- Borra la tarea programada de inicio automático (la crea la app con
         schtasks al activar "Iniciar con Windows"). Sin comillas anidadas: el
         comando es simple y no hay riesgo de quoting en el motor del MSI. -->
    <CustomAction Id="DeleteStartupTask"
                  Directory="System64Folder"
                  ExeCommand="schtasks.exe /Delete /F /TN WHPO"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- PROPERTY_PATH: línea de comandos con la que el auto-updater quiere que
         la app se reabra al terminar la instalación. Secure="yes" es obligatorio:
         las propiedades que pasa msiexec por línea de comandos solo llegan a la
         porción elevada del instalador si están en SecureCustomProperties. -->
    <Property Id="PROPERTY_PATH" Secure="yes" />

    <!-- CustomAction administrado (C#) que reabre WinForge después de la
         actualización: el auto-updater de la app descarga el MSI y lo instala
         silencioso pasándole PROPERTY_PATH con la línea de comandos actual
         ("C:\...\WinForge.exe" más sus argumentos); el instalador vuelve a abrir
         la app con esa línea al terminar. Son dos CA sobre la misma dll: una
         inmediata (SetLaunchCommandData) copia la propiedad a CustomActionData,
         único canal legible por una CA diferida, y la diferida
         (RunWinForgeAfterUpgrade) crea el proceso. -->
    <Binary Id="PostUpdateCA" SourceFile="PostUpdateCA.CA.dll" />
    <CustomAction Id="SetLaunchCommandData"
                  BinaryRef="PostUpdateCA"
                  DllEntry="SetLaunchCommandData"
                  Return="ignore" />
    <CustomAction Id="RunWinForgeAfterUpgrade"
                  BinaryRef="PostUpdateCA"
                  DllEntry="LaunchAfterUpgrade"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <InstallExecuteSequence>
      <!-- Siempre antes de InstallValidate (que es donde el motor detecta archivos en uso
           y puede mostrar el diálogo que se esconde detrás del progreso). Inmediata: permitido
           antes de InstallInitialize. Sin condición: instalar, reparar, actualizar y desinstalar. -->
      <Custom Action="KillWinForge" Before="InstallValidate" />
      <!-- La tarea de inicio se borra adentro del script (ICE77: diferida = entre
           InstallInitialize e InstallFinalize), antes de quitar archivos. -->
      <Custom Action="DeleteStartupTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- Después de instalar (commit) solo en instalaciones nuevas o upgrades:
           primero la CA inmediata copia PROPERTY_PATH a CustomActionData y luego
           la diferida reabre la app con esa línea. La creación del proceso se
           atrasa ~1 s porque el MSI cierra WinForge con taskkill y puede seguir vivo
           unos milisegundos al terminar la instalación.

           Este es el ÚLTIMO paso de la fase diferida (Before="InstallFinalize") a
           propósito: cuando la app arranca, ya se copiaron los archivos, se escribió
           el registro y se crearon los accesos directos. -->
      <Custom Action="SetLaunchCommandData" Before="RunWinForgeAfterUpgrade" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="RunWinForgeAfterUpgrade" Before="InstallFinalize" Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Secuencia de la interfaz (los diálogos están en UI.wxs). Dos reglas del motor
         de Windows Installer que importan acá:
           * el diálogo que tiene la barra de progreso se muestra durante la copia de
             archivos solo si es el inmediatamente anterior a ExecuteAction;
           * el diálogo siguiente se muestra cuando ExecuteAction termina, por eso el
             de fin va después y con condición (instaló o desinstaló).
         El paquete se puede instalar en silencio (el actualizador lo hace así): en ese
         caso nada de esto se ejecuta. -->
    <InstallUISequence>
      <Show Dialog="WFDirDlg" Before="WFProgressDlg" Condition="NOT Installed" />
      <Show Dialog="WFMaintDlg" Before="WFProgressDlg" Condition="Installed" />
      <Show Dialog="WFProgressDlg" Before="ExecuteAction" />
      <!-- El motor de Windows Installer busca en esta secuencia las filas 'Exit'
           (terminó bien), 'FatalError' (falló) y 'UserExit' (el usuario canceló):
           esos nombres son fijos. El prefijo 'virtual' es lo que los da sin renombrar
           los diálogos, que siguen siendo los propios y en español (ver UI.wxs).

           El de fin es uno solo para los dos casos (instaló o desinstaló): los textos
           cambian por condición dentro del diálogo, así no aparecen dos ventanas. -->
      <Show Dialog="virtual WFFinishDlg" OnExit="success" />
      <Show Dialog="virtual WFFatalErrorDlg" OnExit="error" />
      <Show Dialog="virtual WFUserExitDlg" OnExit="cancel" />
    </InstallUISequence>

    <!-- La instalación administrativa (msiexec /a) también valida la interfaz:
         los mismos tres diálogos, sin el flujo del asistente. -->
    <AdminUISequence>
      <Show Dialog="virtual WFFinishDlg" OnExit="success" />
      <Show Dialog="virtual WFFatalErrorDlg" OnExit="error" />
      <Show Dialog="virtual WFUserExitDlg" OnExit="cancel" />
    </AdminUISequence>

    <!-- UI con los diálogos propios de WinForge (ver UI.wxs) -->
    <UIRef Id="WixUI_WinForge" />
    <!-- Los que muestra el motor por su cuenta: error fatal, cancelación, fin, archivos
         en uso y el de error no fatal (ver UI.wxs). -->
    <UIRef Id="WixUI_WinForgeErrores" />

    <!-- WixUI_Common de la extensión de WiX aporta la tabla de textos internos del motor
         (bytes, MB, nombres de menú, etc.) y una UI vacía que existe solo para poder
         referenciarla. Ojo: NO trae los diálogos estándar — esos se escribieron a mano
         en UI.wxs, en español. -->
    <ui:WixUI Id="WixUI_Common" />
    <!-- Además del anterior (que resuelve a la UI vacía de la plataforma), esto trae el
         fragmento con los textos internos y los binarios de la extensión: sin él, el
         ícono del diálogo de error del motor queda apuntando a un binario que no existe
         (ICE17). -->
    <UIRef Id="WixUI_Common" />



    <!-- Selección de pestañas elegida en el instalador: HKLM\Software\WinForge\InstallTabs\<tag>
         = "1" visible / vacío oculto. La app la aplica en su primer arranque.
         Nota: desde que el Workshop instala los componentes, la app lee SOLO el set core
         (ComponentRegistry.CoreTags: sistema, red, nucleos, procesos, workshop,
         configuracion) e ignora el resto; los valores de los tags no core quedan acá por
         compatibilidad con instalaciones viejas. -->
    <Component Id="Cmp_InstallTabs" Guid="{8E3D1A52-4B4E-4A1E-9C22-6F0D7E2B3A11}">
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="sistema" Value="1" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="red" Value="1" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="memoria" Value="1" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="nucleos" Value="1" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="teclado" Value="1" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\WinForge\InstallTabs" Name="configuracion" Value="1" Type="string" />
      <!-- Marca de primer arranque: la app crea la tarea de inicio automático
           con su propio mecanismo schtasks al abrirse por primera vez tras la
           instalación, así "Iniciar con Windows" funciona de entrada en
           cualquier máquina. La app borra el valor al consumirlo. -->
      <RegistryValue Root="HKLM" Key="Software\WinForge" Name="FirstRunStartup" Value="1" Type="string" />
    </Component>

    <!-- Acceso directo en el escritorio -->
    <StandardDirectory Id="DesktopFolder">
      <!-- Condition: si el usuario destildó «En el escritorio» el componente no se
           instala (y no deja el valor de registro que lo marca). Al desinstalar se
           quita igual si estaba instalado: las condiciones no intervienen ahí. -->
      <Component Id="Cmp_DesktopShortcut" Guid="{249C137C-68B4-456B-AC14-3B87FE545357}" Condition="DESKTOPSHORTCUT">
        <Shortcut Id="DesktopShortcut"
                  Name="WinForge"
                  Target="[INSTALLFOLDER]WinForge.exe"
                  Icon="WinForgeIco"
                  WorkingDirectory="INSTALLFOLDER" />
        <!-- KeyPath HKCU: ICE43 lo exige para accesos directos no anunciados (estandar MSI) -->
        <RegistryValue Root="HKCU" Key="Software\WinForge" Name="desktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Menú Inicio: lanzar + desinstalar -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuWinForge" Name="WinForge">
        <Component Id="Cmp_StartMenuShortcuts" Guid="{D603F0F3-3959-4235-8F15-9C4C5DE87874}" Condition="STARTMENUSHORTCUT">
          <Shortcut Id="StartMenuShortcut"
                    Name="WinForge"
                    Target="[INSTALLFOLDER]WinForge.exe"
                    Icon="WinForgeIco"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UninstallShortcut"
                    Name="Desinstalar WinForge"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RemoveStartMenuWinForge" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\WinForge" Name="startMenuShortcuts" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="WinForge" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Cmp_DesktopShortcut" />
      <ComponentRef Id="Cmp_StartMenuShortcuts" />
      <ComponentRef Id="Cmp_InstallTabs" />
    </Feature>
  </Package>
</Wix>
