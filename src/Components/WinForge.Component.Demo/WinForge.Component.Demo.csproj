<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinForge.Component.Demo</RootNamespace>
    <AssemblyName>WinForge.Component.Demo</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <!-- Componente WinUI SOLO con UI en código: sin XAML compilado (los
         assemblies cargados por AssemblyLoadContext no traen su propio
         XamlTypeInfo). UseWinUI=true da las referencias a Microsoft.WinUI. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Versión del componente: viaja al manifest (components.json) al publicar. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- El contrato IWinForgeComponent vive en WHPO.Core (también la app lo
         carga en su ALC por defecto: la DLL de Core NO viaja en el zip). -->
    <ProjectReference Include="..\..\WHPO.Core\WHPO.Core.csproj" />
  </ItemGroup>
</Project>
