<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinForge.Component.Benchmark</RootNamespace>
    <AssemblyName>WinForge.Component.Benchmark</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <!-- Componente WinUI SOLO con UI en código: sin XAML compilado (los
         assemblies cargados por AssemblyLoadContext no traen su propio
         XamlTypeInfo). UseWinUI=true da las referencias a Microsoft.WinUI. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Las llamadas a D3D/DXGI van por punteros, igual que los callbacks de ventana. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Una librería de clases NO copia sus dependencias NuGet al bin (las resuelve el exe
         que la consume): el zip del componente salía sin las DLL de Vortice/SharpGen y el
         AssemblyLoadContext del Workshop no las encontraba. Con esto el bin del componente
         lleva SUS dependencias y el script de empaquetado las mete en el zip. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Versión del componente: viaja al manifest (components.json) al publicar. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <!-- Dibujo del HUD de la escena (mismo paquete y versión que usa la app, que lo resuelve
         desde su propio contexto: el zip del componente no lleva los assemblies System.*). -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- Bindings managed a las APIs gráficas. NO traen DLLs nativas propias (usan
         d3d11.dll/d3d12.dll/dxgi.dll/d3dcompiler_47.dll del sistema), así que viajan
         en el zip del componente y el AssemblyLoadContext del Workshop los resuelve
         desde la carpeta del componente. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- El contrato IWinForgeComponent vive en WHPO.Core (también la app lo
         carga en su ALC por defecto: la DLL de Core NO viaja en el zip). -->
    <ProjectReference Include="..\..\WHPO.Core\WHPO.Core.csproj" />
  </ItemGroup>
</Project>
