<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Versión de la app: en sincronía con WHPO.UI.csproj (el chequeo de actualizaciones
         lee el ensamblado de entrada, y el instalador local toma esta versión al
         publicar; installer\ vive en el disco del desarrollador: no se versiona) -->
    <Version>0.5.8</Version>
    <InformationalVersion>0.5.8-beta</InformationalVersion>
    <!-- Habilitar COM para System.Management (WMI) -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Catálogo de optimizaciones: los 418 ajustes de Windows con sus textos en 5
       idiomas. Va embebido (el LogicalName es el que busca OptimizationCatalogProvider)
       para que la pantalla de Optimizaciones no dependa de un archivo suelto. -->
  <ItemGroup>
    <EmbeddedResource Include="Optimizations\optimization-catalog.json"
                      LogicalName="WHPO.Core.Optimizations.optimization-catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
    <!-- LibreHardwareMonitor 0.9.6 está compilado contra las 10.x de estos
         ensamblados. Al publicar self-contained, los del framework se reemplazan
         por los del runtime pack (9.0.0.0) y LHM no carga (MissingMethodException
         en System.Threading.AccessControl 10.0.0.0). Referencia directa para que
         el paquete 10.0.3 gane sobre el runtime pack, igual que System.Management. -->
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.3" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

</Project>
