<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <!-- Versión de la app: la lee AppUpdateService para el chequeo de actualizaciones.
         Al publicar, llevar 0.1.5 junto con WHPO.Core.csproj, installer/Product.wxs
         y installer/build-installer.ps1 -->
    <Version>0.1.5</Version>
    <InformationalVersion>0.1.5-beta</InformationalVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WHPO_UI</RootNamespace>
    <!-- El ejecutable se llama WinForge.exe (no WHPO.UI.exe) -->
    <AssemblyName>WinForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icono de WinForge embebido en el exe (Explorer + barra de tareas) -->
    <ApplicationIcon>Assets\WinForge.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUIXamlCompiler>false</UseWinUIXamlCompiler>
    <SkipGetXamlCompileDepsFile>true</SkipGetXamlCompileDepsFile>
    <GenerateXamlSourceFiles>false</GenerateXamlSourceFiles>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Self-contained deployment for debugging -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\WinForge.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- Logo de WinForge: se copia al output para el icono de bandeja/ventana y el header -->
    <Content Include="logos\WinForge.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fondo del asistente de primera configuración -->
    <Content Include="logos\backgroundinstaller\banner.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Logos de launchers (Steam/Epic/Battle.net/Ubisoft/EA/GOG/Xbox): badge en la card de juegos -->
    <Content Include="logos\launcher\steamlogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\epicgameslogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\battlenet.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\ubisoftlogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\ealogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\goglogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\xboxlogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logos\launcher\riotlogo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WHPO.Core\WHPO.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <!-- Trimming deshabilitado porque System.Management (WMI) requiere COM -->
  </PropertyGroup>

  <!-- Post-build event to copy exe to fixed location for debugging -->
  <Target Name="CopyExeToFixedLocation" AfterTargets="Build">
    <PropertyGroup>
      <FixedExeDir>$(MSBuildThisFileDirectory)..\bin\Debug\WHPO.Debug\</FixedExeDir>
    </PropertyGroup>
    <MakeDir Directories="$(FixedExeDir)" Condition="!Exists('$(FixedExeDir)')" />
    <!-- Copy entire output directory (including subdirectories) -->
    <ItemGroup>
      <OutputFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)**\*.pdb;$(TargetDir)**\*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(OutputFiles)" DestinationFiles="@(OutputFiles->'$(FixedExeDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Copied exe and all dependencies to: $(FixedExeDir)" />
  </Target>
</Project>
