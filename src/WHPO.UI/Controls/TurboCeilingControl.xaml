<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WHPO_UI.Controls.TurboCeilingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
<!-- Botón de ayuda ("qué hace") que acompaña a cada nombre de ajuste en la card del
             techo de turbo. Mismo aspecto que los que se arman en código con
             TooltipStyles.CreateInfoButton: chico, sin fondo, con el ícono de información. -->
        <Style x:Key="InfoIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

<!-- ============ TECHO DE TURBO ============ -->
    <Border Background="{ThemeResource CardBackgroundBrush}"
            CornerRadius="12"
            Padding="16">
        <Grid>
<!-- ===== SKELETON DE CARGA =====
             La lectura del estado (powercfg + registro del catálogo de energía) tarda y
             la card se veía vacía mientras tanto: barras sin valor, desplegable sin
             contenido. El esqueleto tiene las MISMAS filas que la card real (encabezado,
             descripción, perfil, dos ajustes y pie) para que nada salte al llegar el
             estado. Se anima con el mismo pulso de opacidad que el resto de la app. -->
            <StackPanel x:Name="TurboSkeleton" Spacing="14" IsHitTestVisible="False">
<!-- Encabezado: ícono + título y el chip del plan activo -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Rectangle Width="16" Height="16" RadiusX="4" RadiusY="4"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Width="140" Height="16" RadiusX="8" RadiusY="8"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="150" Height="24" RadiusX="6" RadiusY="6"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                </Grid>
<!-- Descripción (dos líneas) -->
                <StackPanel Spacing="6">
                    <Rectangle Height="12" RadiusX="6" RadiusY="6"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    <Rectangle Width="360" Height="12" HorizontalAlignment="Left" RadiusX="6" RadiusY="6"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                </StackPanel>
<!-- Perfil de energía: etiqueta a la izquierda, atajos y desplegable a la derecha -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Rectangle Width="14" Height="14" RadiusX="4" RadiusY="4"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Width="110" Height="13" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Rectangle Width="52" Height="28" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Width="210" Height="32" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
<!-- Los dos ajustes: nombre, valor y barra -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="28" RowSpacing="16">
                    <StackPanel Spacing="8">
                        <Rectangle Width="110" Height="13" HorizontalAlignment="Left" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Width="70" Height="13" HorizontalAlignment="Right" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Height="30" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <Rectangle Width="150" Height="13" HorizontalAlignment="Left" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Width="70" Height="13" HorizontalAlignment="Right" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        <Rectangle Height="30" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
<!-- Pie: alcance del cambio y el botón Aplicar -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Rectangle Width="260" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                               RadiusX="6" RadiusY="6"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    <Rectangle Grid.Column="1" Width="110" Height="36" RadiusX="6" RadiusY="6"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                </Grid>
            </StackPanel>

<!-- Contenido real: arranca oculto y lo muestra ShowContent cuando el estado llega. -->
        <StackPanel x:Name="TurboContent" Spacing="14" Visibility="Collapsed">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Techo de turbo" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{ThemeResource ChipBackgroundBrush}"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TurboPlanChipText" FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock Text="Movés el techo de frecuencia del procesador dentro del plan de energía activo. Bajar el límite no acelera nada: cambia calor y ruido por rendimiento. No es overclock ni supera el turbo que el procesador ya admite."
                       FontSize="12"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>

<!-- Perfil de energía: Windows guarda un juego de valores para corriente (AC) y otro
                 para batería (DC). La card muestra y edita el del perfil elegido, y los
                 atajos (Predeterminado / Recomendado) actúan sobre ese mismo. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <FontIcon Glyph="&#xE7E8;" FontSize="13"
                          Foreground="{ThemeResource SecondaryTextBrush}"
                          VerticalAlignment="Center"/>
 <!-- El botón de ayuda va pegado al título, que es a lo que explica. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="Perfil de energía" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="TurboModeInfoButton"
                            Style="{StaticResource InfoIconButtonStyle}">
                        <FontIcon Glyph="&#xE946;" FontSize="12"
                                  Foreground="{ThemeResource MutedBrush}"/>
                    </Button>
                </StackPanel>
 <!-- Los dos atajos van junto al desplegable, al borde derecho de la card, porque
                     actúan sobre el perfil que ese desplegable elige. Son los mismos botones
                     de ícono que usa Optimizaciones en cada ajuste: sin texto, transparentes,
                     ★ = valor recomendado y ↺ = valor de fábrica, con el detalle en el tooltip. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="TurboDefaultsButton"
                                Click="TurboDefaultsButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="6,4"
                                MinWidth="0"
                                MinHeight="0"
                                IsEnabled="False"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7A7;" FontSize="13"/>
                        </Button>
                        <Button x:Name="TurboRecommendedButton"
                                Click="TurboRecommendedButton_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="6,4"
                                MinWidth="0"
                                MinHeight="0"
                                Foreground="{StaticResource SuccessBrush}"
                                IsEnabled="False"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE735;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                    <ComboBox x:Name="TurboModeCombo"
                              MinWidth="210"
                              VerticalAlignment="Center"
                              SelectionChanged="TurboModeCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>

<!-- Dos columnas: cada ajuste es "nombre + botón de ayuda", con su valor y la barra
                 debajo. El detalle de qué hace cada uno vive en el tooltip del botón ⓘ,
                 así no se apilan líneas de texto: la fila se lee de un vistazo. -->
            <Grid x:Name="TurboControlsPanel" ColumnDefinitions="*,*" ColumnSpacing="28" RowSpacing="16">
<!-- Modo boost -->
                <StackPanel x:Name="TurboBoostRow" Spacing="6" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Modo boost" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="TurboBoostInfoButton"
                                Style="{StaticResource InfoIconButtonStyle}">
                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                      Foreground="{ThemeResource MutedBrush}"/>
                        </Button>
                    </StackPanel>
<!-- Recomendado / Actual, como en las opciones de Optimizaciones. -->
                    <StackPanel x:Name="TurboBoostBadges" Orientation="Horizontal" Spacing="6"/>
                    <TextBlock x:Name="TurboBoostValueText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"/>
                    <Slider x:Name="TurboBoostSlider"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="1"
                            TickFrequency="1"
                            TickPlacement="Inline"
                            VerticalAlignment="Center"
                            ValueChanged="TurboBoostSlider_ValueChanged"/>
                </StackPanel>

<!-- Límite de rendimiento -->
                <StackPanel x:Name="TurboLimitRow" Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Límite de rendimiento" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="TurboLimitInfoButton"
                                Style="{StaticResource InfoIconButtonStyle}">
                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                      Foreground="{ThemeResource MutedBrush}"/>
                        </Button>
                    </StackPanel>
<!-- Recomendado / Actual, como en las opciones de Optimizaciones. -->
                    <StackPanel x:Name="TurboLimitBadges" Orientation="Horizontal" Spacing="6"/>
                    <TextBlock x:Name="TurboLimitValueText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"/>
                    <Slider x:Name="TurboLimitSlider"
                            Minimum="0"
                            Maximum="100"
                            StepFrequency="1"
                            VerticalAlignment="Center"
                            ValueChanged="TurboLimitSlider_ValueChanged"/>
                </StackPanel>
            </Grid>

<!-- Estado vacío: el equipo no expone el ajuste (se dice por qué, no se esconde) -->
            <Border x:Name="TurboUnavailableBorder"
                    Background="{ThemeResource ChipBackgroundBrush}"
                    CornerRadius="8"
                    Padding="12,10"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE72E;" FontSize="14"
                              Foreground="{ThemeResource SecondaryTextBrush}"
                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock x:Name="TurboUnavailableText"
                               FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

<!-- ===== Ajustes avanzados del procesador (plegable) ===== -->
            <Expander x:Name="TurboAdvancedExpander"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False"
                      Visibility="Collapsed">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14"
                                  Foreground="{ThemeResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Ajustes avanzados del procesador"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="Políticas de energía de Windows para el procesador. No es overclock: no sube nada por encima de lo que el equipo ya permite, y se aplican al plan activo."
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

<!-- Las filas se arman desde código con los ajustes que expone este equipo.
                         Van de a dos por fila (nombre + botón de ayuda, valor y barra). -->
                    <StackPanel x:Name="TurboAdvancedPanel" Spacing="16"/>

                </StackPanel>
            </Expander>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="TurboScopeText"
                           FontSize="11"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
 <!-- Aplicar confirma TODO lo pendiente: lo movido a mano en las barras y lo que
                     carguen los atajos (Predeterminado / Recomendado), que viven arriba,
                     junto al perfil. Los atajos ya no escriben en el plan al pulsarlos. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TurboApplyButton"
                            Content="Aplicar"
                            Click="TurboApplyButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="6"
                            Padding="16,8"
                            FontWeight="SemiBold"
                            MinWidth="110"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="TurboStatusText" Text="" FontSize="12"
                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
