<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

<!-- Base Card Style: SIN contorno. Las cards son superficies planas; el filete de 1 px
         se leía como un reborde sobre todo con el vidrio encendido (ver CardStrokeBrush en
         App.xaml). Para un contorno intencional está OutlinedCardStyle. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

<!-- Elevated Card Style -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow/>
            </Setter.Value>
        </Setter>
    </Style>

<!-- Outlined Card Style: el único que dibuja contorno, y con el color de borde del tema
         (CardBorderBrush, el mismo de los diálogos y las pastillas). -->
    <Style x:Key="OutlinedCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
    </Style>

<!-- Filled Card Style -->
    <Style x:Key="FilledCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

<!-- Interactive Card Style (for clickable cards) -->
    <Style x:Key="InteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
    </Style>

<!-- Card Header Template -->
    <DataTemplate x:Key="CardHeaderTemplate">
        <StackPanel Spacing="4">
            <TextBlock 
                Text="{Binding Title}" 
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                FontWeight="SemiBold"/>
            <TextBlock 
                Text="{Binding Subtitle}" 
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>

<!-- Card Content Template -->
    <DataTemplate x:Key="CardContentTemplate">
        <ContentControl Content="{Binding Content}"/>
    </DataTemplate>

<!-- Card Footer Template -->
    <DataTemplate x:Key="CardFooterTemplate">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <ContentControl Content="{Binding Actions}"/>
        </StackPanel>
    </DataTemplate>

<!-- Metric Card Style -->
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="120"/>
    </Style>

<!-- Info Card Style -->
    <Style x:Key="InfoCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColorBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
    </Style>

<!-- Warning Card Style -->
    <Style x:Key="WarningCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBrush}"/>
    </Style>

<!-- Error Card Style -->
    <Style x:Key="ErrorCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>

<!-- Success Card Style -->
    <Style x:Key="SuccessCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
    </Style>

<!-- Compact Card Style -->
    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

<!-- Large Card Style -->
    <Style x:Key="LargeCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

<!-- Card with Image Style -->
    <Style x:Key="CardWithImageStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

<!-- Card with Icon Style -->
    <Style x:Key="CardWithIconStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12"/>
    </Style>

<!-- =====================================================================
         PUERTA DE ENTRADA POR DRIVER FALTANTE
         La usan Monitor de sensores (PawnIO) y Overclock USB (hidusbf): las dos
         pantallas muestran el mismo estado —falta un driver compartido que se
         administra en Configuración → Drivers— y tienen que verse igual. Los
         estilos viven acá para que no se separen con el tiempo; el contenido
         propio de cada página (lista de features, enlaces) queda en su XAML.
         ===================================================================== -->
    <Style x:Key="DriverGateHostStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="580"/>
        <Setter Property="Margin" Value="24,28"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DriverGateCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SensorGridLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="28"/>
    </Style>

    <!-- Insignia del encabezado: mismo tamaño y trazo en las dos puertas. -->
    <Style x:Key="DriverGateIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{ThemeResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style x:Key="DriverGateSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DriverGateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DriverGateBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- La caja ámbar de consecuencia: el mismo bloque en Sensores y Overclock. -->
    <Style x:Key="DriverGateWarningStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WarningTintBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource WarningBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="DriverGateWarningTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Pie de la puerta: nota compartida, centrada y en gris. -->
    <Style x:Key="DriverGateFooterStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
