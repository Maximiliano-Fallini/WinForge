<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- ContentDialog Base Style -->
    <Style x:Key="DefaultContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TitleTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="CloseButtonText" Value="Cerrar"/>
        <Setter Property="DefaultButton" Value="Close"/>
    </Style>

    <!-- Info Dialog Style -->
    <Style x:Key="InfoDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Title" Value="Información"/>
        <Setter Property="CloseButtonText" Value="Entendido"/>
    </Style>

    <!-- Warning Dialog Style -->
    <Style x:Key="WarningDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Title" Value="Advertencia"/>
        <Setter Property="PrimaryButtonText" Value="Continuar"/>
        <Setter Property="CloseButtonText" Value="Cancelar"/>
    </Style>

    <!-- Error Dialog Style -->
    <Style x:Key="ErrorDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Title" Value="Error"/>
        <Setter Property="CloseButtonText" Value="Aceptar"/>
    </Style>

    <!-- Confirmation Dialog Style -->
    <Style x:Key="ConfirmationDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Title" Value="Confirmar"/>
        <Setter Property="PrimaryButtonText" Value="Confirmar"/>
        <Setter Property="CloseButtonText" Value="Cancelar"/>
        <Setter Property="DefaultButton" Value="Primary"/>
    </Style>

    <!-- Success Dialog Style -->
    <Style x:Key="SuccessDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="Title" Value="Éxito"/>
        <Setter Property="CloseButtonText" Value="Aceptar"/>
    </Style>

    <!-- Dialog with Input -->
    <DataTemplate x:Key="DialogWithInputTemplate">
        <StackPanel Spacing="12" MinWidth="300">
            <TextBlock Text="{Binding Message}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBox 
                x:Name="InputTextBox"
                PlaceholderText="{Binding PlaceholderText}"
                Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{ThemeResource DefaultTextBoxStyle}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Dialog with Progress -->
    <DataTemplate x:Key="DialogWithProgressTemplate">
        <StackPanel Spacing="12" MinWidth="300">
            <TextBlock Text="{Binding Message}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
            <ProgressBar 
                Value="{Binding ProgressValue}"
                IsIndeterminate="{Binding IsIndeterminate}"
                Height="4"
                Style="{ThemeResource DefaultProgressBarStyle}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Dialog with List -->
    <DataTemplate x:Key="DialogWithListTemplate">
        <StackPanel Spacing="12" MinWidth="300" MaxHeight="400">
            <TextBlock Text="{Binding Message}" Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
            <ListView 
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                MaxHeight="300"
                Style="{ThemeResource DefaultListViewStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{ThemeResource BodyTextBlockStyle}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </DataTemplate>

    <!-- Loading Dialog -->
    <Style x:Key="LoadingDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="IsPrimaryButtonEnabled" Value="False"/>
        <Setter Property="IsSecondaryButtonEnabled" Value="False"/>
        <Setter Property="CloseButtonText" Value=""/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <ProgressRing IsActive="True" Width="40" Height="40"/>
                        <TextBlock Text="{Binding}" Style="{ThemeResource BodyTextBlockStyle}" TextAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flyout Base Style -->
    <Style x:Key="DefaultFlyoutStyle" TargetType="Flyout">
        <Setter Property="Placement" Value="Auto"/>
    </Style>

    <!-- MenuFlyout Style -->
    <Style x:Key="DefaultMenuFlyoutStyle" TargetType="MenuFlyout">
        <Setter Property="Placement" Value="Auto"/>
    </Style>

    <!-- TeachingTip Style -->
    <Style x:Key="DefaultTeachingTipStyle" TargetType="muxc:TeachingTip">
        <Setter Property="PreferredPlacement" Value="Auto"/>
        <Setter Property="IsLightDismissEnabled" Value="True"/>
        <Setter Property="TailVisibility" Value="Visible"/>
    </Style>

</ResourceDictionary>