<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- Base ToggleSwitch Style -->
    <Style x:Key="DefaultToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="OnContent" Value="Activado"/>
        <Setter Property="OffContent" Value="Desactivado"/>
    </Style>

    <!-- Compact ToggleSwitch Style -->
    <Style x:Key="CompactToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="OnContent" Value=""/>
        <Setter Property="OffContent" Value=""/>
    </Style>

    <!-- Large ToggleSwitch Style -->
    <Style x:Key="LargeToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <!-- ToggleSwitch with Label Style -->
    <Style x:Key="LabeledToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{ThemeResource BodyTextBlockStyle}" Margin="0,0,0,4"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton Style -->
    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}"/>
        <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>

    <!-- ToggleButton Checked Style -->
    <Style x:Key="ToggleButtonCheckedStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemAccentColorBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource SystemAccentColorForegroundBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColorBrush}"/>
    </Style>

    <!-- Icon ToggleButton Style -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonStyle}">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- CheckBox Style -->
    <Style x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- RadioButton Style -->
    <Style x:Key="DefaultRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Settings Toggle Style (for settings pages) -->
    <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Switch with Description -->
    <DataTemplate x:Key="ToggleWithDescriptionTemplate">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}"/>
            <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>