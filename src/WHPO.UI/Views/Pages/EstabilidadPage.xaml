<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.EstabilidadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24">

            <!-- ==================== GRÁFICO: USO DE CPU ==================== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <CheckBox x:Name="UsageChartCheck" VerticalAlignment="Center"
                                  Checked="ChartCheck_Changed" Unchecked="ChartCheck_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="#FF4CC2C9" VerticalAlignment="Center"/>
                                <TextBlock Text="Uso de CPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock x:Name="UsageValueText" Grid.Column="1" Text="--%" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FF4CC2C9" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="UsageChartArea" ColumnDefinitions="40,*" ColumnSpacing="10">
                        <Canvas x:Name="UsageYAxis" Width="40" Height="160" VerticalAlignment="Top" Background="#FF0D141E"/>
                        <Grid Grid.Column="1">
                            <ScrollViewer x:Name="UsageScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled" ZoomMode="Disabled">
                                <Grid x:Name="UsageInner" Width="1200" Height="160">
                                    <Canvas x:Name="UsagePlot" Width="1200" Height="160" Background="#FF0D141E"/>
                                    <!-- Capa de hover: cruz + etiqueta con valor exacto y hora -->
                                    <Canvas x:Name="UsageHover" Width="1200" Height="160" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== GRÁFICO: TEMPERATURA ==================== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <CheckBox x:Name="TempChartCheck" VerticalAlignment="Center"
                                  Checked="ChartCheck_Changed" Unchecked="ChartCheck_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="#FF4CC257" VerticalAlignment="Center"/>
                                <TextBlock Text="Temperatura del CPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock x:Name="TempValueText" Grid.Column="1" Text="--°C" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FF4CC257" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="TempChartArea" ColumnDefinitions="40,*" ColumnSpacing="10">
                        <Canvas x:Name="TempYAxis" Width="40" Height="160" VerticalAlignment="Top" Background="#FF0D141E"/>
                        <Grid Grid.Column="1">
                            <ScrollViewer x:Name="TempScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled" ZoomMode="Disabled">
                                <Grid x:Name="TempInner" Width="1200" Height="160">
                                    <Canvas x:Name="TempPlot" Width="1200" Height="160" Background="#FF0D141E"/>
                                    <Canvas x:Name="TempHover" Width="1200" Height="160" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== GRÁFICO: POTENCIA (W) ==================== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <CheckBox x:Name="PowerChartCheck" VerticalAlignment="Center"
                                  Checked="ChartCheck_Changed" Unchecked="ChartCheck_Changed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9EA;" FontSize="15" Foreground="#FFFFC93C" VerticalAlignment="Center"/>
                                <TextBlock Text="Potencia del CPU (W)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock x:Name="PowerValueText" Grid.Column="1" Text="-- W" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFFFC93C" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="PowerChartArea" ColumnDefinitions="40,*" ColumnSpacing="10">
                        <Canvas x:Name="PowerYAxis" Width="40" Height="160" VerticalAlignment="Top" Background="#FF0D141E"/>
                        <Grid Grid.Column="1">
                            <ScrollViewer x:Name="PowerScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled" ZoomMode="Disabled">
                                <Grid x:Name="PowerInner" Width="1200" Height="160">
                                    <Canvas x:Name="PowerPlot" Width="1200" Height="160" Background="#FF0D141E"/>
                                    <Canvas x:Name="PowerHover" Width="1200" Height="160" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== CONFIGURACIÓN DEL TEST ==================== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16"
                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9D2;" FontSize="16" Foreground="#FF4CC2C9" VerticalAlignment="Center"/>
                        <TextBlock Text="Test de estabilidad" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Pone todos los núcleos al 100% con la carga elegida mientras se monitorean uso, temperatura, potencia y frecuencia. El test termina solo al cumplirse la duración o al presionar Detener."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Tipo de test" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <ComboBox x:Name="TestTypeCombo" HorizontalAlignment="Stretch" PlaceholderText="Cargando..."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Duración (min:seg)" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <TextBox x:Name="DurationTextBox" Text="0:30" BeforeTextChanging="NumericTextBox_BeforeTextChanging"/>
                            <TextBlock Text="Ej: 0:30 · 10:30.5 · 1:15:00.25" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tiempo restante + estado -->
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14"
                            BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Tiempo restante" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="RemainingTimeText" Text="00:30.000" FontSize="30" FontWeight="Bold"
                                           FontFamily="Consolas" Foreground="#FF4CC2C9"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="TestStatusText" Text="Listo para iniciar" FontSize="12"
                                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LiveValuesText" Text="" FontSize="12"
                                           Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="StartTestButton" Content="Empezar test" Click="StartTestButton_Click"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}"
                                FontWeight="SemiBold" CornerRadius="6" Padding="20,9" MinWidth="140"/>
                        <Button x:Name="StopTestButton" Content="Detener test" Click="StopTestButton_Click"
                                IsEnabled="False" CornerRadius="6" Padding="20,9" MinWidth="140"
                                Background="#FFF0616D" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
