<Page
    x:Class="WHPO_UI.Views.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,28,32,40" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                    <StackPanel Spacing="6" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE95A;" FontSize="30" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Overlay de métricas" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Superposición de métricas sobre tus juegos: FPS, uso de CPU/GPU, temperatura, frecuencia, watts y más. Configurá qué mostrar, los colores, la opacidad y los atajos."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

<!-- ===== Activar ===== -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Activar overlay" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverlayStatusText"
                                           Text=""
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="OverlayEnabledToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

<!-- ===== Atajos ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,16,0,0">
                        <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Atajos de teclado" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar/ocultar overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Muestra u oculta la superposición desde cualquier aplicación."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ShowHotkeyButton" Grid.Column="1" MinWidth="150" Padding="14,8"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Bloquear/desbloquear overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Desbloqueado: podés arrastrar la superposición con el mouse. Bloqueado: los clics pasan al juego."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="LockHotkeyButton" Grid.Column="1" MinWidth="150" Padding="14,8"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Hacé clic en un atajo y presioná la nueva combinación (Ctrl+Alt+tecla recomendado). Esc cancela."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

<!-- ===== Apariencia ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,16,0,0">
                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Apariencia" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar overlay solo al detectar un juego" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Oculta automáticamente el overlay mientras no haya un juego detectado."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowOverlayOnlyWithGameToggle" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Opacidad" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Opacidad del fondo de la superposición. El texto de las métricas queda siempre legible."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
        VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" FontSize="13"
                                               MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Tamaño de letra" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Escala del texto de la superposición: FPS, líneas de hardware y lows."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FontSizeSlider" Minimum="0.6" Maximum="2.0" StepFrequency="0.05"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FontSizeValueText" Grid.Column="1" FontSize="13"
                                               MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Esquina de la pantalla" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ubicación por defecto (después podés arrastrarla con el atajo de desbloqueo). Vertical: arriba a la derecha · Horizontal: arriba a la izquierda."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CornerComboBox" Grid.Column="1" MinWidth="170">
                                    <ComboBoxItem x:Name="CornerTopRightItem" Content="Arriba a la derecha" Tag="top-right"/>
                                    <ComboBoxItem x:Name="CornerTopLeftItem" Content="Arriba a la izquierda" Tag="top-left"/>
                                    <ComboBoxItem x:Name="CornerBottomRightItem" Content="Abajo a la derecha" Tag="bottom-right"/>
                                    <ComboBoxItem x:Name="CornerBottomLeftItem" Content="Abajo a la izquierda" Tag="bottom-left"/>
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Orientación del overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Vertical: panel con filas configurables. Horizontal: barra compacta profesional con lo esencial."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="LayoutComboBox" Grid.Column="1" MinWidth="170">
                                    <ComboBoxItem Content="Vertical" Tag="vertical"/>
                                    <ComboBoxItem Content="Horizontal" Tag="horizontal"/>
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Colores de los títulos" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Cada color se aplica solo al título de su grupo (FPS, CPU, GPU, RAM). El valor de las métricas usa el color general de abajo."
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FPS" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Colorea el título FPS. El valor, los lows y el gráfico usan el color general de métricas." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="FpsColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Colorea el título del procesador. Sus métricas (%/MHz/°C/W) usan el color general de métricas." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="CpuColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Colorea el título de la placa de video. Sus métricas (%/MHz/°C/W) usan el color general de métricas." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="GpuColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Colorea el título de la memoria. Sus métricas (MB/MHz) usan el color general de métricas." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="RamColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Métricas" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Un solo color para los valores de TODAS las métricas (FPS, lows, %, MHz, °C, W, MB, VRAM y gráfico). Los títulos no cambian." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="MetricColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Estilos predeterminados" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Restablece los colores de los grupos (verde) y de las métricas (blanco), la opacidad y el tamaño de letra a sus valores de fábrica."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ResetStylesButton" Grid.Column="1" Content="Restablecer estilos a predeterminados"
                                        FontSize="13" Padding="14,8" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

<!-- ===== Métricas ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,16,0,0">
                        <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Métricas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="MetricHintTitle" Text="Orden de los datos en el overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MetricHintText" Text="Cada grupo (CPU, GPU, RAM y FPS) es una tarjeta: arrastrá una métrica dentro de su tarjeta para cambiarla de línea o de posición (máximo 4 por línea), o hacé clic en ella para mostrar/ocultarla. Las métricas no se mueven entre tarjetas de otras familias."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ResetOrderButton" Grid.Column="1"
                                        Content="Orden por defecto"
                                        FontSize="12" Padding="14,8"
                                        VerticalAlignment="Top"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar título del juego" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Muestra el nombre del juego al final de la superposición (abajo en vertical, a la derecha en horizontal)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowGameTitleToggle" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"/>

                            <StackPanel x:Name="MetricBadgePanel" Spacing="8" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
