<Page
    x:Class="WHPO_UI.Views.Pages.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,28,32,40" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Spacing="12">
                    <StackPanel Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="Overlay de métricas" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Superposición de métricas sobre tus juegos: FPS, uso de CPU/GPU, temperatura, frecuencia, watts y más. Configurá qué mostrar, los colores, la opacidad y los atajos."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ===== Activar ===== -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Activar overlay" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverlayStatusText"
                                           Text=""
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="OverlayEnabledToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ===== Atajos ===== -->
                    <TextBlock Text="Atajos de teclado" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar/ocultar overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Muestra u oculta la superposición desde cualquier aplicación."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ShowHotkeyButton" Grid.Column="1" MinWidth="150" Padding="14,8"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Bloquear/desbloquear overlay" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Desbloqueado: podés arrastrar la superposición con el mouse. Bloqueado: los clics pasan al juego."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="LockHotkeyButton" Grid.Column="1" MinWidth="150" Padding="14,8"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Hacé clic en un atajo y presioná la nueva combinación (Ctrl+Alt+tecla recomendado). Esc cancela."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Apariencia ===== -->
                    <TextBlock Text="Apariencia" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar overlay solo al detectar un juego" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Oculta automáticamente el overlay mientras no haya un juego detectado."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowOverlayOnlyWithGameToggle" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Opacidad" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Opacidad del fondo de la superposición. El texto de las métricas queda siempre legible."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" StepFrequency="0.05"
        VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" FontSize="13"
                                               MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Tamaño de letra" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Escala del texto de la superposición: FPS, líneas de hardware y lows."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="1" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FontSizeSlider" Minimum="0.6" Maximum="2.0" StepFrequency="0.05"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FontSizeValueText" Grid.Column="1" FontSize="13"
                                               MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Esquina de la pantalla" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ubicación por defecto (después podés arrastrarla con el atajo de desbloqueo)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CornerComboBox" Grid.Column="1" MinWidth="170">
                                    <ComboBoxItem x:Name="CornerTopRightItem" Content="Arriba a la derecha" Tag="top-right"/>
                                    <ComboBoxItem x:Name="CornerTopLeftItem" Content="Arriba a la izquierda" Tag="top-left"/>
                                    <ComboBoxItem x:Name="CornerBottomRightItem" Content="Abajo a la derecha" Tag="bottom-right"/>
                                    <ComboBoxItem x:Name="CornerBottomLeftItem" Content="Abajo a la izquierda" Tag="bottom-left"/>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Colores de las métricas" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FPS" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Contador de frames por segundo y lows." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="FpsColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Uso, frecuencia, temperatura y watts del procesador." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="CpuColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Uso, frecuencia, temperatura y watts de la placa de video." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="GpuColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Uso de memoria del sistema." FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="RamColorButton" Grid.Column="2" Width="48" Height="28" Padding="0"
                                            CornerRadius="6"/>
                                </Grid>
                            </StackPanel>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar título del juego" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Muestra el nombre del juego al final de la superposición, abajo de todas las métricas."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowGameTitleToggle" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Métricas ===== -->
                    <TextBlock Text="Métricas" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Datos en la superposición" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Grilla fija: cada línea es una línea de la superposición, con MÁXIMO 4 métricas. Arrastrá un badge (manteniendo el clic) para moverlo de línea o de posición, o hacé clic en él para mostrar/ocultar esa métrica."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ResetOrderButton" Grid.Column="1"
                                        Content="Orden por defecto"
                                        FontSize="12" Padding="14,8"
                                        VerticalAlignment="Top"/>
                            </Grid>
                            <StackPanel x:Name="MetricBadgePanel" Spacing="8" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
