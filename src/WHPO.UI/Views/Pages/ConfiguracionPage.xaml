<Page
    x:Class="WHPO_UI.Views.Pages.ConfiguracionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
<!-- Opción del selector de estilo de las cards de la biblioteca (2D / 3D).
             RadioButton "lookless": todo el contenido es la miniatura + las etiquetas, y el
             estado elegido se marca con el borde de acento, el tinte de fondo y el tilde
             (mismo lenguaje que las cards del selector de temas). El foco por teclado suma
             un halo de acento alrededor, porque el sistema no dibuja el aro del radio. -->
        <Style x:Key="LibraryStyleTile" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{ThemeResource CardHoverBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.Background" Value="{ThemeResource CardHoverBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.5"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Chrome.BorderBrush" Value="{ThemeResource AccentBrush}"/>
                                            <Setter Target="Chrome.BorderThickness" Value="2"/>
                                            <Setter Target="Chrome.Background" Value="{ThemeResource AccentTintBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.Opacity" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="Chrome"
                                    CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource SensorGridLineBrush}"
                                    Background="Transparent"
                                    Padding="10">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>

                            <Border x:Name="FocusRing"
                                    CornerRadius="15"
                                    Margin="-3"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource AccentBrush}"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Muestra de color del estilo 3D: un RadioButton sin cromo propio, con el círculo
             y la etiqueta armados en código (BuildCardSkinPicker). El elegido se marca con el
             aro de acento y el tilde, igual que el selector de temas. -->
        <Style x:Key="CardSkinSwatch" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Padding="5,4">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*"><!-- ====== NAVBAR INTERNO: Inicio / Apariencia / Actualizaciones / Desarrollo ======
             En los temas CLÁSICOS la barra se lee como el navbar principal: trae el color
             de la clave NavigationViewDefaultPaneBackground (blanco en Rosa/Blanco, etc.).
             En Marea esa clave viene transparente a propósito: ahí el menú es el
             tono de la ventana y la barra interna es CONTENIDO (su fondo es el de la página,
             que en esos temas deja ver la imagen del contenido). Con un color propio apilaba
             una segunda capa y se veía como un parche en el medio de la página. -->
        <Border x:Name="ConfigNavBar" Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <SelectorBar x:Name="ConfigTabs"
                         Margin="20,10,20,10"
                         Background="Transparent"
                         SelectionChanged="ConfigTabs_SelectionChanged">
                <!-- Los nombres de los ítems son los que usa ApplyTabVisibility para
                     mapear cada pestaña con su panel: antes iba por índice fijo, y sumar
                     una pestaña en el medio corría todas las demás. -->
                <SelectorBarItem x:Name="HomeTabItem" Text="Inicio" IsSelected="True"/>
                <SelectorBarItem x:Name="AppearanceTabItem" Text="Apariencia"/>
                <SelectorBarItem x:Name="UpdatesTabItem" Text="Actualizaciones"/>
                <SelectorBarItem x:Name="DevelopmentTabItem" Text="Desarrollo" Visibility="Collapsed"/>
            </SelectorBar>
        </Border>

        <Grid Grid.Row="1">

<!-- ============ PESTAÑA: INICIO ============ -->
            <!-- El fondo de la pestaña NO se pinta acá: lo pone el Page (AppBackgroundBrush).
                 Con el mismo pincel en los dos niveles, el contenido quedaba con DOS velos
                 sobre el gradiente (más oscuro que el resto de la ventana y que su propio
                 navbar): uno de los "cortes" que se veían en Configuración. -->
            <ScrollViewer x:Name="HomeTab" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="12" HorizontalAlignment="Stretch">

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Minimizar a la bandeja" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="Al minimizar la ventana, WHPO seguirá ejecutándose desde el área de notificación."
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="MinimizeToTrayToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Iniciar con Windows" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Abre WHPO automáticamente cuando iniciás sesión en este equipo."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StartupFeedbackText" Text="" FontSize="12"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LaunchAtStartupToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Iniciar minimizado" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Si WHPO se inicia automáticamente, se abrirá directamente en la bandeja del sistema."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StartMinimizedHint"
                                           Text="Solo tiene efecto cuando «Iniciar con Windows» está activado."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="MinimizedFeedbackText" Text="" FontSize="12"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Mostrar métricas en bandeja" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="Prendido: el ícono de la bandeja muestra uso de CPU, memoria y temperatura al pasar el cursor, con sondeos periódicos de hardware que elevan el consumo de CPU de la app en segundo plano. Apagado (predeterminado): sin métricas; al ocultar la ventana se libera la memoria del proceso para un consumo mínimo."
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="TrayMetricsToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TrayEcoModeTitle" Text="Modo eficiencia en bandeja"
                                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Background="{ThemeResource AccentTintBrush}"
                                            CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="Recomendado" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TrayEcoModeDescription"
                                    Text="Al minimizar a la bandeja, WHPO pasa a segundo plano (EcoQoS) y consume lo mínimo. Se quita solo al volver."
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                                <!-- Detalles que antes iban en la descripción, ahora como distintivos:
                                     se leen de un vistazo y la descripción queda en una sola línea. -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE945;" FontSize="10"
                                                      Foreground="{ThemeResource AccentBrush}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="EcoQoS" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE945;" FontSize="10"
                                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="Segundo plano" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="8" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE895;" FontSize="10"
                                                      Foreground="{ThemeResource SecondaryTextBrush}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="Automático" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="TrayEcoModeToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Posición de la ventana" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Restablece la posición y el tamaño guardados para que la ventana vuelva a abrirse centrada (útil si quedó fuera de la vista al cambiar de monitor)."
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="ResetWindowPositionButton" Content="Restablecer posición" FontSize="12"
                                        Padding="12,4" VerticalAlignment="Center" Click="ResetWindowPositionButton_Click"/>
                                <TextBlock x:Name="ResetWindowPositionFeedbackText" Text="" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

<!-- Mantenimiento: la caché y los logs cierran Inicio. Antes tenían su propia
                         pestaña (Caché), pero son dos acciones que se buscan junto al resto
                         de los ajustes del equipo, no un área aparte. El encabezado lleva el
                         mismo tipo de ícono que el resto de la app (FontIcon del tema, no un
                         emoji a color): se tiñe con el tema vigente. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,14,0,0">
                        <FontIcon Glyph="&#xE74D;" FontSize="15"
                                  Foreground="{ThemeResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Caché" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

<!-- Caché de la aplicación -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Caché de la aplicación" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <TextBlock x:Name="CacheSizeText" Text="" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ClearCacheButton" Content="Limpiar caché" FontSize="12"
                                        Padding="12,4" VerticalAlignment="Center" Click="ClearCacheButton_Click"/>
                                <TextBlock x:Name="ClearCacheFeedbackText" Text="" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

<!-- Logs de desarrollo -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Logs de desarrollo" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <TextBlock x:Name="DeveloperLogsSizeText" Text="" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="DeleteLogsButton" Content="Borrar logs" FontSize="12"
                                            Padding="12,4" VerticalAlignment="Center" Click="DeleteLogsButton_Click"/>
                                    <Button x:Name="OpenLogsFolderButton" Content="Abrir carpeta de logs" FontSize="12"
                                            Padding="12,4" VerticalAlignment="Center" Click="OpenLogsFolderButton_Click"/>
                                    <TextBlock x:Name="DeleteLogsFeedbackText" Text="" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="DeveloperLogsToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="False"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: APARIENCIA (tema, paleta, fondo, transparencia, blur e importar/exportar) ============ -->
            <ScrollViewer x:Name="AppearanceTab" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="12" HorizontalAlignment="Stretch">

<!-- Tema de la aplicación -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Tema de la aplicación" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Elige entre el tema del sistema y los temas propios de WinForge: planos, degradados y con imagen de fondo."
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
<!-- Filtro Todos / Oscuro / Claro: las pastillas las arma ThemePickerUi (usan los
                                     pinceles del tema activo y el estado que comparten con la grilla). -->
                                <StackPanel x:Name="ThemeFilterBar" Grid.Column="1" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Top"/>
                            </Grid>
<!-- Grilla de temas: una card por tema con su miniatura REAL (foto, gradiente o
                                 color plano) agrupadas por tipo de fondo —Entorno / Degradado /
                                 Planos—. La arma ThemePickerUi.Build al cargar la página; el tema
                                 vigente queda marcado con el borde de acento y el tilde. -->
                            <StackPanel x:Name="ThemeGridHost" Spacing="18" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

<!-- Cards de la biblioteca de juegos: la MISMA preferencia que el switch "Estilo de
     tarjetas" del header de Juegos (ajuste "biblioteca.cards3D"). Se puede cambiar
     desde acá sin entrar a la biblioteca; esa página relee el valor al abrirse, así
     que el cambio se aplica al volver, sin reiniciar la app. -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cards de la biblioteca de juegos" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Elegí cómo se ven los juegos en la biblioteca: 2D, tarjetas planas con el banner del juego, o 3D, cartuchos con profundidad que podés arrastrar a la consola del pie de la página."
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>

                            <!-- Los dos ejemplos van centrados en la card: son una elección
                                 binocular, no una lista que empieza a la izquierda. -->
                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,14,0,0"
                                        HorizontalAlignment="Center">

<!-- 2D: miniatura de la card vanilla (banner + título + estrella y tuerca). -->
                                <RadioButton x:Name="LibraryStyle2DTile"
                                             Style="{StaticResource LibraryStyleTile}"
                                             GroupName="LibraryCardStyle"
                                             Tag="2d"
                                             Checked="LibraryStyleTile_Checked">
                                    <StackPanel Spacing="10">
                                        <Grid Width="168" Height="120">
                                            <Border CornerRadius="10"
                                                    Background="{ThemeResource CardHoverBrush}"
                                                    BorderBrush="{ThemeResource SensorGridLineBrush}"
                                                    BorderThickness="1"/>

                                            <Border x:Name="LibraryStyle2DPreview"
                                                    Width="124" Height="78"
                                                    CornerRadius="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#FF1E2A3A">
                                                <Grid>
                                                    <Border x:Name="LibraryStyle2DBanner"
                                                            CornerRadius="8"/>
                                                    <FontIcon Glyph="&#xE735;" FontSize="9"
                                                              Foreground="#D9FFFFFF"
                                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                                              Margin="8,7,0,0"/>
                                                    <FontIcon Glyph="&#xE713;" FontSize="8"
                                                              Foreground="#D9FFFFFF"
                                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                                              Margin="0,7,8,0"/>
                                                    <Border VerticalAlignment="Bottom" Height="30"
                                                            CornerRadius="0,0,8,8">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00000000" Offset="0"/>
                                                                <GradientStop Color="#B3000000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid Margin="8,0">
                                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                                <Border Width="58" Height="3" CornerRadius="1.5" Background="#E6FFFFFF"/>
                                                                <Border Width="36" Height="2.5" CornerRadius="1.25" Background="#8CFFFFFF"/>
                                                            </StackPanel>
                                                            <Image Source="ms-appx:///logos/WinForge.png"
                                                                   Width="12" Height="12"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="LibraryStyleCheck2D"
                                                    Width="22" Height="22" CornerRadius="11"
                                                    Background="{ThemeResource AccentBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11"
                                                          Foreground="{ThemeResource AccentForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Spacing="1" Margin="2,0,0,0">
                                            <TextBlock Text="2D" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tarjetas planas" FontSize="12"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>

<!-- 3D: la cara REAL del cartucho (la misma que pinta la biblioteca) clavada
                                     en la consola del pie: es el gesto de la biblioteca 3D, no un
                                     dibujo genérico. -->
                                <RadioButton x:Name="LibraryStyle3DTile"
                                             Style="{StaticResource LibraryStyleTile}"
                                             GroupName="LibraryCardStyle"
                                             Tag="3d"
                                             Checked="LibraryStyleTile_Checked">
                                    <StackPanel Spacing="10">
                                        <Grid Width="168" Height="120">
                                            <Border CornerRadius="10"
                                                    Background="{ThemeResource CardHoverBrush}"
                                                    BorderBrush="{ThemeResource SensorGridLineBrush}"
                                                    BorderThickness="1"/>

<!-- Consola del pie, con la boca de la ranura asomando a los costados
                                                 del cartucho: el cartucho queda CLAVADO en el puerto, igual que
                                                 en la biblioteca. -->
                                            <Border x:Name="LibraryStyle3DDock"
                                                    Width="148" Height="18"
                                                    CornerRadius="9,9,0,0"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,3"
                                                    BorderThickness="1,1,0,0"
                                                    BorderBrush="#33FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF4C535F" Offset="0"/>
                                                        <GradientStop Color="#FF1A1E26" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border Width="104" Height="8"
                                                        CornerRadius="3,3,0,0"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,2,0,0"
                                                        Background="#FF05070A"/>
                                            </Border>

                                            <Image x:Name="LibraryStyle3DPreview"
                                                   Width="72" Height="105"
                                                   Stretch="Uniform"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,2"/>

                                            <Border x:Name="LibraryStyleCheck3D"
                                                    Width="22" Height="22" CornerRadius="11"
                                                    Background="{ThemeResource AccentBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Visibility="Collapsed">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11"
                                                          Foreground="{ThemeResource AccentForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Spacing="1" Margin="2,0,0,0">
                                            <TextBlock Text="3D" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="Cartuchos con profundidad" FontSize="12"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>

<!-- Estilo de los cartuchos y la consola del pie: el color de «hardware» que comparten
     la biblioteca 3D y el dock (ajuste "biblioteca.cards3D.skin", ver CardSkin).
     Solo se muestra con las cards 3D activas: en 2D no hay cartucho que teñir. -->
                    <Border x:Name="CardSkinCard" Style="{StaticResource CardStyle}" Padding="20"
                            CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal"
                            Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Estilo de los cartuchos y la consola" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="El color de la carcasa de los cartuchos 3D y de la consola del pie. Por defecto acompaña al tema de la app; también podés fijar un color propio para no depender del tema."
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>

                            <!-- Vista previa EN VIVO: la card REAL de la biblioteca y la consola del
                                 pie REAL (CartridgeDock: chasis, ranura, labio, LED) con el color
                                 elegido. La arma CartridgeDock.CreateAppearancePreview y se rehace
                                 al elegir cada muestra, con el mismo código que dibuja el dock. -->
                            <Border x:Name="CardSkinStage" Height="320" Margin="0,14,0,0"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardHoverBrush}"
                                    BorderBrush="{ThemeResource SensorGridLineBrush}"
                                    BorderThickness="1" Tag="no-reveal">
                                <ContentControl x:Name="CardSkinStageHost"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                IsTabStop="False"/>
                            </Border>

                            <!-- Las muestras las arma BuildCardSkinPicker: una por preset, con el
                                 color real del plástico y la etiqueta traducida por I18n. -->
                            <StackPanel x:Name="CardSkinHost" Orientation="Horizontal" Spacing="2"
                                        Margin="0,12,0,0" HorizontalAlignment="Left"/>

                            <!-- Color exacto: además de las muestras, cualquier color del
                                 selector de Windows. La muestra chica adelanta el color
                                 vigente y el botón abre el selector; se aplica al confirmar. -->
                            <Grid ColumnSpacing="12" Margin="0,14,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CardSkinCustomSwatch"
                                        Width="28" Height="28" CornerRadius="14"
                                        BorderThickness="2"
                                        BorderBrush="{ThemeResource SensorGridLineBrush}"
                                        VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="Color exacto" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CardSkinCustomHint"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="CardSkinCustomButton" Grid.Column="2"
                                        Content="Elegir color…"
                                        CornerRadius="6" Padding="14,6"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Inclinación al hover: es una preferencia de las cards 3D, por eso
                                 vive acá y no en la pestaña de navegación. Por defecto, activada. -->
                            <Grid ColumnSpacing="16" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Inclinar las cards al pasar el mouse" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Si lo apagás, las cards quedan planas y solo se levantan al arrastrarlas o inspeccionarlas."
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="CardTiltToggle" Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitchStyle}"
                                              IsOn="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="El cambio se aplica al volver a la biblioteca de juegos."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

<!-- Transparencia de los paneles: es el alfa de las superficies del tema (cards,
                         menú lateral, barra de título y chips — NUNCA el fondo de la ventana,
                         que es la identidad del tema) y es ABSOLUTO: en 0 % los paneles quedan
                         opacos y en 100 % casi no se ven. Se aplica en caliente: mutar el Color
                         del pincel del tema repinta toda la UI, sin reiniciar la app (a
                         diferencia del tema, que sí reinicia). -->
                    <Border x:Name="PanelTransparencyCard" Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Transparencia de los paneles" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PanelTransparencyValueText" Grid.Column="1" Text="0 %" FontSize="13"
                                           MinWidth="46" TextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <TextBlock Text="Cuánto se ve el fondo a través del menú lateral, la barra de título y las tarjetas. En 0 % los paneles quedan opacos, con el color del tema; cuanto más subís, menos tapan el fondo. El fondo de la ventana no se toca."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <!-- El tooltip del pulgar va apagado: el número sin el " %" confunde,
                                 y el porcentaje ya se ve arriba, a la derecha. -->
                            <Slider x:Name="PanelTransparencySlider"
                                    Minimum="0" Maximum="100" StepFrequency="5" Value="0"
                                    IsThumbToolTipEnabled="False"
                                    Margin="0,8,0,0"
                                    ValueChanged="PanelTransparencySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>                    <!-- Blur (desenfoque) de los paneles, en porcentaje. El desenfoque es PROPIO
                         de la app (PanelBlur + PanelBlurAlgorithm), no el acrílico de Windows: ese
                         se apaga con los "Efectos de transparencia" del sistema. El porcentaje es
                         la intensidad —elige el radio del desenfoque— y no solo un encendido, y
                         solo alcanza a los paneles: la foto que queda entre ellos no se toca
                         (ver PanelAppearance.SetBlurPercent y PanelBlurLayer). -->
                    <Border x:Name="PanelBlurCard" Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Blur (desenfoque)" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PanelBlurValueText" Grid.Column="1" Text="0 %" FontSize="13"
                                           MinWidth="46" TextAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                            <TextBlock Text="Cuánto se desenfoca la foto del fondo detrás de cada panel: tarjetas, chips, menú lateral y barra de título. Cuanto más alto, más borroneada se ve la foto a través de ellos; en 0 % los paneles quedan sólidos, con el color del tema. La foto que queda entre los paneles no se toca."
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <Slider x:Name="PanelBlurSlider"
                                    Minimum="0" Maximum="100" StepFrequency="5" Value="0"
                                    IsThumbToolTipEnabled="False"
                                    Margin="0,8,0,0"
                                    ValueChanged="PanelBlurSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: ACTUALIZACIONES (versión instalada + historial de versiones) ============ -->
            <!-- La lista de releases se arma en código (BuildReleaseCard): el cuerpo de cada
                 versión es Markdown y se renderiza con los pinceles del tema vigente. -->
            <ScrollViewer x:Name="UpdatesTab" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="12" HorizontalAlignment="Stretch">

<!-- Versión instalada y estado del chequeo -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource AccentTintBrush}" VerticalAlignment="Center">
                                    <Image Source="ms-appx:///logos/WinForge.png" Width="34" Height="34"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="WinForge" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdatesInstalledVersionText" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border x:Name="UpdatesStatusBadge" Grid.Column="2" CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock x:Name="UpdatesStatusBadgeText" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="UpdatesStatusText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Comprobando actualizaciones..."/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckUpdatesButton" Content="Buscar actualizaciones"
                                        Style="{StaticResource AccentButtonStyle}" Padding="14,8"
                                        Click="CheckUpdatesButton_Click"/>
                                <Button x:Name="InstallUpdateButton" Content="Instalar actualización"
                                        Padding="14,8" Visibility="Collapsed"
                                        Click="InstallUpdateButton_Click"/>
                                <Button x:Name="OpenReleasesButton" Content="Ver en GitHub"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                        Click="OpenReleasesButton_Click"/>
                                <ProgressRing x:Name="UpdatesProgressRing" Width="18" Height="18"
                                              IsActive="False" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

<!-- Historial de versiones -->
                    <StackPanel Spacing="3" Margin="0,10,0,0">
                        <TextBlock Text="Historial de versiones" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Todo lo que cambió en cada versión publicada." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel x:Name="ReleasesHost" Spacing="10"/>

                    <TextBlock x:Name="ReleasesFeedbackText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>

                    <Button x:Name="AllReleasesButton" Content="Ver todas las versiones"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                            BorderThickness="0"
                            HorizontalAlignment="Left" Margin="0,2,0,0"
                            Click="OpenReleasesButton_Click"/>
                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: DESARROLLO (solo en builds de desarrollo) ============ -->
            <ScrollViewer x:Name="DevTab" Visibility="Collapsed"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="16" HorizontalAlignment="Stretch">
                    <Border x:Name="DevSection" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="20" Tag="reveal">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🛠️ Herramientas de desarrollo" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Esta sección solo aparece en builds de desarrollo (versión superior a la publicada en GitHub)."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

<!-- Reposicionamiento de pantalla -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Reposicionamiento de ventana" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Forzar recálculo de posición/tamaño al iniciar (útil tras cambios de monitor/DPI)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button x:Name="ResetWindowPosButton" Content="Restablecer posición ahora"
                                                Style="{StaticResource AccentButtonStyle}" Padding="14,8"
                                                Click="ResetWindowPosButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DevFeedbackText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

<!-- Logs de desarrollo: se administran desde Inicio (bloque Caché). -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Logs de desarrollo" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Activa logs detallados en el archivo de errores para depuración."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

<!-- Test del asistente inicial: abre el asistente de primera configuración
                                 en modo simulación (idéntico al real, no guarda nada). -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Test del asistente inicial" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Abre el asistente de primera configuración en modo simulación: se ve idéntico al real y no guarda nada."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SimulateOnboardingButton" Grid.Column="1" Content="Simular onboarding"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" VerticalAlignment="Center"
                                            Click="SimulateOnboardingButton_Click"/>
                                </Grid>
                            </Border>

<!-- Info de versión -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Información de versión" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DevVersionInfoText" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
