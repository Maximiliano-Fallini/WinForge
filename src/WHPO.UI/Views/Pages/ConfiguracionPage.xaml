<Page
    x:Class="WHPO_UI.Views.Pages.ConfiguracionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*">

<!-- ====== NAVBAR INTERNO: Inicio / Caché / Navegación / Desarrollo ====== -->
        <Border x:Name="ConfigNavBar" Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <SelectorBar x:Name="ConfigTabs"
                         Margin="20,10,20,10"
                         Background="Transparent"
                         SelectionChanged="ConfigTabs_SelectionChanged">
                <SelectorBarItem Text="Inicio" IsSelected="True"/>
                <SelectorBarItem Text="Caché"/>
                <SelectorBarItem Text="Navegación"/>
                <SelectorBarItem x:Name="DevelopmentTabItem" Text="Desarrollo" Visibility="Collapsed"/>
            </SelectorBar>
        </Border>

        <Grid Grid.Row="1">

<!-- ============ PESTAÑA: INICIO ============ -->
            <ScrollViewer x:Name="HomeTab" Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="12" HorizontalAlignment="Stretch">

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Tema de la aplicación" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Elige entre el tema del sistema, oscuro, claro, rosa/blanco o negro/azul."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" MinWidth="150" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem x:Name="ThemeSystemItem" Content="Usar sistema" Tag="SystemDefault"/>
                                <ComboBoxItem x:Name="ThemeDarkItem" Content="Oscuro" Tag="Dark"/>
                                <ComboBoxItem x:Name="ThemeLightItem" Content="Claro" Tag="Light"/>
                                <ComboBoxItem x:Name="ThemePinkItem" Content="Rosa / Blanco" Tag="PinkLight"/>
                                <ComboBoxItem x:Name="ThemeBlueBlackItem" Content="Negro / Azul" Tag="BlueBlack"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Minimizar a la bandeja" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="Al minimizar la ventana, WHPO seguirá ejecutándose desde el área de notificación."
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="MinimizeToTrayToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Mostrar métricas en bandeja" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock
                                    Text="Prendido: el ícono de la bandeja muestra uso de CPU, memoria y temperatura al pasar el cursor, con sondeos periódicos de hardware que elevan el consumo de CPU de la app en segundo plano. Apagado (predeterminado): sin métricas; al ocultar la ventana se libera la memoria del proceso para un consumo mínimo."
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="TrayMetricsToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="True"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Posición de la ventana" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock
                                Text="Restablece la posición y el tamaño guardados para que la ventana vuelva a abrirse centrada (útil si quedó fuera de la vista al cambiar de monitor)."
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="ResetWindowPositionButton" Content="Restablecer posición" FontSize="12"
                                        Padding="12,4" VerticalAlignment="Center" Click="ResetWindowPositionButton_Click"/>
                                <TextBlock x:Name="ResetWindowPositionFeedbackText" Text="" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Iniciar con Windows" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Abre WHPO automáticamente cuando iniciás sesión en este equipo."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StartupFeedbackText" Text="" FontSize="12"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LaunchAtStartupToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Iniciar minimizado" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Si WHPO se inicia automáticamente, se abrirá directamente en la bandeja del sistema."
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StartMinimizedHint"
                                           Text="Solo tiene efecto cuando «Iniciar con Windows» está activado."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="MinimizedFeedbackText" Text="" FontSize="12"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: CACHÉ (caché de la app + logs de desarrollo) ============ -->
            <ScrollViewer x:Name="CacheTab" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="12" HorizontalAlignment="Stretch">

<!-- Caché de la aplicación -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Caché de la aplicación" FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <TextBlock x:Name="CacheSizeText" Text="" FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ClearCacheButton" Content="Limpiar caché" FontSize="12"
                                        Padding="12,4" VerticalAlignment="Center" Click="ClearCacheButton_Click"/>
                                <TextBlock x:Name="ClearCacheFeedbackText" Text="" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

<!-- Logs de desarrollo -->
                    <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="12" HorizontalAlignment="Stretch" Tag="reveal">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Logs de desarrollo" FontSize="16" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <TextBlock x:Name="DeveloperLogsSizeText" Text="" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="DeleteLogsButton" Content="Borrar logs" FontSize="12"
                                            Padding="12,4" VerticalAlignment="Center" Click="DeleteLogsButton_Click"/>
                                    <Button x:Name="OpenLogsFolderButton" Content="Abrir carpeta de logs" FontSize="12"
                                            Padding="12,4" VerticalAlignment="Center" Click="OpenLogsFolderButton_Click"/>
                                    <TextBlock x:Name="DeleteLogsFeedbackText" Text="" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="DeveloperLogsToggle"
                                Grid.Column="1"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                IsOn="False"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: NAVEGACIÓN ============ -->
            <ScrollViewer x:Name="NavTab" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="16" HorizontalAlignment="Stretch">

<!-- Card hero: estado del menú lateral -->
                    <Border Style="{StaticResource CardStyle}" CornerRadius="20" Padding="28" Tag="reveal">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
<!-- Badge con ícono de menú -->
                                <Border x:Name="NavBadge" Width="56" Height="56" CornerRadius="16"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" Tag="reveal">
                                    <FontIcon x:Name="NavBadgeIcon" Glyph="&#xE73E;" FontSize="24"
                                              Foreground="{ThemeResource AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Personalizá tu menú lateral" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mostrá u ocultá las secciones de la barra de navegación. Podés dejar solo lo que usás para tener un menú más limpio."
                                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

<!-- Progreso: cuántas pestañas están visibles -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NavMenuSummaryText" Text="" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="NavMenuCountText" Grid.Column="1" Text="" FontSize="13" FontWeight="SemiBold"/>
                                </Grid>
                                <ProgressBar x:Name="NavProgressBar" Maximum="1" Value="1"/>
                            </StackPanel>

                            
                        </StackPanel>
                    </Border>

<!-- Lista de secciones agrupadas por categoría -->
                    <Border Style="{StaticResource CardStyle}" CornerRadius="12" Padding="20" Tag="reveal">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Secciones del menú" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Desactivá las que no quieras ver en la barra lateral."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <!-- Nota: explica las dos ausencias que antes se resolvían con controles
                                 que no hacían nada (las secciones core, que no se pueden ocultar)
                                 o que confundían (los componentes sin instalar, sin pestaña). -->
                            <TextBlock Text="Las secciones propias de la app (Sistema, Red, Núcleos, Procesos, Workshop y Configuración) siempre están visibles. Los componentes que no tenés instalados no aparecen acá: se suman solos cuando los instalás desde el Workshop."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel x:Name="NavItemsPanel" Spacing="2" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </ScrollViewer>

<!-- ============ PESTAÑA: DESARROLLO (solo si la build supera la release) ============ -->
            <ScrollViewer x:Name="DevTab" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,40" Spacing="16" HorizontalAlignment="Stretch">
                    <Border x:Name="DevSection" Style="{StaticResource CardStyle}" CornerRadius="12" Padding="20" Tag="reveal">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🛠️ Herramientas de desarrollo" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Esta sección solo aparece en builds de desarrollo (versión superior a la publicada en GitHub)."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

<!-- Reposicionamiento de pantalla -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Reposicionamiento de ventana" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Forzar recálculo de posición/tamaño al iniciar (útil tras cambios de monitor/DPI)."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button x:Name="ResetWindowPosButton" Content="Restablecer posición ahora"
                                                Style="{StaticResource AccentButtonStyle}" Padding="14,8"
                                                Click="ResetWindowPosButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="DevFeedbackText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

<!-- Logs de desarrollo: se administran desde la pestaña Caché. -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Logs de desarrollo" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Activa logs detallados en el archivo de errores para depuración."
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

<!-- Test del asistente inicial: abre el asistente de primera configuración
                                 en modo simulación (idéntico al real, no guarda nada). -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Test del asistente inicial" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Abre el asistente de primera configuración en modo simulación: se ve idéntico al real y no guarda nada."
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="SimulateOnboardingButton" Grid.Column="1" Content="Simular onboarding"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" VerticalAlignment="Center"
                                            Click="SimulateOnboardingButton_Click"/>
                                </Grid>
                            </Border>

<!-- Info de versión -->
                            <Border Style="{StaticResource FilledCardStyle}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Información de versión" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DevVersionInfoText" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
