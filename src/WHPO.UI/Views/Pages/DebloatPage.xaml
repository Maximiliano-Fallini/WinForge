<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.DebloatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}">

        <!-- ====== SKELETON DE CARGA (mientras se detecta instalado / no instalado) ====== -->
        <StackPanel x:Name="PageSkeleton" Spacing="16" Margin="24,12,24,24" IsHitTestVisible="False">
            <!-- Header -->
            <StackPanel Spacing="2" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <Rectangle Width="150" Height="22" RadiusX="11" RadiusY="11"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Rectangle Width="420" Height="13" RadiusX="6" RadiusY="6"
                           Fill="{ThemeResource ControlFillColorSecondaryBrush}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Dos columnas de cards -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: Desinstalar apps -->
                <StackPanel Spacing="8">
                    <Rectangle Width="190" Height="18" RadiusX="9" RadiusY="9"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="140" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="120" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="150" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="110" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="130" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Columna derecha: Optimizaciones de aplicaciones -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <Rectangle Width="220" Height="18" RadiusX="9" RadiusY="9"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="160" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="125" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="145" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="12,10,14,10">
                        <Grid ColumnSpacing="12" ColumnDefinitions="Auto,*,Auto">
                            <Rectangle Width="20" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Width="115" Height="13" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Width="70" Height="20" RadiusX="10" RadiusY="10" Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Botones de lote -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Rectangle Width="170" Height="32" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Rectangle Width="160" Height="32" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- ====== CONTENIDO REAL ====== -->
        <ScrollViewer x:Name="PageContent" Visibility="Collapsed">
        <!-- Mismo layout que Panel de Windows / Reparación: margen 24 y 16 de separación entre secciones. -->
        <StackPanel Spacing="16" Margin="24">

            <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

            <!-- ====== HEADER ====== -->
            <StackPanel Spacing="2" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- Glifo monocromo con el acento de la app (mismo estilo que los títulos de las demás páginas). -->
                    <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Debloat" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HeaderSubtitleText"
                           FontSize="13.5"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>

                <!-- Volver a detectar instalado/no instalado (con skeleton de carga). -->
                <Button x:Name="RefreshButton"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                        FontWeight="SemiBold" CornerRadius="6" Padding="16,8"
                        Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Actualizar" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ====== PANEL DE NOTIFICACIONES ====== -->
            <StackPanel x:Name="NotificationPanel" Spacing="8" Visibility="Collapsed"/>

            <!-- ====== CONSOLA DE EJECUCIÓN (estado en vivo estilo winutil) ====== -->
            <Border x:Name="ConsolePanel" CornerRadius="10" Padding="12,10"
                    Background="{ThemeResource CardBackgroundBrush}"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Consola de ejecución" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CopyConsoleButton"
                                    Content="Copiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="CopyConsoleButton_Click"/>
                            <Button x:Name="ClearConsoleButton"
                                    Content="Limpiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="ClearConsoleButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="ConsoleScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <TextBlock x:Name="ConsoleText"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ====== LISTA DE TWEAKS (2 columnas) ====== -->
            <StackPanel x:Name="TweaksPanel" Spacing="12"/>

            <!-- ====== BOTONES DE LOTE (centrados) ====== -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ApplySelectedButton"
                        Content="Aplicar seleccionados"
                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                        FontWeight="SemiBold" CornerRadius="6" Padding="16,8" MinWidth="170"
                        Click="ApplySelectedButton_Click"/>
                <Button x:Name="RevertSelectedButton"
                        Content="Revertir seleccionados"
                        Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,8" MinWidth="160"
                        Click="RevertSelectedButton_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
