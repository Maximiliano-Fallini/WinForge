<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.TecladoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PresetButtonSelectedStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*">

        <!-- ====== NAVBAR INTERNO: Configuración / Macros ====== -->
        <!-- Borde de ancho completo con el color del navbar: la franja conecta con
             el panel izquierdo y el borde superior sin quedar recortada por márgenes. -->
        <Border Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <SelectorBar x:Name="KeyboardTabs"
                         Margin="20,10,20,4"
                         Background="Transparent"
                         SelectionChanged="KeyboardTabs_SelectionChanged">
                <SelectorBarItem Text="Configuración" IsSelected="True"/>
                <SelectorBarItem Text="Macros"/>
            </SelectorBar>
        </Border>

        <Grid Grid.Row="1">

            <!-- ==================== PESTAÑA 1: CONFIGURACIÓN (contenido existente) ==================== -->
            <ScrollViewer x:Name="ConfigTab" Background="{ThemeResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- Mismo margen que el resto de la app (24): alineado con Panel de Windows / Reparación. -->
                <StackPanel Spacing="16" Margin="24">

                    <!-- ====== REPETICIÓN DEL TECLADO ====== -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="14">

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Repetición del teclado" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Ajustá la repetición de teclas en milisegundos, igual que Filter Keys. Elegí un preset o escribí tus valores y dale a Aplicar: se aplican en vivo al instante (como FilterKeysSetter) y, con “Guardar en el registro”, quedan guardados para el próximo inicio de sesión."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- Configuración: presets como botones -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Configuración" FontSize="13" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DefaultPresetButton"
                                            Content="Windows por defecto"
                                            Click="DefaultPresetButton_Click"
                                            Style="{StaticResource PresetButtonStyle}"/>
                                    <Button x:Name="OptimizedPresetButton"
                                            Content="Recomendado"
                                            Click="OptimizedPresetButton_Click"
                                            Style="{StaticResource PresetButtonStyle}"/>
                                    <Button x:Name="CurrentPresetButton"
                                            Content="Aplicados actualmente"
                                            Click="CurrentPresetButton_Click"
                                            Style="{StaticResource PresetButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Ignorar pulsaciones menores a -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Ignorar pulsaciones menores a (ms)" FontSize="13" FontWeight="SemiBold"/>
                                <NumberBox x:Name="IgnoreUnderBox"
                                           Minimum="0" Maximum="5000"
                                           SmallChange="10" LargeChange="100"
                                           SpinButtonPlacementMode="Inline"
                                           HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Cuánto tiempo debe mantenerse presionada una tecla para que se registre (Slow Keys). 0 = acepta al instante (Windows aplica 1 ms como mínimo)."
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Retardo de repetición -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Retardo de repetición (ms)" FontSize="13" FontWeight="SemiBold"/>
                                <NumberBox x:Name="RepeatDelayBox"
                                           Minimum="0" Maximum="5000"
                                           SmallChange="10" LargeChange="100"
                                           SpinButtonPlacementMode="Inline"
                                           HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Tiempo que hay que mantener una tecla presionada antes de que empiece a repetirse (50-500 ms es lo normal; menor = repite más rápido)."
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Velocidad de repetición -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Velocidad de repetición (ms entre repeticiones)" FontSize="13" FontWeight="SemiBold"/>
                                <NumberBox x:Name="RepeatRateBox"
                                           Minimum="0" Maximum="1000"
                                           SmallChange="1" LargeChange="10"
                                           SpinButtonPlacementMode="Inline"
                                           HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Intervalo entre repeticiones al mantener la tecla (10-50 ms = 100-20 repeticiones/segundo; menor = repite más rápido)."
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Guardar en el registro: persiste los valores al reiniciar -->
                            <StackPanel Spacing="6">
                                <ToggleSwitch x:Name="SaveToRegistrySwitch"
                                              Header="Guardar en el registro"
                                              IsOn="True"
                                              OnContent="Sí"
                                              OffContent="No"/>
                                <TextBlock Text="Si está activado, se guarda en el registro del sistema y funciona después de reiniciar el sistema."
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Acciones -->
                            <Button x:Name="ApplyButton"
                                    Content="Aplicar"
                                    Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                                    FontWeight="SemiBold" CornerRadius="6" Padding="20,9"
                                    MinWidth="130"
                                    HorizontalAlignment="Left"
                                    Click="ApplyButton_Click"/>

                            <TextBlock x:Name="FeedbackText" Text="" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PESTAÑA 2: MACROS ==================== -->
            <ScrollViewer x:Name="MacrosTab" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="24">

                    <!-- ====== ESTADO DE MACROS (activadas / desactivadas) ====== -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="MacrosEnabledToggle"
                                          Header="Macros"
                                          OnContent="Activadas"
                                          OffContent="Desactivadas"
                                          Toggled="MacrosEnabledToggle_Toggled"/>
                            <TextBlock x:Name="MacrosDisabledHint"
                                       Text="Las macros están desactivadas. Activá el interruptor para usarlas."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ====== LISTA DE MACROS ====== -->
                    <Border x:Name="MacrosListCard"
                            Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Macros" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="NewMacroButton"
                                        Grid.Column="1"
                                        Content="Crear macro"
                                        Click="NewMacroButton_Click"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock Text="Grabá secuencias de teclas y clics del mouse y reproducilas con un atajo global, igual que una macro clásica de juegos."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <ListView x:Name="MacrosList" MaxHeight="300" SelectionMode="None"/>
                            <TextBlock x:Name="MacrosEmptyText"
                                       Text="Todavía no hay macros. Creá la primera con “Nueva macro”."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="MacrosListStatusText" Text="" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ====== VISTA DE CREACIÓN / EDICIÓN (estilo MacroGamer) ====== -->
                    <Border x:Name="MacroEditorCard"
                            Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16"
                            Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MacroEditorTitleText" Text="Crear macro" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBox x:Name="MacroNameBox"
                                     Header="Nombre"
                                     PlaceholderText="Ej.: Doble click rápido"
                                     MaxWidth="760"
                                     HorizontalAlignment="Left"/>

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">

                                <!-- Columna 1: eventos en vivo (el contenedor estira hacia abajo
                                     para llegar cerca de Guardar/Cancelar y hace scroll interno) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Eventos" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Grid.Row="1"
                                            Margin="0,8"
                                            Background="{ThemeResource AppBackgroundBrush}"
                                            CornerRadius="8"
                                            Padding="8">
                                        <ListView x:Name="EventsList"
                                                  MinHeight="180"
                                                  MaxHeight="420"
                                                  Background="Transparent"
                                                  SelectionMode="Single"
                                                  SelectionChanged="EventsList_SelectionChanged"
                                                  DoubleTapped="EventsList_DoubleTapped"/>
                                    </Border>
                                    <TextBlock Grid.Row="2"
                                               x:Name="RecordStatusText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               Visibility="Collapsed"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <!-- Columna 2: navbar de grabación + delay del evento -->
                                <StackPanel Grid.Column="1" Spacing="8" MinWidth="150">
                                    <Button x:Name="StartRecordButton"
                                            Content="Iniciar grabación"
                                            Click="StartRecordButton_Click"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            FontWeight="SemiBold"/>
                                    <Button x:Name="StopRecordButton"
                                            Content="Parar grabación"
                                            Click="StopRecordButton_Click"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            FontWeight="SemiBold"
                                            IsEnabled="False"/>
                                    <Button x:Name="DeleteEventButton"
                                            Content="Borrar"
                                            Click="DeleteEventButton_Click"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            FontWeight="SemiBold"
                                            IsEnabled="False"/>
                                    <TextBlock Text="Delay entre eventos"
                                               FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               Margin="0,10,0,0"/>
                                    <NumberBox x:Name="EventDelayBox"
                                               Minimum="0" Maximum="10000"
                                               SmallChange="10" LargeChange="100"
                                               SpinButtonPlacementMode="Inline"
                                               Value="150"
                                               ValueChanged="EventDelayBox_ValueChanged"/>
                                    <TextBlock Text="ms (0,15 s por defecto)" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <!-- Columna 3: opciones de grabación y ejecución -->
                                <StackPanel Grid.Column="2" Spacing="12" MinWidth="180">
                                    <ToggleSwitch x:Name="RecordMouseToggle" Header="Botones del mouse" IsOn="False"/>
                                    <TextBlock Text="Captura clics izquierdo, derecho y medio con su posición."
                                               FontSize="11"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Asignar a" FontSize="12" FontWeight="SemiBold"/>
                                        <Button x:Name="AssignHotkeyButton"
                                                Content="Asignar a: Sin atajo"
                                                Click="AssignHotkeyButton_Click"
                                                CornerRadius="6"
                                                Padding="12,7"
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button x:Name="ClearHotkeyButton"
                                                Content="Quitar atajo"
                                                Click="ClearHotkeyButton_Click"
                                                CornerRadius="6"
                                                Padding="12,7"
                                                FontSize="12"
                                                HorizontalAlignment="Stretch"
                                                Visibility="Collapsed"/>
                                        <TextBlock x:Name="HotkeyCaptureStatusText"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                                   Visibility="Collapsed"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Ejecutar" FontSize="12" FontWeight="SemiBold"/>
                                        <RadioButton x:Name="RunOnceRadio"
                                                     Content="Una sola vez"
                                                     GroupName="RunMode"
                                                     IsChecked="True"
                                                     Checked="RunMode_Checked"/>
                                        <RadioButton x:Name="RunRepeatRadio"
                                                     Content="Repetir"
                                                     GroupName="RunMode"
                                                     Checked="RunMode_Checked"/>
                                        <NumberBox x:Name="RepeatCountBox"
                                                   Minimum="2" Maximum="999"
                                                   SmallChange="1" LargeChange="10"
                                                   SpinButtonPlacementMode="Inline"
                                                   Value="5"
                                                   IsEnabled="False"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Acciones -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveMacroButton"
                                        Content="Guardar"
                                        Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                                        Click="SaveMacroButton_Click"
                                        CornerRadius="6"
                                        Padding="20,9"
                                        FontWeight="SemiBold"
                                        MinWidth="130"/>
                                <Button x:Name="CancelMacroButton"
                                        Content="Cancelar"
                                        Click="CancelMacroButton_Click"
                                        CornerRadius="6"
                                        Padding="20,9"
                                        MinWidth="110"/>
                            </StackPanel>

                            <TextBlock x:Name="MacroSaveStatusText" Text="" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
