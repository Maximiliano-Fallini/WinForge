<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.TecladoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PresetButtonSelectedStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CC2FF"/>
            <Setter Property="Foreground" Value="#0B1520"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="16">

            <!-- ====== REPETICIÓN DEL TECLADO ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="12"
                    Padding="16"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="#FF4CC2C9" VerticalAlignment="Center"/>
                        <TextBlock Text="Repetición del teclado" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Ajustá la repetición de teclas en milisegundos, igual que Filter Keys. Elegí un preset o escribí tus valores y dale a Aplicar: se aplican en vivo al instante (como FilterKeysSetter) y, con “Guardar en el registro”, quedan guardados para el próximo inicio de sesión."
                               FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Configuración: presets como botones -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Configuración" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DefaultPresetButton"
                                    Content="Windows por defecto"
                                    Click="DefaultPresetButton_Click"
                                    Style="{StaticResource PresetButtonStyle}"/>
                            <Button x:Name="OptimizedPresetButton"
                                    Content="Optimizada"
                                    Click="OptimizedPresetButton_Click"
                                    Style="{StaticResource PresetButtonStyle}"/>
                            <Button x:Name="CurrentPresetButton"
                                    Content="Aplicados actualmente"
                                    Click="CurrentPresetButton_Click"
                                    Style="{StaticResource PresetButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ignorar pulsaciones menores a -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ignorar pulsaciones menores a (ms)" FontSize="13" FontWeight="SemiBold"/>
                        <NumberBox x:Name="IgnoreUnderBox"
                                   Minimum="0" Maximum="5000"
                                   SmallChange="10" LargeChange="100"
                                   SpinButtonPlacementMode="Inline"
                                   HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Cuánto tiempo debe mantenerse presionada una tecla para que se registre (Slow Keys). 0 = acepta al instante (Windows aplica 1 ms como mínimo)."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Retardo de repetición -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Retardo de repetición (ms)" FontSize="13" FontWeight="SemiBold"/>
                        <NumberBox x:Name="RepeatDelayBox"
                                   Minimum="0" Maximum="5000"
                                   SmallChange="10" LargeChange="100"
                                   SpinButtonPlacementMode="Inline"
                                   HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Tiempo que hay que mantener una tecla presionada antes de que empiece a repetirse (50-500 ms es lo normal; menor = repite más rápido)."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Velocidad de repetición -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Velocidad de repetición (ms entre repeticiones)" FontSize="13" FontWeight="SemiBold"/>
                        <NumberBox x:Name="RepeatRateBox"
                                   Minimum="0" Maximum="1000"
                                   SmallChange="1" LargeChange="10"
                                   SpinButtonPlacementMode="Inline"
                                   HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Intervalo entre repeticiones al mantener la tecla (10-50 ms = 100-20 repeticiones/segundo; menor = repite más rápido)."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Guardar en el registro: persiste los valores al reiniciar -->
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="SaveToRegistrySwitch"
                                      Header="Guardar en el registro"
                                      IsOn="True"
                                      OnContent="Sí"
                                      OffContent="No"/>
                        <TextBlock Text="Si está activado, se guarda en el registro del sistema y funciona después de reiniciar el sistema."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Acciones -->
                    <Button x:Name="ApplyButton"
                            Content="Aplicar"
                            Background="#4CC2FF" Foreground="#0B1520"
                            FontWeight="SemiBold" CornerRadius="6" Padding="20,9"
                            MinWidth="130"
                            HorizontalAlignment="Left"
                            Click="ApplyButton_Click"/>

                    <TextBlock x:Name="FeedbackText" Text="" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
