<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.ReparacionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">

            <!-- Panel de notificaciones -->
            <StackPanel x:Name="NotificationPanel" Spacing="8"/>

            <!-- Lista de herramientas de reparación -->
            <StackPanel x:Name="ToolsPanel" Spacing="12"/>
        </StackPanel>
    </ScrollViewer>
</Page>