<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.ReparacionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">

            <!-- Panel de notificaciones: Collapsed cuando está vacío para no
                 empujar la primera sección hacia abajo (el Spacing del padre
                 no se aplica a hijos colapsados). -->
            <StackPanel x:Name="NotificationPanel" Spacing="8" Visibility="Collapsed"/>

            <!-- Lista de herramientas de reparación (2 columnas) -->
            <Grid x:Name="ToolsPanel" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Consola en vivo para herramientas que transmiten su progreso (ej: Reparar Windows Store) -->
            <Border x:Name="ConsolePanel" CornerRadius="10" Padding="12,10"
                    Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Consola de ejecución" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CopyConsoleButton"
                                    Content="Copiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="CopyConsoleButton_Click"/>
                            <Button x:Name="ClearConsoleButton"
                                    Content="Limpiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="ClearConsoleButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="ConsoleScroll" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <TextBlock x:Name="ConsoleText"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>