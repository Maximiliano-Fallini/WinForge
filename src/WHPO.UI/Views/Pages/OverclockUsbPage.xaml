<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.OverclockUsbPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="OverclockUsbToolbarButtonStyle" TargetType="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="OverclockUsbPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource OverclockUsbToolbarButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{ThemeResource AccentForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource AccentBrush}"/>
        </Style>
        <Style x:Key="OverclockUsbDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource OverclockUsbToolbarButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ErrorBrush}"/>
        </Style>
        <Style x:Key="OverclockUsbFeatureRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="10"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">

 <!-- ================================================================
             PANEL PRINCIPAL: grilla de dispositivos (visible cuando los
             componentes del sistema ya están instalados)
             ================================================================ -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

 <!-- ====== CABECERA ====== -->
            <StackPanel Margin="24,16,24,0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE88E;" FontSize="18" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Overclock USB" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text=""
                           FontSize="12"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

 <!-- ====== AVISO DE SEGURIDAD DEL SISTEMA ======
                     Integridad de memoria (HVCI): el filtro que hace el overclock no puede
                     parchear la pila USB con esa protección activa (README oficial de hidusbf,
                     "Warning 2"), así que se explica la consecuencia, la variante que sí carga
                     y cómo desactivarla. Oculto si la protección no está puesta.

                     Estilo de ADVERTENCIA (triángulo + ámbar), no de tarjeta normal: es una
                     condición del sistema que limita la función, no una nota al pie. El ámbar
                     sale de WarningBrush/WarningTintBrush, la misma paleta de estado que ya usa
                     Feedback.cs para los avisos, así que no hay un amarillo nuevo que mantener. -->
                <Border x:Name="GuardBanner"
                        Visibility="Collapsed"
                        Margin="0,4,0,0"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="{StaticResource WarningTintBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="15"
                                  Foreground="{StaticResource WarningBrush}"
                                  VerticalAlignment="Top"
                                  Margin="0,3,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="GuardTitleText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <!-- Variante del filtro instalada + techo que puede forzar: la consecuencia
                                 concreta del aviso. Se oculta si el .sys no coincide con ninguna variante
                                 verificada (no se afirma lo que no se pudo identificar). -->
                            <Border x:Name="GuardVariantChip"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Left"
                                    Padding="7,1"
                                    CornerRadius="4"
                                    Background="{ThemeResource ChipBackgroundBrush}">
                                <TextBlock x:Name="GuardVariantText" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="GuardBodyText"
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="GuardOpenButton"
                                Grid.Column="2"
                                Click="GuardOpenButton_Click"
                                Style="{StaticResource OverclockUsbToolbarButtonStyle}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                <TextBlock x:Name="GuardOpenButtonText" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

 <!-- ====== BARRA DE HERRAMIENTAS ======
                 Las acciones de un dispositivo viven en su popup (doble clic en la fila).
                 Aquí quedan solo las acciones globales de la vista. -->
            <Grid Grid.Row="1" Margin="24,10,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Style="{StaticResource OverclockUsbToolbarButtonStyle}"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Actualizar la lista de dispositivos">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="Actualizar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="SelectedDevicePanel"
                    Grid.Row="3"
                    Margin="24,12,24,0"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="DISPOSITIVO SELECCIONADO"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock x:Name="SelectedDeviceName"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SelectedDeviceType"
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="TASA NATIVA" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock x:Name="SelectedDeviceNativeRate" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="descriptor USB" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="OVERRIDE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock x:Name="SelectedDeviceActiveRate" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedDeviceFilterState" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Text="BUS USB" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock x:Name="SelectedDeviceBus" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedDeviceInterval" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="DOBLE CLIC PARA CONFIGURAR"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"/>
                        <TextBlock Text="Elegí la tasa disponible y aplicala desde el popup del dispositivo."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

 <!-- ====== MEDIDOR DE LATENCIA (polling real por Raw Input) ======
                 Igual que los medidores web de gamepadla/controllerco, pero nativo:
                 mide el intervalo real entre informes HID de mouse, teclado y mandos
                 (µs por QPC) mientras el usuario usa los periféricos con normalidad.
                 Colapsado por defecto: se abre con el botón de la toolbar. -->
 <!-- ====== TEST DE LATENCIA (card única) ======
                 Elegís el dispositivo y el tipo, y corrés la prueba. El tipo decide la
                 instrucción porque cada periférico reporta distinto: el mouse y el mando
                 (girando los ejes) emiten un flujo continuo, así que su intervalo ES el
                 polling; un teclado solo manda informe cuando cambia de estado, así que su
                 polling no se puede medir desde acá y el veredicto lo dice. -->
            <Border x:Name="LatencyTestCard"
                    Grid.Row="2"
                    Margin="24,10,24,0"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundBrush}"
                    CornerRadius="8">
                <StackPanel Spacing="10">
 <!-- Encabezado en el MISMO eje que el resto de la card: con el selector y el botón
                         centrados, un título pegado a la izquierda hacía que la vista se leyera
                         descentrada. -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LatencyTestTitle" Text="Test de latencia" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
 <!-- Selector centrado en su propia línea (sin rótulo al lado: la caja habla por sí sola —
                         muestra el dispositivo elegido con sus badges) y el botón de la prueba en la
                         línea de abajo, también centrado. -->
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
 <!-- Ancho: lo maneja el código (FitLatencySelectorWidth), no un valor fijo acá. La caja
                             crece con el ítem elegido (nombre + badges) hasta el ancho del
                             contenido de la card, y el popup hasta el ítem más ancho de la lista.
                             MinWidth es el piso (que no se achique de más) y el tope FIJO de antes
                             (420 px) se fue: era el que cortaba los nombres largos. -->
                        <ComboBox x:Name="LatencyTestDeviceSelector"
                                  MinWidth="360"
                                  FontSize="13"
                                  SelectionChanged="LatencyTestDeviceSelector_SelectionChanged"
                                  DropDownOpened="LatencyTestDeviceSelector_DropDownOpened"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
 <!-- Flancos de ancho FIJO e iguales: 16 + la separación de 8 en los dos lados, así el
                             botón cae en el centro exacto de la card en reposo y durante la corrida.
                             El spinner va DENTRO de un contenedor fijo: si el propio ProgressRing
                             colapsara, su flanco mediría 0 y el botón se correría a la derecha. -->
                        <Border Width="16" Height="16"/>
                        <Button x:Name="LatencyTestRunButton"
                                Click="LatencyTestRunButton_Click"
                                Style="{StaticResource OverclockUsbPrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                AllowFocusOnInteraction="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="LatencyTestRunButtonIcon" Glyph="&#xE768;" FontSize="12"/>
                                <TextBlock x:Name="LatencyTestRunButtonLabel" Text="Iniciar test" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Grid Width="16" Height="16">
                            <ProgressRing x:Name="LatencyTestProgress"
                                          IsActive="False"
                                          Width="16" Height="16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
 <!-- Onboarding visual: cuenta regresiva 3·2·1 y después el gesto que hay que hacer
                         durante la prueba (mouse en círculos, teclas, stick, ondas). -->
                    <Grid x:Name="LatencyDemoHost" Height="264" Visibility="Collapsed">
                        <Border x:Name="LatencyDemoBackdrop"
                                Background="{ThemeResource ChartBackgroundBrush}"
                                CornerRadius="6">
                            <Canvas x:Name="LatencyDemoGridCanvas" IsHitTestVisible="False"/>
                        </Border>
                        <ContentControl x:Name="LatencyDemoStage"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsHitTestVisible="False"/>
                    </Grid>
 <!-- La instrucción del test —qué hacer durante la prueba, o por qué el teclado se mide
                         distinto— va acá abajo, pegada al onboarding visual: antes vivía arriba, al
                         lado del título, lejos de donde ocurre la prueba. -->
                    <TextBlock x:Name="LatencyTestHint"
                               Text="Usá el dispositivo durante la prueba."
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
 <!-- Trazo en vivo: barra por intervalo (peak-hold), reloj de la ventana y los
                         números de la corrida en curso. -->
                    <Grid x:Name="LatencyLiveArea" Visibility="Collapsed" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="112" CornerRadius="6" Background="{ThemeResource ChartBackgroundBrush}">
                                <Canvas x:Name="LatencyLivePlot" Height="112"/>
                            </Border>
                            <ProgressBar x:Name="LatencyLiveProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="LatencyLiveTimeText"
                                       Grid.Row="2"
                                       Text="00:00.0"
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="10" MinWidth="170" VerticalAlignment="Top">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="LatencyLiveCaptionText" Text="En vivo" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}"/>
                                <TextBlock x:Name="LatencyLiveHzText" Text="--" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="AVG" FontSize="9" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock x:Name="LatencyLiveAvgText" Text="--" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock x:Name="LatencyLiveMinLabel" Text="Mín" FontSize="9" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock x:Name="LatencyLiveMinText" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="MAX" FontSize="9" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock x:Name="LatencyLiveMaxText" Text="--" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Spacing="1">
                                    <TextBlock x:Name="LatencyLiveSamplesLabel" Text="Muestras" FontSize="9" Foreground="{ThemeResource MutedBrush}"/>
                                    <TextBlock x:Name="LatencyLiveSamplesText" Text="0" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="LatencyTestStatusText"
                               Text=""
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <StackPanel x:Name="LatencyTestResultsHost" Spacing="6"/>
                </StackPanel>
            </Border>

 <!-- ====== GRILLA DE DISPOSITIVOS ======
                 Estilo Gestión de Procesos: cabecera de ancho fijo por columna
                 (reordenable arrastrando y redimensionable desde el borde derecho),
                 filas con scroll propio — la cabecera se desplaza en sincronía con el
                 scroll horizontal de las filas y los scrollbars van en canaletas
                 aparte, fuera del viewport, para nunca tapar contenido. -->
 <!-- Fondo PROPIO de la grilla, igual al de su cabecera (SensorGroupFillBrush): antes el
                 cuerpo era transparente y mostraba el fondo de la página, así que la cabecera quedaba
                 como un bloque blanco flotando sobre el color de atrás. Con los temas neutros pasaba
                 desapercibido, pero en Rosa/Blanco —donde el fondo de la página es rosa marcado— la
                 grilla quedaba del MISMO color que el fondo y se leía como un manchón. Ahora cabecera
                 y filas son una sola superficie (blanca en los temas claros, gris oscuro en los
                 oscuros), delimitada por su borde y separada del fondo de la página. -->
            <Border Grid.Row="4"
                    Margin="24,10,24,16"
                    Background="{ThemeResource SensorGroupFillBrush}"
                    BorderBrush="{ThemeResource SensorGridLineBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

 <!-- Cabecera de columnas (se desplaza en sincronía con las filas). -->
                    <Grid x:Name="HeaderHost"
                          Grid.Row="0" Grid.Column="0"
                          Height="40"
                          Background="{ThemeResource SensorGroupFillBrush}">
                        <Grid x:Name="HeaderGrid" Height="40" HorizontalAlignment="Left"/>
                        <Rectangle Height="1"
                                   VerticalAlignment="Bottom"
                                   Fill="{ThemeResource SensorGridLineBrush}"
                                   IsHitTestVisible="False"/>
                    </Grid>

 <!-- Filas: ScrollViewer con scrollbars ocultos (se dibujan propios en
                         las canaletas de abajo y de la derecha, fuera del viewport). -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="RowsScroll"
                                      Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Auto"
                                      ViewChanged="RowsScroll_ViewChanged">
                            <StackPanel x:Name="RowsPanel" Spacing="0"/>
                        </ScrollViewer>

 <!-- Barra horizontal en su canaleta inferior (solo si desborda). -->
                        <ScrollBar x:Name="HScrollBar"
                                   Grid.Row="1"
                                   Orientation="Horizontal"
                                   Height="12"
                                   Margin="0,4,0,0"
                                   IndicatorMode="MouseIndicator"
                                   Visibility="Collapsed"/>
                    </Grid>

 <!-- Barra vertical en su canaleta derecha (solo si desborda). -->
                    <ScrollBar x:Name="VScrollBar"
                               Grid.Row="1" Grid.Column="1"
                               Orientation="Vertical"
                               Width="12"
                               Margin="4,0,0,0"
                               IndicatorMode="MouseIndicator"
                               Visibility="Collapsed"/>

 <!-- Estado vacío (sin dispositivos o sin coincidencias) -->
                    <StackPanel x:Name="EmptyStatePanel"
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="2"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <FontIcon Glyph="&#xE88E;" FontSize="34"
                                  Foreground="{ThemeResource SecondaryTextBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

 <!-- ================================================================
             PUERTA DE ENTRADA: descargar e instalar los componentes del
             sistema para desbloquear esta sección (texto 100% genérico,
             sin nombres internos de componentes)
             ================================================================ -->
        <Grid x:Name="GatePanel">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="620"
                            HorizontalAlignment="Center"
                            Padding="32,28,32,36"
                            Spacing="0">

 <!-- Tarjeta principal -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource SensorGridLineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="30">
                        <StackPanel Spacing="0">

 <!-- Encabezado con insignia -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="46"
                                        Height="46"
                                        CornerRadius="10"
                                        Background="{ThemeResource AppBackgroundBrush}"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="1.5">
                                    <FontIcon Glyph="&#xE88E;"
                                              FontSize="20"
                                              Foreground="{ThemeResource AccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Overclock USB"
                                               FontSize="20"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Tasa de sondeo de tus periféricos"
                                               FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Descargá los componentes para desbloquear este apartado"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,22,0,0"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Overclock USB ajusta la tasa de sondeo (polling rate) de tus periféricos USB — mouses, teclados y mandos — para reducir la latencia de respuesta. Antes de usarlo, WinForge necesita instalar un pequeño componente del sistema en tu PC."
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       Margin="0,10,0,0"
                                       LineHeight="20"
                                       TextWrapping="Wrap"/>

 <!-- Qué incluye -->
                            <StackPanel Margin="0,18,0,0" Spacing="8">
                                <StackPanel Style="{StaticResource OverclockUsbFeatureRowStyle}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource AccentBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Reducí la latencia de respuesta de tus periféricos"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource OverclockUsbFeatureRowStyle}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource AccentBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Consultá la tasa de sondeo real (Hz) de cada dispositivo"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource AccentBrush}"
                                              VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Hacé overclock de la tasa de sondeo para reducir la latencia (hasta 8K en dispositivos compatibles)"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               LineHeight="18"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Style="{StaticResource OverclockUsbFeatureRowStyle}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14"
                                              Foreground="{ThemeResource AccentBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Restaurá los valores de fábrica con un clic"
                                               FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Height="1"
                                       Fill="{ThemeResource SensorGridLineBrush}"
                                       Margin="0,18,0,0"
                                       IsHitTestVisible="False"/>

 <!-- Nota de transparencia -->
                            <Grid Margin="0,16,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;"
                                          FontSize="13"
                                          Foreground="{ThemeResource AccentBrush}"
                                          VerticalAlignment="Top"
                                          Margin="1,1,0,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Es un motor de polling del sistema (software libre y de código abierto). Se descarga solo desde su repositorio oficial por HTTPS, se instala una única vez y no se envía ningún dato."
                                           FontSize="11"
                                           Foreground="{ThemeResource MutedBrush}"
                                           LineHeight="16"
                                           TextWrapping="Wrap"/>
                            </Grid>

 <!-- Acción principal -->
                            <StackPanel Margin="0,20,0,0">
                                <Button x:Name="DownloadComponentsButton"
                                        Content="Descargar e instalar componentes"
                                        Click="DownloadComponentsButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        FontWeight="SemiBold"
                                        CornerRadius="8"
                                        Padding="26,12"
                                        MinWidth="340"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>

 <!-- Progreso de la instalación -->
                            <StackPanel x:Name="GateProgressArea"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        Visibility="Collapsed"
                                        Margin="0,18,0,0">
                                <ProgressRing x:Name="GateProgressRing"
                                              IsActive="False"
                                              IsIndeterminate="True"
                                              Width="18"
                                              Height="18"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="GateStatusText"
                                           Text=""
                                           FontSize="13"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

 <!-- Error de la descarga -->
                            <TextBlock x:Name="GateErrorText"
                                       Text=""
                                       FontSize="13"
                                       Foreground="{ThemeResource ErrorBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,16,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Overclock USB ya está incluido en la app: al instalar los componentes se activa la lista de dispositivos, el ajuste por popup y la restauración de fábrica."
                               FontSize="11"
                               Foreground="{ThemeResource MutedBrush}"
                               Margin="6,14,6,0"
                               TextWrapping="Wrap"/>
                    <HyperlinkButton x:Name="HidusbfAdvancedLink"
                                     Content="¿Cómo funciona esta sección?"
                                     Click="HowItWorksLink_Click"
                                     FontSize="11"
                                     Margin="6,6,6,0"
                                     HorizontalAlignment="Left"/>
                    <TextBlock x:Name="HowItWorksDetail"
                               Text=""
                               FontSize="11"
                               Foreground="{ThemeResource MutedBrush}"
                               Visibility="Collapsed"
                               Margin="6,4,6,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
