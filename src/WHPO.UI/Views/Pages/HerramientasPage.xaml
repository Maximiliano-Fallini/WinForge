<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.HerramientasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="12" Margin="16">

            <!-- ====== FUNCIONES (Features) ====== -->
            <StackPanel x:Name="FeaturesPanel" Spacing="8"/>

            <!-- ====== FIXES ====== -->
            <StackPanel x:Name="FixesPanel" Spacing="8"/>

            <!-- ====== CONSOLA DE EJECUCIÓN ====== -->
            <Border x:Name="ConsolePanel" CornerRadius="10" Padding="12,10"
                    Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Consola de ejecución" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CopyConsoleButton"
                                    Content="Copiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="CopyConsoleButton_Click"/>
                            <Button x:Name="ClearConsoleButton"
                                    Content="Limpiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="ClearConsoleButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="ConsoleScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <TextBlock x:Name="ConsoleText"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
