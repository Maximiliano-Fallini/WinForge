<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.OptimizacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!-- ====== HUB DE OPTIMIZACIONES ======
     La página tiene TRES zonas:
       1) cabecera (fila 0): ícono + título + subtítulo, y el botón de volver
          cuando hay una categoría abierta;
       2) barra de cambios pendientes (fila 1): aparece sola cuando hay
          ajustes marcados y todavía no aplicados;
       3) contenido (fila 2): el hub con las cards (ScrollViewer), el
          drill-down de una categoría (ScrollViewer) o una herramienta del
          sistema (Frame a altura completa, para que su propio scroll funcione);
       4) consola de ejecución (fila 3): compartida por el hub y el drill-down.
-->
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

<!-- ====== CABECERA ====== -->
        <!-- El título va sobre una BANDA pegada a las paredes, igual que la cabecera
             del Workshop: misma pieza que el panel del menú, así que en los temas con
             fondo propio se ve el degradado a través y no queda un bloque cortado.
             El {ThemeResource} es solo la base: WinUI lo cachea y no lo vuelve a
             resolver cuando el ajuste cambia la transparencia o el vidrio, así que
             el code-behind la repinta a mano con PanelAppearance.PaneBarFill (ver
             RepaintHeaderCard). El margen de antes (24,16,24,0) pasó a ser el
             Padding de la banda, para que el contenido quede en el mismo lugar. -->
        <Border x:Name="HeaderCard"
                Grid.Row="0"
                Margin="0"
                Padding="24,16,24,14"
                CornerRadius="0"
                Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Botón de volver: solo en el drill-down (en el hub queda colapsado
                 y la columna Auto se hace de ancho 0, así que el ícono no se corre). -->
            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Width="34" Height="34"
                    Padding="0"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Volver al hub"
                    Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="Segoe Fluent Icons"/>
            </Button>

            <FontIcon x:Name="HeaderIcon"
                      Grid.Column="1"
                      Glyph="&#xE90F;"
                      FontSize="20"
                      FontFamily="Segoe Fluent Icons"
                      Foreground="{ThemeResource AccentBrush}"
                      VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText"
                           Text="Optimizaciones"
                           FontWeight="SemiBold"
                           FontSize="22"/>
                <TextBlock x:Name="HeaderSubtitleText"
                           Text=""
                           FontSize="13.5"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Atajos de COMPONENTE (solo con una categoría abierta): aplican el
                 valor recomendado o el de fábrica a TODOS los ajustes de la categoría.
                 Se arman en code-behind según lo que el catálogo defina para cada una. -->
            <StackPanel x:Name="FeatureBulkActions"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="FeatureRecommendedButton"
                        Click="FeatureRecommendedButton_Click"
                        CornerRadius="6"
                        Padding="12,7"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Aplicar todo lo recomendado del componente">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE735;" FontSize="12"
                                  Foreground="{StaticResource SuccessBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="FeatureRecommendedText"
                                   Text="Recomendado" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FeatureDefaultButton"
                        Click="FeatureDefaultButton_Click"
                        CornerRadius="6"
                        Padding="12,7"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Restaurar todo el componente a los valores de fábrica">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7A7;" FontSize="12"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="FeatureDefaultText"
                                   Text="Restaurar valor de fábrica" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            </Grid>
        </Border>

<!-- ====== BARRA DE CAMBIOS PENDIENTES ====== -->
        <Border x:Name="ActionBar"
                Grid.Row="1"
                Margin="24,12,24,0"
                CornerRadius="10"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PendingText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <Button x:Name="DiscardButton"
                        Grid.Column="1"
                        Content="Descartar"
                        Background="Transparent"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        CornerRadius="4"
                        Padding="10,4"
                        Click="DiscardButton_Click"/>
                <Button x:Name="ApplyButton"
                        Grid.Column="2"
                        Content="Aplicar cambios"
                        Background="{ThemeResource AccentBrush}"
                        Foreground="{ThemeResource AccentForegroundBrush}"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="16,8"
                        MinWidth="150"
                        Click="ApplyButton_Click"/>
            </Grid>
        </Border>

<!-- ====== CONTENIDO ====== -->
        <Grid Grid.Row="2">

            <!-- HUB: cards de categorías del catálogo y de herramientas. -->
            <ScrollViewer x:Name="HubScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled">
                <StackPanel Margin="24" Spacing="16">

                    <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

<!-- ====== CARDS DEL HUB ====== -->
                    <StackPanel x:Name="HubSection" Spacing="12">
                        <Grid x:Name="HubGrid" ColumnSpacing="16" RowSpacing="12"/>
                    </StackPanel>

<!-- ====== NOTIFICACIONES ====== -->
                    <StackPanel x:Name="NotificationPanel" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- DRILL-DOWN de una categoría: sus grupos y sus ajustes. -->
            <ScrollViewer x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <!-- Bloque de energía: se monta solo en la categoría "Energía". Va
                         a SANGRE (sin margen) porque su navbar interno tiene que quedar
                         pegado a los bordes, como el panel del menú; su contenido ya
                         trae su propio margen de 24. Alto FIJO porque el control trae
                         sus propios ScrollViewer: sin alto, se estiraría al contenido
                         y el scroll interno dejaría de funcionar. -->
                    <Grid x:Name="EnergyHost" Visibility="Collapsed"/>
                    <StackPanel x:Name="SettingsHost" Spacing="12" Margin="24,12,24,24"/>
                </StackPanel>
            </ScrollViewer>

            <!-- HERRAMIENTAS del sistema (TCP, Debloat, Repair…): la página
                 original se monta en un Frame a altura completa, para que su
                 propio scroll sea el que manda. -->
            <Grid x:Name="UtilityHost" Visibility="Collapsed">
                <Frame x:Name="UtilityFrame"/>
            </Grid>
        </Grid>

<!-- ====== CONSOLA DE EJECUCIÓN (estado en vivo estilo consola) ======
             Va PEGADA AL BORDE INFERIOR de la ventana: sin margen abajo y con las
             esquinas de abajo rectas, así se lee como una barra de estado del panel
             de contenido y no como una tarjeta flotando. El pelo de arriba es lo
             único que la separa del contenido. -->
        <Border x:Name="ConsolePanel"
                Grid.Row="3"
                Margin="0,8,0,0"
                CornerRadius="10,10,0,0" Padding="16,10,16,12"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="BatchProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="Consola de ejecución" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatchStatusText" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="BatchElapsedText" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="CopyConsoleButton"
                                Content="Copiar"
                                Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                CornerRadius="4" Padding="10,4"
                                Click="CopyConsoleButton_Click"/>
                        <Button x:Name="ClearConsoleButton"
                                Content="Limpiar"
                                Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                CornerRadius="4" Padding="10,4"
                                Click="ClearConsoleButton_Click"/>
                        <!-- Cerrar: la consola tapa una franja de la página, así que tiene que
                             poder irse sin salir de la categoría (también se cierra sola al
                             volver al hub y al dejar la página). -->
                        <Button x:Name="CloseConsoleButton"
                                ToolTipService.ToolTip="Cerrar consola"
                                Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                BorderThickness="0" CornerRadius="4" Padding="8,4"
                                Click="CloseConsoleButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="11" FontFamily="Segoe Fluent Icons"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="BatchProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" Visibility="Collapsed" ShowPaused="False" ShowError="False"/>
                <TextBlock x:Name="BatchHeartbeatText" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                <ScrollViewer x:Name="ConsoleScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <TextBlock x:Name="ConsoleText"
                               FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>
