<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.OptimizacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <!-- Margen reducido para que el contenido quede pegado al navbar (NavigationView). -->
        <StackPanel Spacing="12" Margin="16">

            <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

            <!-- ====== PRECONFIGURACIONES ====== -->
            <StackPanel Spacing="10">
                <TextBlock Text="Preconfiguraciones" FontWeight="SemiBold" FontSize="22"/>
                <TextBlock Text="Elegí un perfil para marcar automáticamente los tweaks recomendados. Después podés ajustar la selección a mano y aplicarla en lote."
                           FontSize="13.5"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="PresetsPanel" Orientation="Horizontal" Spacing="10"/>
            </StackPanel>

            <!-- ====== BARRA DE SELECCIÓN (responsive: los botones envuelven en ventanas angostas) ====== -->
            <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SelectionCountText" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="SelectionHintText"
                                   FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Marcá los tweaks con la casilla y aplicá o revertí todo junto."/>
                    </StackPanel>

                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <Button x:Name="ApplySelectedButton"
                                Content="Aplicar seleccionados"
                                Background="#4CC2FF" Foreground="#0B1520"
                                FontWeight="SemiBold" CornerRadius="6" Padding="16,8"
                                MinWidth="170" Margin="0,0,10,8"
                                Click="ApplySelectedButton_Click"/>
                        <Button x:Name="RevertSelectedButton"
                                Content="Revertir seleccionados"
                                Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16,8"
                                MinWidth="160" Margin="0,0,10,8"
                                Click="RevertSelectedButton_Click"/>
                        <Button x:Name="ClearSelectionButton"
                                Content="Quitar selección"
                                Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                CornerRadius="6" Padding="12,8" Margin="0,0,10,8"
                                Click="ClearSelectionButton_Click"/>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ====== PANEL DE NOTIFICACIONES ====== -->
            <StackPanel x:Name="NotificationPanel" Spacing="8"/>

            <!-- ====== CONSOLA DE EJECUCIÓN (estado en vivo estilo winutil) ====== -->
            <Border x:Name="ConsolePanel" CornerRadius="10" Padding="12,10"
                    Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Consola de ejecución" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="CopyConsoleButton"
                                    Content="Copiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="CopyConsoleButton_Click"/>
                            <Button x:Name="ClearConsoleButton"
                                    Content="Limpiar"
                                    Background="Transparent" Foreground="{ThemeResource SecondaryTextBrush}"
                                    CornerRadius="4" Padding="10,4"
                                    Click="ClearConsoleButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="ConsoleScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <TextBlock x:Name="ConsoleText"
                                   FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="18"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ====== LISTA DE TWEAKS ====== -->
            <StackPanel x:Name="TweaksPanel" Spacing="12"/>
        </StackPanel>
    </ScrollViewer>
</Page>