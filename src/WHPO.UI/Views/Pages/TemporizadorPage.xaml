<Page
    x:Class="WHPO_UI.Views.Pages.TemporizadorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">

<!-- ====== ENCABEZADO DE PÁGINA (mismo estilo que Panel de Windows / Optimizaciones) ====== -->
            <StackPanel Spacing="2" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Resolución del Temporizador" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ajuste de latencia: habilita la regla de Windows GlobalTimerResolutionRequest para reducir la latencia de entrada (input lag)."
                           FontSize="13"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

<!-- ====== CARD 1: ESTADO ACTUAL ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Estado actual" FontSize="16" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Resolución actual" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="CurrentTimerResolutionText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{ThemeResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Resolución máxima" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="MaxTimerResolutionText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Resolución mínima" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="MinTimerResolutionText" Text="--" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Temporizador de rendimiento" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="PerformanceTimerText" Text="--" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

<!-- ====== CARD 2: AJUSTAR RESOLUCIÓN ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">

<!-- Ajustar resolución -->
                    <TextBlock Text="Ajustar resolución" FontSize="16" FontWeight="SemiBold"/>

 <!-- Switch: petición global (solo aporta en Win11; badge recomendado) -->
                    <Border x:Name="GlobalRequestCard" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Usar GlobalTimerResolutionRequest" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <Border x:Name="GlobalRecommendedBadge" CornerRadius="6" Padding="6,2" Background="#2D4CAF50" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="(Recomendado)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="GlobalDescText"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="GlobalWin10Note" Text="Solo aporta en Windows 11." FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GlobalTimerToggle" Grid.Column="1" Style="{StaticResource CompactToggleSwitchStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="GlobalTimerToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6" MaxWidth="280" HorizontalAlignment="Left">
                        <TextBlock Text="Resolución deseada (ms)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="DesiredResolutionTextBox" Text="0.5" BeforeTextChanging="NumericTextBox_BeforeTextChanging"/>
                        <TextBlock Text="Valores bajos (0,5 ms) reducen la latencia de audio y el retraso de entrada, pero consume más energía y podría llegar a subir las temperaturas del procesador."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="TimerResolutionButton" Content="Iniciar" Click="TimerResolutionButton_Click" MinWidth="140"
                                Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                        <Button x:Name="AutoajustarTimerButton" Content="Autoajustar" Click="AutoajustarTimerButton_Click" MinWidth="140" Padding="16,8"/>
                    </StackPanel>
                    <TextBlock x:Name="TimerResolutionResultText" Text="" FontSize="12" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
