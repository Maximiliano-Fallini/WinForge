<Page
    x:Class="WHPO_UI.Views.Pages.RedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">
            <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

            <!-- ====== SECCIÓN 1: DNS ====== -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <SymbolIcon Symbol="Globe" Foreground="{StaticResource AccentBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Servidores DNS" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Proveedor DNS" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="DnsProviderCombo" HorizontalAlignment="Stretch" PlaceholderText="Seleccioná un proveedor" DropDownOpened="DnsProviderCombo_DropDownOpened"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                        <TextBox x:Name="PrimaryDnsTextBox" Header="DNS Primario" PlaceholderText="Ej: 8.8.8.8" BeforeTextChanging="DnsTextBox_BeforeTextChanging"/>
                        <TextBox Grid.Column="1" x:Name="SecondaryDnsTextBox" Header="DNS Secundario" PlaceholderText="Ej: 8.8.4.4" BeforeTextChanging="DnsTextBox_BeforeTextChanging"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ApplyDnsButton" Content="Aplicar DNS" Click="ApplyDnsButton_Click"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                        <Button x:Name="OpenNetworkAdapterPropertiesButton" Content="Conexiones de red" Click="OpenNetworkAdapterPropertiesButton_Click" ToolTipService.ToolTip="Abrir conexiones de red para configurar IPv4 manualmente" Padding="16,8"/>
                    </StackPanel>
                    <TextBlock x:Name="ApplyDnsResultText" Text="" FontSize="12" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,4"/>
                    <Button x:Name="FlushDnsButton" Content="Vaciar caché DNS" Click="FlushDnsButton_Click" HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                    <TextBlock x:Name="FlushDnsResultText" Text="" FontSize="12" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ====== SECCIÓN 2: TEST DE DNS (DNS Jumper) ====== -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <SymbolIcon Symbol="Setting" Foreground="{StaticResource AccentBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Test de DNS" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <Button x:Name="RunDnsTestButton" Content="Ejecutar test de DNS" Click="RunDnsTestButton_Click" HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                    <StackPanel Spacing="2">
                        <Button x:Name="ApplyFastestDnsButton" Content="Probar y aplicar el más rápido" Click="ApplyFastestDnsButton_Click" HorizontalAlignment="Left"
                                CornerRadius="6" Padding="16,8"/>
                        <TextBlock Text="Ejecuta el test completo y aplica automáticamente el DNS con menor latencia." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- DNS manuales (opcional): se agregan a la lista a probar con "+" -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <TextBox x:Name="ManualDns1TextBox" Header="DNS Manual 1 (opcional)" PlaceholderText="Ej: 1.2.3.4"/>
                        <TextBox Grid.Column="1" x:Name="ManualDns2TextBox" Header="DNS Manual 2 (opcional)" PlaceholderText="Ej: 4.5.6.7"/>
                        <Button Grid.Column="2" x:Name="AddManualDnsButton" Content="+" Click="AddManualDnsButton_Click" VerticalAlignment="Bottom" Width="40" Margin="0,4,0,0"/>
                    </Grid>
                    <StackPanel x:Name="ManualDnsListPanel" Spacing="4" Margin="0,4,0,0"/>

                    <!-- Pestaña de resultados: cerrable, con scroll propio para no alargar la página -->
                    <Border x:Name="DnsResultsTab" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8,8,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock x:Name="DnsTestStatusText" Text="Resultados del test" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="CloseDnsResultsButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="CloseDnsResultsButton_Click" Width="28" Height="28" Padding="0" FontSize="12" CornerRadius="4" ToolTipService.ToolTip="Cerrar"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}"/>
                            <ScrollViewer x:Name="DnsResultsScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                                <StackPanel x:Name="DnsTestResultsPanel" Spacing="6" Padding="12"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>



            <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,4"/>

            <!-- ====== SECCIÓN 5: PACKET LOSS TEST ====== -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <SymbolIcon Symbol="Repair" Foreground="{StaticResource AccentBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Packet Loss Test" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Duración del test" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="PacketLossDurationSlider" ValueChanged="PacketLossDurationSlider_ValueChanged"/>
                            <TextBlock x:Name="PacketLossDurationText" Text="10 segundos" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Servidor" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PacketLossServerCombo" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,4,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Retraso aceptable (Late Packet Threshold)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="LatePacketThresholdSlider" ValueChanged="LatePacketThresholdSlider_ValueChanged" Minimum="10" Maximum="500" StepFrequency="10" Value="200"/>
                            <TextBlock x:Name="LatePacketThresholdText" Text="200 ms" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Paquetes por segundo (PPS)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Slider x:Name="PacketLossRateSlider" ValueChanged="PacketLossRateSlider_ValueChanged"/>
                            <TextBlock x:Name="PacketLossRateText" Text="10 pps" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Indicadores circulares -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,8,0,0">
                        <Grid x:Name="SentRingHost" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="1" x:Name="TimeRingHost" HorizontalAlignment="Center"/>
                        <Grid Grid.Column="2" x:Name="ReceivedRingHost" HorizontalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="PacketLossStartButton" Content="Iniciar test" Click="PacketLossStartButton_Click" HorizontalAlignment="Center" MinWidth="160"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                    <TextBlock x:Name="PacketLossStatusText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                    <!-- Resultados finales -->
                    <Grid x:Name="PacketLossResultsPanel" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="8" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Carga · Pérdida de paquetes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PacketLossUploadText" Text="--" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Pérdida total de paquetes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PacketLossTotalText" Text="--" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Descarga · Pérdida de paquetes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PacketLossDownloadText" Text="--" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Paquetes tardíos" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PacketLossLateText" Text="--" FontWeight="SemiBold" FontSize="18"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PacketLossDetailText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,4"/>

            <!-- ====== SECCIÓN 6: ADAPTADORES (al final) ====== -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <FontIcon Glyph="&#xE839;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Adaptadores" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="AdaptersPanel" Spacing="8"/>
        </StackPanel>
    </ScrollViewer>
</Page>