<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.LimpiezaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WHPO_UI.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*">
        <Grid.Resources>
            <!-- Card genérica de sección de resultados (Chequeo): fondo + borde + esquinas. -->
            <Style x:Key="AnalysisCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </Grid.Resources>

        <!-- ====== NAVBAR INTERNO: Chequeo / Limpieza personalizada / Buscador de duplicados / Admin. de inicio ====== -->
        <Border Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <SelectorBar x:Name="LimpiezaTabs"
                         Margin="20,10,20,4"
                         Background="Transparent"
                         SelectionChanged="LimpiezaTabs_SelectionChanged">
                <SelectorBarItem Text="Chequeo" IsSelected="True"/>
                <SelectorBarItem Text="Limpieza personalizada"/>
                <SelectorBarItem Text="Buscador de duplicados"/>
                <SelectorBarItem Text="Administración de inicio"/>
            </SelectorBar>
        </Border>

        <Grid Grid.Row="1">

            <!-- ==================== PESTAÑA 1: CHEQUEO (estilo CCleaner) ====================
                 La card de total vive FUERA del ScrollViewer: queda fija arriba de la
                 pestaña, pero solo se muestra DESPUÉS de analizar (nunca antes del
                 botón Analizar). El contenido (inicio / progreso / resultados) scrollea
                 debajo de ella. -->
            <Grid x:Name="ChequeoTab">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Card hero (estilo profesional): total + fases + acción, fija arriba.
                     Visibility=Collapsed: solo aparece al terminar el análisis. -->
                <Border x:Name="ChequeoHeroCard" Grid.Row="0"
                        Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="22,18"
                        Margin="24,16,24,0">
                        <StackPanel Spacing="16">

                            <!-- Total encontrado: chip de icono + etiqueta + valor grande -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Width="44" Height="44" CornerRadius="12"
                                        Background="{ThemeResource AccentTintBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{ThemeResource AccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="Total encontrado" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    <TextBlock x:Name="ChequeoTotalsText" Text="—" FontSize="21" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ChequeoFeedbackText" Text="" FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Detalles (fases + acción): se muestran solo tras el análisis. -->
                            <StackPanel x:Name="ChequeoHeroDetails" Spacing="14" Visibility="Collapsed">

                                <!-- Separador entre el total y las fases -->
                                <Border Height="1" Background="{ThemeResource CardBorderBrush}" Opacity="0.7"/>

                                <!-- Stepper de fases: puntos + línea (estilo onboarding),
                                     centrados. Cada punto es clickeable para saltar. -->
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <StackPanel x:Name="ChequeoPhaseDots" Orientation="Horizontal"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ChequeoPhaseTitle" Text="" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Acción de la fase activa + Saltar a la siguiente -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                    <Button x:Name="ChequeoPhaseActionButton" Content="Limpiar"
                                            Style="{StaticResource AccentButtonStyle}" CornerRadius="10" Padding="30,12"
                                            FontWeight="SemiBold" MinWidth="200"
                                            IsEnabled="False" Click="ChequeoPhaseActionButton_Click"/>
                                    <Button x:Name="ChequeoSkipPhaseButton"
                                            Content="Saltar"
                                            Click="ChequeoSkipPhaseButton_Click"
                                            CornerRadius="10"
                                            Padding="22,12"
                                            FontWeight="SemiBold"
                                            MinWidth="110"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Filas estrella: centran el panel de inicio/progreso sin MinHeight
                         binding que genere scroll fantasma en la vista inicial. El panel
                         de resultados abarca las 3 filas (RowSpan) con alineación Top
                         para arrancar arriba, sin centrado vertical. -->
                    <Grid x:Name="ChequeoContentRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                    <!-- Botón central de Analizar (antes de escanear) -->
                    <StackPanel x:Name="ChequeoStartPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24,0">
                        <Border Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="30,26"
                                MaxWidth="440" HorizontalAlignment="Center">
                            <StackPanel Spacing="14">
                                <Border Width="52" Height="52" CornerRadius="14"
                                        Background="{ThemeResource AccentTintBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="{ThemeResource AccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Hacé clic en Analizar para buscar datos basura en el sistema y los navegadores."
                                           FontSize="13"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <Button x:Name="ChequeoAnalyzeButton"
                                        Content="Analizar"
                                        Click="ChequeoAnalyzeButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        CornerRadius="8"
                                        Padding="24,12"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        MinWidth="160"
                                        MinHeight="44"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Progreso del escaneo -->
                    <StackPanel x:Name="ChequeoProgressPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="260">
                        <!-- Velocímetro de progreso del análisis -->
                        <controls:SpeedometerGauge x:Name="ChequeoRing"
                                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ChequeoProgressText"
                                   Text="Preparando..."
                                   FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="ChequeoCancelButton"
                                Content="Cancelar"
                                Click="ChequeoCancelButton_Click"
                                HorizontalAlignment="Center"
                                CornerRadius="6"
                                Padding="16,8"
                                FontWeight="SemiBold"
                                MinWidth="120"/>
                    </StackPanel>

                    <!-- Área de resultados (aparece después de escanear; la card de total
                         queda fija arriba, fuera del scroll). Abarca las 3 filas con Top:
                         las cards arrancan arriba del todo, sin centrado vertical. -->
                    <StackPanel x:Name="ChequeoResultsPanel" Grid.Row="0" Grid.RowSpan="3" Spacing="16" Visibility="Collapsed"
                                VerticalAlignment="Top"
                                Margin="24,16,24,24">

                        <!-- ============ VISTA FASE 1: LIMPIEZA DE ARCHIVOS ============ -->
                        <StackPanel x:Name="ChequeoPhase1View" Spacing="16">

                        <!-- ===== Sección 1: Navegadores ===== -->
                        <StackPanel x:Name="ChequeoBrowserSection" Spacing="10" Visibility="Collapsed">
                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Navegadores" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ChequeoBrowserTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="ChequeoBrowsersHost" Spacing="8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Sección 2: Sistema ===== -->
                        <StackPanel x:Name="ChequeoSystemSection" Spacing="10" Visibility="Collapsed">
                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Archivos temporales del sistema" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ChequeoSystemTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="ChequeoSystemHost" Spacing="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Sección 3: Caché de aplicaciones ===== -->
                        <StackPanel x:Name="ChequeoAppCacheSection" Spacing="10" Visibility="Collapsed">
                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7B5;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Memoria caché de aplicaciones" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ChequeoAppCacheTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="ChequeoAppCacheHost" Spacing="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== Sección 4: Papelera ===== -->
                        <StackPanel x:Name="ChequeoRecycleSection" Spacing="10" Visibility="Collapsed">
                            <Border Style="{StaticResource AnalysisCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Papelera de reciclaje" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="ChequeoRecycleTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="ChequeoRecycleHost" Spacing="6"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </StackPanel>

                        <!-- ============ VISTA FASE 2: APLICACIONES EN SEGUNDO PLANO ============ -->
                        <StackPanel x:Name="ChequeoPhase2View" Spacing="16" Visibility="Collapsed">
                            <StackPanel x:Name="ChequeoAppsSection" Spacing="10" Visibility="Collapsed">
                                <Border Style="{StaticResource AnalysisCardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE770;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Aplicaciones en segundo plano" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="ChequeoAppsTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Marcá las aplicaciones que querés cerrar para liberar memoria."
                                                   FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="ChequeoAppsHost" Spacing="6"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- ============ VISTA FASE 3: APLICACIONES DE INICIO ============ -->
                        <StackPanel x:Name="ChequeoPhase3View" Spacing="16" Visibility="Collapsed">
                            <StackPanel x:Name="ChequeoStartupSection" Spacing="10" Visibility="Collapsed">
                                <Border Style="{StaticResource AnalysisCardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AccentTintBrush}"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource AccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="Aplicaciones de inicio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="{ThemeResource AccentTintBrush}" CornerRadius="10" Padding="10,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="ChequeoStartupTotal" Text="" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Marcá las aplicaciones que querés desactivar del inicio de Windows."
                                                   FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="ChequeoStartupHost" Spacing="6"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== PESTAÑA 2: LIMPIEZA PERSONALIZADA ==================== -->
            <Grid x:Name="CustomTab" Visibility="Collapsed">
                <ScrollViewer x:Name="CustomScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Las filas estrella (arriba/abajo) centran el panel de inicio sin
                         MinHeight binding ni margins que generen scroll fantasma. El
                         contenido tras analizar abarca las 3 filas (RowSpan) con Top
                         para arrancar arriba, sin centrado vertical. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel de inicio: texto + opciones agrupadas + Analizar (estilo CCleaner) -->
                        <StackPanel x:Name="CustomStartPanel"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="20,0,20,0"
                                    Spacing="12">
                            <TextBlock Text="Hacé clic en Analizar para medir el espacio de cada categoría de limpieza. Después podés desmarcar lo que no quieras borrar."
                                       FontSize="13"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="480"/>

                            <!-- Opciones: grupos de carpetas que se analizan -->
                            <Border Background="{ThemeResource CardBackgroundBrush}"
                                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="16"
                                    MaxWidth="480"
                                    HorizontalAlignment="Center">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Opciones de análisis" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Elegí los grupos de carpetas que querés analizar. Después del análisis podés desmarcar carpeta por carpeta."
                                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="CustomGroupChecksHost" Spacing="2"/>
                                    <TextBlock x:Name="CustomStartFeedback" Text="" FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="CustomStartButton"
                                    Content="Analizar"
                                    Click="CustomStartButton_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    CornerRadius="8"
                                    Padding="24,12"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    MinWidth="160"
                                    MinHeight="44"/>
                        </StackPanel>

                        <!-- Contenido: aparece después de analizar, con las tarjetas expandidas.
                             Abarca las 3 filas con Top: las cards arrancan arriba del todo. -->
                        <StackPanel x:Name="CustomContentPanel" Grid.Row="0" Grid.RowSpan="3" Spacing="16" Visibility="Collapsed"
                                    VerticalAlignment="Top"
                                    Margin="24,16,24,24">

                            <!-- Card hero: total encontrado + acciones (re-analizar / limpiar) -->
                            <Border Background="{ThemeResource CardBackgroundBrush}"
                                    BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="18">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="4" Background="{ThemeResource AccentBrush}" CornerRadius="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="CustomTotals" Text="" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Marcá los elementos que quieras limpiar y presioná Limpiar para liberar espacio."
                                                   FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CustomFeedbackText" Text="" FontSize="12"
                                                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="CleanCustomButton" Grid.Column="2"
                                            Content="Limpiar"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="False"
                                            Click="CleanCustomButton_Click"
                                            CornerRadius="12"
                                            Padding="20,10"
                                            FontWeight="SemiBold"
                                            MinWidth="120"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="CategoriesHost" Spacing="12"/>
                        </StackPanel>

                        <!-- Progreso del análisis: velocímetro con % central, como en Chequeo -->
                        <StackPanel x:Name="CustomProgressPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="260">
                            <!-- Velocímetro de progreso del análisis -->
                            <controls:SpeedometerGauge x:Name="CustomRing"
                                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CustomProgressText"
                                       Text="Preparando..."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                            <Button x:Name="CustomCancelButton"
                                    Content="Cancelar"
                                    Click="CustomCancelButton_Click"
                                    HorizontalAlignment="Center"
                                    CornerRadius="6"
                                    Padding="16,8"
                                    FontWeight="SemiBold"
                                    MinWidth="120"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ==================== PESTAÑA 3: BUSCADOR DE DUPLICADOS ==================== -->
            <ScrollViewer x:Name="DupTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,16,24,24">

                    <!-- Configuración: unidad o carpeta a escanear + scan -->
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Unidad o carpeta a escanear" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Elegí un disco (incluidos los USB) o examiná una carpeta. Solo se revisan archivos de entre 1 KB y 500 MB."
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox x:Name="DupDrivePicker"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="DupDrivePicker_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="14"
                                                          Foreground="{ThemeResource AccentBrush}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- Oculto: la lógica de scan sigue leyendo de acá -->
                                <TextBox x:Name="DupPathBox" Visibility="Collapsed"/>
                                <Button x:Name="DupScanButton"
                                        Grid.Column="1"
                                        Content="Escanear"
                                        Click="DupScanButton_Click"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontWeight="SemiBold"
                                        MinWidth="100"/>
                            </Grid>

                            <!-- Papelera opcional (estilo CCleaner): por defecto activada,
                                 los borrados quedan recuperables -->
                            <CheckBox x:Name="DupRecycleToggle"
                                      Content="Enviar los borrados a la papelera de reciclaje (recuperable)"
                                      FontSize="12"
                                      IsChecked="True"/>

                            <!-- Progreso del escaneo: anillo + carpeta actual + cancelar -->
                            <StackPanel x:Name="DupProgressPanel"
                                        Spacing="10"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <!-- Velocímetro de progreso del escaneo -->
                                <controls:SpeedometerGauge x:Name="DupRing"
                                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DupProgressText" Text="" FontSize="12"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="420"
                                           HorizontalAlignment="Center"/>
                                <Button x:Name="DupCancelButton"
                                        Content="Cancelar"
                                        Click="DupCancelButton_Click"
                                        HorizontalAlignment="Center"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontWeight="SemiBold"
                                        MinWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Resultados -->
                    <Border x:Name="DupResultsCard" Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="12">

                            <!-- Resumen hero: grupos, archivos y espacio liberable + botón de borrado -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="10" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="3" Background="{ThemeResource AccentBrush}" CornerRadius="1.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="DupSummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DupDetailText" FontSize="12"
                                                   Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="DupDeleteButton" Grid.Column="2"
                                            Content="Borrar seleccionados"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="DupDeleteButton_Click"
                                            CornerRadius="8"
                                            Padding="16,8"
                                            FontWeight="SemiBold"
                                            MinWidth="150"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="DupGroupsHost" Spacing="8"/>
                            <Button x:Name="DupShowMoreButton"
                                    Content="Mostrar más grupos"
                                    Click="DupShowMoreButton_Click"
                                    HorizontalAlignment="Center"
                                    CornerRadius="8"
                                    Padding="16,8"
                                    FontWeight="SemiBold"
                                    Visibility="Collapsed"/>
                            <TextBlock x:Name="DupFeedbackText" Text="" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PESTAÑA 4: ADMINISTRACIÓN DE INICIO ==================== -->
            <ScrollViewer x:Name="StartupTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="14" Margin="24,16,24,24">

                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Programas que se ejecutan al iniciar sesión" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="StartupRefreshButton"
                                        Content="Actualizar"
                                        Click="StartupRefreshButton_Click"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Activá o desactivá las entradas. La app que tildes como desactivada deja de arrancar al iniciar sesión sin borrarla."
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                            <!-- Cabecera de columnas -->
                            <Grid ColumnDefinitions="Auto,1.6*,0.5*,0.5*" ColumnSpacing="8" Padding="4,2,4,4">
                                <TextBlock Text="" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Comando" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Estado" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3"/>
                            </Grid>

                            <StackPanel x:Name="StartupEntriesHost" Spacing="2"/>

                            <TextBlock x:Name="StartupFeedbackText" Text="" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>