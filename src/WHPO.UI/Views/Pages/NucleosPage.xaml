<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.NucleosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
<!-- Botón de ayuda ("qué hace") que acompaña a cada nombre de ajuste en la card del
             techo de turbo. Mismo aspecto que los que se arman en código con
             TooltipStyles.CreateInfoButton: chico, sin fondo, con el ícono de información. -->
        <Style x:Key="InfoIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*">

<!-- ====== NAVBAR INTERNO: Núcleos / Gestionar / Comparar ====== -->
<!-- Borde de ancho completo con el color del navbar: la franja conecta con
             el panel izquierdo y el borde superior sin quedar recortada por márgenes. -->
        <Border Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <SelectorBar x:Name="PlanTabs"
                         Margin="20,10,20,4"
                         Background="Transparent"
                         SelectionChanged="PlanTabs_SelectionChanged">
                <SelectorBarItem Text="Núcleos" IsSelected="True"/>
                <SelectorBarItem Text="Gestionar planes de energía"/>
                <SelectorBarItem Text="Comparar planes de energía"/>
            </SelectorBar>
        </Border>

        <Grid Grid.Row="1">

<!-- ====== SKELETON DE CARGA (mismo estilo que Sistema) ====== -->
            <StackPanel x:Name="PageSkeleton" Spacing="16" Margin="24,12,24,24" IsHitTestVisible="False">
<!-- Card: gráfico de temperatura -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Width="170" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Height="248" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

<!-- Cards de métricas (uso / temperatura / clock) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <Rectangle Width="130" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Width="90" Height="30" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="80" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <Rectangle Width="130" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Width="90" Height="30" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="80" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <Rectangle Width="130" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Width="90" Height="30" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="80" Height="13" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

<!-- Card: núcleos del procesador -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Width="180" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Width="150" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

<!-- Card: plan de energía -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Rectangle Width="140" Height="16" RadiusX="8" RadiusY="8"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Rectangle Width="320" Height="12" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Rectangle Height="32" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Grid.Column="1" Width="120" Height="32" RadiusX="6" RadiusY="6"
                                       Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

<!-- ==================== PESTAÑA 1: NÚCLEOS (contenido existente) ==================== -->
            <ScrollViewer x:Name="PageContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,12,24,24">

<!-- ============ GRÁFICO DE TEMPERATURA DEL CPU (estilo Administrador de tareas) ============ -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
<!-- Cabecera del gráfico -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
<!-- Ícono de temperatura, con el color de encabezado del resto de la app (el
                                         acento). Antes tenía el ícono de "uso", que no es lo que
                                         muestra este gráfico. Verde queda para el dato de temperatura. -->
                                    <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Temperatura del CPU" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

<!-- Leyenda de umbrales térmicos -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource MetricTempBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&lt; 85°C" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource MetricPowerBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="85 – 90°C" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource ErrorBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="≥ 90°C" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

<!-- Gráfico + eje Y -->
                            <Grid Grid.Row="1" ColumnDefinitions="40,*" ColumnSpacing="10">
<!-- Eje Y (temperaturas): fondo oscuro en ambos temas para que la
                                     zona del gráfico se lea como una "pantalla" única (el plot también
                                     es oscuro) y las etiquetas mantengan buen contraste en modo claro. -->
                                <Canvas x:Name="YAxisCanvas" Width="40" Height="248" VerticalAlignment="Top" Background="{ThemeResource ChartBackgroundBrush}"/>

<!-- Gráfico con scroll horizontal -->
                                <Grid Grid.Column="1">
                                    <ScrollViewer x:Name="ChartScroll"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollMode="Enabled"
                                                  VerticalScrollMode="Disabled"
                                                  ZoomMode="Disabled">
                                        <Grid x:Name="ChartInner" Width="1200" Height="248">
                                            <Canvas x:Name="ChartCanvas" Width="1200" Height="248" Background="{ThemeResource ChartBackgroundBrush}"/>
<!-- Capa de hover: cruz + etiqueta con temperatura exacta y hora -->
                                            <Canvas x:Name="HoverCanvas" Width="1200" Height="248" IsHitTestVisible="False"/>
                                        </Grid>
                                    </ScrollViewer>

<!-- Aviso térmico (a la derecha del gráfico) -->
                                    <Border x:Name="ThermalWarningBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,10,10,0"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon x:Name="ThermalWarningIcon" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ThermalWarningText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

<!-- ============ CARDS DE MÉTRICAS (actual + mínimo + máximo) ============ -->
<!-- OJO: cada card necesita su Grid.Column; sin él todas caen en la columna 0
                         y se superponen (solo se veía la última, la de frecuencia). -->
                    <Grid x:Name="MetricsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12">
<!-- Uso del procesador -->
                        <Border x:Name="CardUsageBorder" Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
<!-- Los íconos de las métricas van en el acento del tema (que cambia con cada
                                         tema, incluidos Rosa/Blanco y Negro/Azul); el color de cada
                                         métrica queda en su valor. -->
                                    <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Uso del procesador" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuUsageValueText" Text="--%" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource MetricUsageBrush}"/>
                                <ProgressBar x:Name="CpuUsageBar" Height="4" Maximum="100" Value="0"/>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24">
                                    <StackPanel>
                                        <TextBlock Text="Mín" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuUsageMinText" Text="--%" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Máx" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuUsageMaxText" Text="--%" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

<!-- Temperatura -->
                        <Border x:Name="CardTempBorder" Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9CA;" FontSize="14" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Temperatura" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuTempValueText" Text="--°C" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource MetricTempBrush}"/>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24">
                                    <StackPanel>
                                        <TextBlock Text="Mín" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuTempMinText" Text="--°C" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Máx" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuTempMaxText" Text="--°C" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

<!-- Frecuencia (Clock) -->
                        <Border x:Name="CardClockBorder" Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Frecuencia (Clock)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuClockValueText" Text="--" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource MetricUsageBrush}"/>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="24">
                                    <StackPanel>
                                        <TextBlock Text="Mín" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuClockMinText" Text="--" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Máx" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="CpuClockMaxText" Text="--" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

<!-- ============ NÚCLEOS DEL PROCESADOR ============ -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
<!-- Encabezados en el acento del tema (la convención del resto de la app); el
                                         cian queda para los datos de uso. -->
                                    <FontIcon Glyph="&#xE950;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Núcleos del procesador" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

<!-- Leyenda -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource MetricTempBrush}"/>
                                        <TextBlock Text="Activo" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="14" Height="14" CornerRadius="3" Background="{ThemeResource ErrorBrush}"/>
                                        <TextBlock Text="Estacionado" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

<!-- Barras por núcleo (se crean desde código) -->
                            <ItemsControl x:Name="CoresHost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

<!-- ============ PLAN DE ENERGÍA (selector, se mantiene) ============ -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE83E;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Plan de energía" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                            <TextBlock Text="Elegí el plan de energía activo de Windows. No requiere permisos de administrador."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <ComboBox x:Name="PowerPlanCombo"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Cargando planes..."
                                          DropDownOpened="PowerPlanCombo_DropDownOpened"/>
                                <Button x:Name="ApplyPowerPlanButton"
                                        Grid.Column="1"
                                        Content="Aplicar plan"
                                        Click="ApplyPowerPlanButton_Click"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontWeight="SemiBold"
                                        MinWidth="120"
                                        IsEnabled="False"/>
                            </Grid>
                            <TextBlock x:Name="PowerPlanStatusText" Text="" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

<!-- ============ TECHO DE TURBO ============ -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Techo de turbo" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{ThemeResource ChipBackgroundBrush}"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TurboPlanChipText" FontSize="11"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Movés el techo de frecuencia del procesador dentro del plan de energía activo. Bajar el límite no acelera nada: cambia calor y ruido por rendimiento. No es overclock ni supera el turbo que el procesador ya admite."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

<!-- Dos columnas: cada ajuste es "nombre + botón de ayuda", con su valor y la barra
                                 debajo. El detalle de qué hace cada uno vive en el tooltip del botón ⓘ,
                                 así no se apilan líneas de texto: la fila se lee de un vistazo. -->
                            <Grid x:Name="TurboControlsPanel" ColumnDefinitions="*,*" ColumnSpacing="28" RowSpacing="16">
<!-- Modo boost -->
                                <StackPanel x:Name="TurboBoostRow" Spacing="6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Modo boost" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="TurboBoostInfoButton"
                                                Style="{StaticResource InfoIconButtonStyle}">
                                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                                      Foreground="{ThemeResource MutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="TurboBoostValueText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap"/>
                                    <Slider x:Name="TurboBoostSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="1"
                                            TickFrequency="1"
                                            TickPlacement="Inline"
                                            VerticalAlignment="Center"
                                            ValueChanged="TurboBoostSlider_ValueChanged"/>
                                </StackPanel>

<!-- Límite de rendimiento -->
                                <StackPanel x:Name="TurboLimitRow" Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Límite de rendimiento" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="TurboLimitInfoButton"
                                                Style="{StaticResource InfoIconButtonStyle}">
                                            <FontIcon Glyph="&#xE946;" FontSize="12"
                                                      Foreground="{ThemeResource MutedBrush}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="TurboLimitValueText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap"/>
                                    <Slider x:Name="TurboLimitSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="TurboLimitSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>

<!-- Estado vacío: el equipo no expone el ajuste (se dice por qué, no se esconde) -->
                            <Border x:Name="TurboUnavailableBorder"
                                    Background="{ThemeResource ChipBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14"
                                              Foreground="{ThemeResource SecondaryTextBrush}"
                                              VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TurboUnavailableText"
                                               FontSize="12"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

<!-- ===== Ajustes avanzados del procesador (plegable) ===== -->
                            <Expander x:Name="TurboAdvancedExpander"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      IsExpanded="False"
                                      Visibility="Collapsed">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;" FontSize="14"
                                                  Foreground="{ThemeResource SecondaryTextBrush}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="Ajustes avanzados del procesador"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="12" Margin="0,8,0,0">
                                    <TextBlock Text="Políticas de energía de Windows para el procesador. No es overclock: no sube nada por encima de lo que el equipo ya permite, y se aplican al plan activo."
                                               FontSize="11"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>

<!-- Las filas se arman desde código con los ajustes que expone este equipo.
                                         Van de a dos por fila (nombre + botón de ayuda, valor y barra). -->
                                    <StackPanel x:Name="TurboAdvancedPanel" Spacing="16"/>

                                </StackPanel>
                            </Expander>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="TurboScopeText"
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="TurboRestoreButton"
                                            Content="Restaurar"
                                            Click="TurboRestoreButton_Click"
                                            CornerRadius="6"
                                            Padding="16,8"
                                            FontWeight="SemiBold"
                                            MinWidth="110"
                                            IsEnabled="False"/>
                                    <Button x:Name="TurboApplyButton"
                                            Content="Aplicar"
                                            Click="TurboApplyButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            CornerRadius="6"
                                            Padding="16,8"
                                            FontWeight="SemiBold"
                                            MinWidth="110"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TurboStatusText" Text="" FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

<!-- ==================== PESTAÑA 2: GESTIONAR PLANES DE ENERGÍA ==================== -->
            <ScrollViewer x:Name="GestionarTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,12,24,24">
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE83E;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Gestionar planes de energía" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Seleccioná un plan para renombrarlo, activarlo o borrarlo."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

<!-- Cabecera de columnas -->
                            <Grid ColumnDefinitions="2*,1.1*,3*,0.7*" ColumnSpacing="12" Padding="4,0,4,4">
                                <TextBlock Text="Nombre" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="ID" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Descripción" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Activo" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </Grid>

                            <ListView x:Name="PlansList"
                                      MaxHeight="320"
                                      SelectionMode="Single"
                                      SelectionChanged="PlansList_SelectionChanged"/>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="RenamePlanButton" Content="Renombrar" IsEnabled="False"
                                            Click="RenamePlanButton_Click" CornerRadius="6" Padding="16,8" FontWeight="SemiBold" MinWidth="110"/>
                                    <Button x:Name="ActivatePlanButton" Content="Activar" IsEnabled="False"
                                            Click="ActivatePlanButton_Click" CornerRadius="6" Padding="16,8" FontWeight="SemiBold" MinWidth="110"/>
                                    <Button x:Name="DeletePlanButton" Content="Borrar" IsEnabled="False"
                                            Click="DeletePlanButton_Click" CornerRadius="6" Padding="16,8" FontWeight="SemiBold" MinWidth="110"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="OpenPowerOptionsButton"
                                        Click="OpenPowerOptionsButton_Click"
                                        CornerRadius="6"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE83E;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Abrir planes de energía de Windows" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="ManagePlanStatusText" Text="" FontSize="12"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

<!-- ===== INSTALAR PLANES DE ENERGÍA ===== -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Instalar planes de energía" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Planes oficiales de Windows y presets reconocidos por la comunidad (Ryzen, Bitsum…). Se instalan duplicando un plan base; podés borrarlos después desde la lista de arriba."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

<!-- Cabecera de columnas -->
                            <Grid ColumnDefinitions="1.6*,2.4*,0.9*,0.9*" ColumnSpacing="12" Padding="4,0,4,4">
                                <TextBlock Text="Plan" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Descripción" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Tipo" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Estado" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </Grid>

                            <ListView x:Name="InstallPlansList"
                                      MaxHeight="280"
                                      SelectionMode="Single"
                                      SelectionChanged="InstallPlansList_SelectionChanged"/>

                            <Button x:Name="InstallPlanButton"
                                    Content="Instalar"
                                    IsEnabled="False"
                                    Click="InstallPlanButton_Click"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6" Padding="16,8" FontWeight="SemiBold" MinWidth="110"/>

                            <TextBlock x:Name="InstallPlanStatusText" Text="" FontSize="12"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

<!-- ==================== PESTAÑA 3: COMPARAR PLANES DE ENERGÍA ==================== -->
            <ScrollViewer x:Name="CompararTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,12,24,24">

<!-- Configuración de la comparación -->
                    <Border Background="{ThemeResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE83E;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Comparar planes de energía" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Elegí dos planes distintos y el color con el que se van a marcar las diferencias en cada cuadrícula. Se muestran todos los ajustes de energía: los que el plan define muestran su valor, y los que no, el valor predeterminado de Windows para ese tipo de plan."
                                       FontSize="12"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Plan A" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox x:Name="ComparePlanACombo"
                                              PlaceholderText="Seleccioná un plan"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ComparePlanCombo_SelectionChanged"/>
                                </StackPanel>
                                <Button x:Name="ColorAButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        MinWidth="104"
                                        Click="ColorAButton_Click"/>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Plan B" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox x:Name="ComparePlanBCombo"
                                              PlaceholderText="Seleccioná un plan"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="ComparePlanCombo_SelectionChanged"/>
                                </StackPanel>
                                <Button x:Name="ColorBButton"
                                        Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        MinWidth="104"
                                        Click="ColorBButton_Click"/>
                            </Grid>

                            <Button x:Name="CompareButton"
                                    Content="Comparar"
                                    IsEnabled="False"
                                    Click="CompareButton_Click"
                                    CornerRadius="6"
                                    Padding="20,9"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Left"
                                    MinWidth="130"/>

                            <TextBlock x:Name="CompareStatusText" Text="" FontSize="12"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

<!-- Resultado: dos cuadrículas lado a lado dentro del MISMO scroll.
                         OJO: el scroll queda deshabilitado en el interno a propósito:
                         si está activo, se traga la rueda del mouse sobre las cuadrículas
                         y la página no scrollea. El vertical lo maneja el ScrollViewer de
                         la pestaña (mismo scroll para ambas) y NO hay scroll lateral:
                         las columnas se adaptan al ancho disponible (app responsiva). -->
                    <ScrollViewer x:Name="CompareScroll"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  ZoomMode="Disabled">
                        <StackPanel Spacing="10">
<!-- Botones para expandir/cerrar todos los subgrupos: aparecen
                                 después de comparar, junto con la cuadrícula de resultados. -->
                            <StackPanel x:Name="CompareActionsPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                <Button x:Name="ExpandAllButton"
                                        Content="Expandir subgrupos"
                                        Click="ExpandAllButton_Click"
                                        CornerRadius="6"
                                        Padding="12,7"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                                <Button x:Name="CollapseAllButton"
                                        Content="Cerrar subgrupos"
                                        Click="CollapseAllButton_Click"
                                        CornerRadius="6"
                                        Padding="12,7"
                                        FontSize="12"
                                        FontWeight="SemiBold"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel x:Name="ComparePlanAContainer" Spacing="0"/>
                                <StackPanel Grid.Column="1" x:Name="ComparePlanBContainer" Spacing="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
