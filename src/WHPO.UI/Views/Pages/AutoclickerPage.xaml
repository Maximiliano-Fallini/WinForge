<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.AutoclickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24">

            <!-- ====== INTERVALO POR CLICK ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Intervalo por click" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Tiempo entre cada clic. Combiná horas, minutos, segundos y milisegundos."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Horas" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <NumberBox x:Name="HoursBox" Value="0" Minimum="0" Maximum="23" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Minutos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <NumberBox x:Name="MinutesBox" Value="0" Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Segundos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <NumberBox x:Name="SecondsBox" Value="0" Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Milisegundos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <NumberBox x:Name="MillisecondsBox" Value="100" Minimum="0" Maximum="999" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== OPCIONES ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Opciones" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Doble click" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Hace dos clics en lugar de uno." FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="DoubleClickSwitch" Grid.Column="1" OnContent="" OffContent="" IsOn="False" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Parada en esquina" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Detiene el autoclicker si movés el mouse hasta el borde de la pantalla."
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="CornerStopSwitch" Grid.Column="1" OnContent="" OffContent="" IsOn="False" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== LIMITE ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Límite" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Subapartado: Clicks -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Clicks" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Cantidad máxima de clics generados."
                                           FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="LimitSwitch" Grid.Column="1" OnContent="" OffContent="" IsOn="False" VerticalAlignment="Center" Toggled="LimitSwitch_Toggled"/>
                        </Grid>
                        <NumberBox x:Name="LimitBox" Value="100" Minimum="1" Maximum="1000000" SmallChange="1"
                                   SpinButtonPlacementMode="Inline" IsEnabled="False" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}"/>

                    <!-- Subapartado: Tiempo -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Tiempo" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Duración máxima del autoclicker."
                                           FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="DurationSwitch" Grid.Column="1" OnContent="" OffContent="" IsOn="False" VerticalAlignment="Center" Toggled="DurationSwitch_Toggled"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Horas" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <NumberBox x:Name="DurationHoursBox" Value="0" Minimum="0" Maximum="23" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Minutos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <NumberBox x:Name="DurationMinutesBox" Value="0" Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Segundos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <NumberBox x:Name="DurationSecondsBox" Value="0" Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4">
                                <TextBlock Text="Milisegundos" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                                <NumberBox x:Name="DurationMillisecondsBox" Value="0" Minimum="0" Maximum="999" SmallChange="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ====== POSICION DEL CURSOR ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE96A;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Posición del cursor" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Coordenadas de pantalla (X, Y) donde se hará el clic. Dejá vacío para usar la posición actual del cursor."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="PosXBox" Header="X" PlaceholderText="Ej: 960" InputScope="Number"/>
                        <TextBox Grid.Column="1" x:Name="PosYBox" Header="Y" PlaceholderText="Ej: 540" InputScope="Number"/>
                        <Button Grid.Column="2" Content="Usar posición actual" Click="UseCurrentPositionButton_Click"
                                VerticalAlignment="Bottom" Padding="16,8" CornerRadius="6"/>
                    </Grid>
                    <TextBlock x:Name="CurrentPosText" Text="" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ====== HOTKEY ====== -->
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE770;" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Hotkey global" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Inicia o detiene el autoclicker desde cualquier aplicación. Hacé clic en el campo y presioná la tecla que quieras usar."
                               FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button x:Name="StartStopButton" Content="Iniciar (F6)" Click="StartStopButton_Click" MinWidth="160"
                                Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource AccentForegroundBrush}"
                                FontWeight="SemiBold" CornerRadius="6" Padding="16,10"/>
                        <TextBox Grid.Column="1" x:Name="HotkeyBox" PlaceholderText="Hacé clic acá y presioná una tecla..."
                                 VerticalAlignment="Center" KeyDown="HotkeyBox_KeyDown" GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"
                                 IsReadOnly="True" MaxWidth="280" HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyStatusText" Text="F6" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="StatusText" Text="" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
