<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.AdministracionInicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WHPO_UI.Controls">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="24">

<!-- Card única del componente: cabecera + columnas + lista de entradas -->
            <Border Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <StackPanel Spacing="10">

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Programas que se ejecutan al iniciar sesión" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Activá o desactivá las entradas: la que desactives deja de arrancar al iniciar sesión sin borrarse."
                                       FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="StartupRefreshButton" Grid.Column="1"
                                Content="Actualizar"
                                Click="StartupRefreshButton_Click"
                                CornerRadius="6"
                                Padding="10,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                VerticalAlignment="Top"/>
                    </Grid>

<!-- Cabecera de columnas: coincide con la grilla de cada fila -->
                    <Grid ColumnDefinitions="Auto,1.6*,0.6*" ColumnSpacing="8" Padding="4,2,4,4">
                        <TextBlock Text="" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="Comando" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="Estado" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                    </Grid>

<!-- Carga de las entradas: el mismo velocímetro del resto de la app, en modo
                         indeterminado (todavía no hay avance que medir).
                         Lo alterna LoadStartupEntriesAsync. -->
                    <StackPanel x:Name="StartupLoadingPanel" Spacing="10" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,4">
                        <controls:SpeedometerGauge x:Name="StartupRing"
                                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Cargando entradas de inicio..." FontSize="12"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="StartupEntriesHost" Spacing="2"/>

                    <TextBlock x:Name="StartupFeedbackText" Text="" FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
