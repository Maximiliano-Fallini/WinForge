<Page
    x:Class="WHPO_UI.Views.Pages.MemoriaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">
            <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

            <!-- ====== SECCIÓN 1: STANDBY LIST CLEANER ====== -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                <FontIcon Glyph="&#xE7F1;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Standby List Cleaner" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                <StackPanel Spacing="12">
                    <!-- Estadísticas de memoria: fila 1 -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="RAM Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="TotalMemoryText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Lista en espera (caché)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="StandbySizeText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Archivo de paginación" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="PageFileText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Estadísticas de memoria: fila 2 -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="RAM Libre" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="FreeMemoryText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="RAM Disponible" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="AvailableMemoryText" Text="--" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="10" Padding="14" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Última limpieza" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="LastCleanupText" Text="Nunca" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="CleanStandbyButton" Content="Liberar memoria ahora" Click="CleanStandbyButton_Click" HorizontalAlignment="Left" MinWidth="180"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="SemiBold" CornerRadius="6" Padding="16,8"/>
                    </StackPanel>
                    <TextBlock x:Name="CleanStandbyResultText" Text="" FontSize="12" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                    <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,2"/>

                    <!-- Configuración de limpieza automática -->
                    <TextBlock Text="Limpieza automática" FontSize="14" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Activar cuando la caché alcance" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="MinStandbyTextBox" Text="1024" BeforeTextChanging="NumericTextBox_BeforeTextChanging"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Y la RAM libre baje de" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="MaxFreeTextBox" Text="4096" BeforeTextChanging="NumericTextBox_BeforeTextChanging"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Frecuencia de comprobación" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PollIntervalCombo" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="AutoCleanupButton" Content="Iniciar" Click="AutoCleanupButton_Click" MinWidth="120" Padding="16,8" CornerRadius="6"/>
                        <Button x:Name="AutoConfigureButton" Content="Autoajustar" Click="AutoConfigureButton_Click" MinWidth="140" Padding="16,8" CornerRadius="6"/>
                        <TextBlock x:Name="AutoCleanupStatusText" Text="Detenido" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="AutoCleanupLogPanel" Spacing="4"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
