<Page
    x:Class="WHPO_UI.Views.Pages.SistemaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel Spacing="16" Margin="24">
            <TextBlock x:Name="DebugText" Text="" Visibility="Collapsed" FontWeight="SemiBold" FontSize="24"/>

            <!-- ====== RESUMEN: tarjetas unificadas (2 columnas, logo a la izquierda) ====== -->
            <TextBlock Text="Resumen del sistema" FontWeight="SemiBold" FontSize="18" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <!-- CPU -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid x:Name="CpuContent" ColumnDefinitions="80,*" ColumnSpacing="16" Visibility="Collapsed">
                            <Image x:Name="CpuLogoImage" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="CPU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="CpuNameText" Text="" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                <ProgressBar x:Name="CpuUsageBar" Value="0" Height="6"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="CpuUsageText" Text="0%" FontWeight="Bold" FontSize="24"/>
                                    <TextBlock x:Name="CpuTempText" Text="" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuDetailsText" Text="--" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="CpuSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="48" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="26" Width="240" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Height="26" Width="130" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="170" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="150" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- GPU -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid x:Name="GpuContent" ColumnDefinitions="80,*" ColumnSpacing="16" Visibility="Collapsed">
                            <Image x:Name="GpuLogoImage" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="GPU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="GpuNameText" Text="" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                <ProgressBar x:Name="GpuUsageBar" Value="0" Height="6"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="GpuUsageText" Text="0%" FontWeight="Bold" FontSize="24"/>
                                    <TextBlock x:Name="GpuTempText" Text="" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="GpuVramText" Text="" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="GpuSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="48" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="26" Width="220" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Height="26" Width="130" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="170" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- RAM -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid x:Name="RamContent" ColumnDefinitions="80,*" ColumnSpacing="16" Visibility="Collapsed">
                            <!-- RAM literal (mismo glyph que el navbar: EEA0) -->
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEEA0;" FontSize="72" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="RAM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="RamTotalText" Text="" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="RamUsageBar" Value="0" Height="6"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="RamUsageText" Text="0%" FontWeight="Bold" FontSize="24"/>
                                    <TextBlock x:Name="RamUsedText" Text="" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="RamDetailsText" Text="--" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="RamSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="48" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="24" Width="160" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Height="26" Width="120" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="180" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Almacenamiento (disco duro) -->
                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="150">
                    <Grid>
                        <Grid x:Name="StorageContent" ColumnDefinitions="80,*" ColumnSpacing="16" Visibility="Collapsed">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEDA2;" FontSize="72" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Almacenamiento" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="StorageTotalText" Text="" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="StorageUsageBar" Value="0" Height="6"/>
                                <TextBlock x:Name="StorageUsageText" Text="0%" FontWeight="Bold" FontSize="24"/>
                                <TextBlock x:Name="StorageFreeText" Text="Libre: --" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="StorageSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="120" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="24" Width="200" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Rectangle Height="26" Width="120" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="170" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Sistema Operativo (ancho completo, logo de Windows) -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="120">
                    <Grid>
                        <Grid x:Name="OsContent" ColumnDefinitions="80,*" ColumnSpacing="16" Visibility="Collapsed">
                            <Path Data="M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z"
                                  Fill="{ThemeResource AccentBrush}" Stretch="Uniform" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Sistema Operativo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="OsNameText" Text="--" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="OsDetailsText" Text="--" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="OsSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="130" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="22" Width="280" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="320" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>


            <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,4"/>

            <!-- ====== SECCIÓN 6: SISTEMA (Motherboard / BIOS / SO) ====== -->
            <TextBlock Text="Placa Base y BIOS" FontWeight="SemiBold" FontSize="18" Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                    <Grid>
                        <StackPanel x:Name="BoardContent" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Placa Base" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Fabricante" FontSize="13"/>
                                <TextBlock x:Name="BoardManufacturerText" Grid.Column="1" Text="--" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Producto" FontSize="13"/>
                                <TextBlock x:Name="BoardProductText" Grid.Column="1" Text="--" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="BoardSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="110" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="200" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="180" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="160" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16">
                    <Grid>
                        <StackPanel x:Name="BiosContent" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="BIOS" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Fabricante" FontSize="13"/>
                                <TextBlock x:Name="BiosManufacturerText" Grid.Column="1" Text="--" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Versión SMBIOS" FontSize="13"/>
                                <TextBlock x:Name="BiosVersionText" Grid.Column="1" Text="--" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="BiosSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="90" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="180" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="160" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="140" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource CardBorderBrush}" Margin="0,4"/>

            <!-- ====== SECCIÓN 7: SEGURIDAD Y VIRTUALIZACIÓN (TPM / Secure Boot / IOMMU) ====== -->
            <TextBlock Text="Seguridad y virtualización" FontWeight="SemiBold" FontSize="18" Margin="0,4,0,0"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- TPM -->
                <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="110">
                    <Grid>
                        <StackPanel x:Name="TpmContent" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="TPM" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="TpmIndicator" Width="10" Height="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TpmStatusText" Text="--" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="TpmVersionText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="TpmSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="60" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="16" Width="130" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="95" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Secure Boot -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="110">
                    <Grid>
                        <StackPanel x:Name="SecureBootContent" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Arranque seguro" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="SecureBootIndicator" Width="10" Height="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SecureBootStatusText" Text="--" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="SecureBootFirmwareText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="SecureBootSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="110" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="16" Width="140" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="70" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- IOMMU -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="16" MinHeight="110">
                    <Grid>
                        <StackPanel x:Name="IommuContent" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="IOMMU" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="IommuIndicator" Width="10" Height="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IommuStatusText" Text="--" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="IommuVendorText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <!-- Skeleton de carga -->
                        <StackPanel x:Name="IommuSkeleton" Spacing="10" IsHitTestVisible="False" Background="{ThemeResource CardBackgroundBrush}">
                            <Rectangle Height="12" Width="60" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="16" Width="120" RadiusX="8" RadiusY="8" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Height="12" Width="90" RadiusX="6" RadiusY="6" Fill="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>