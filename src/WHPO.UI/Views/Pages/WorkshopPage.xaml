<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WHPO_UI.Views.Pages.WorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RowDefinitions="Auto,*">

<!-- ====== CABECERA ====== -->
        <Border Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}" Padding="24,14,24,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE719;" FontSize="18" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="620">
                        <TextBlock Text="Workshop" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Componentes de WinForge: instalá, actualizá o desinstalá. Los descargados se cargan al instante."
                                   FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshButton_Click" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Actualizar" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

<!-- ====== CONTENIDO ====== -->
        <ScrollViewer x:Name="WorkshopScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="WorkshopScroll_SizeChanged">
            <StackPanel x:Name="RootPanel" Margin="24,16,24,24" Spacing="14">
                <!-- Buscador centrado, mismo estilo que el de la Biblioteca de juegos:
                     lupa adentro, esquinas redondeadas y 480px de ancho. -->
                <Grid Width="480" HorizontalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Buscar componente..."
                             TextChanged="SearchBox_TextChanged"
                             CornerRadius="8"
                             Padding="36,6,8,6"/>
                    <FontIcon Glyph="&#xE721;"
                              FontSize="14"
                              Foreground="{ThemeResource SecondaryTextBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"
                              IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                <StackPanel x:Name="SectionsHost" Spacing="18"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
