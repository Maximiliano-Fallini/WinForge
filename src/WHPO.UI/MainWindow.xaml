<Window
    x:Class="WHPO_UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="WinForge">

    <!-- El fondo del navbar (panel) se fuerza a negro (oscuro) / blanco (claro) con
         recursos a nivel del propio NavigationView: el key NavigationViewDefaultPaneBackground
         también lo define WinUI y, si se define solo a nivel de app, el override no gana
         y el panel queda con el gris por defecto. -->
    <muxc:NavigationView
        x:Name="NavigationViewControl"
        PaneDisplayMode="Left"
        CompactPaneLength="48"
        OpenPaneLength="256"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        Margin="0,0,0,0"
        Padding="0,0,0,0"
        Background="{ThemeResource NavigationViewDefaultPaneBackground}">

        <muxc:NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF1F242C"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFFFFFFF"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </muxc:NavigationView.Resources>

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Sistema" Tag="sistema">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="AllApps" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Red" Tag="red">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Globe" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Memoria" Tag="memoria">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEEA0;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Resolución del Temporizador" Tag="temporizador">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Clock" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Núcleos y Plan de energía" Tag="nucleos">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE950;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Teclado" Tag="teclado">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE765;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Autoclicker" Tag="autoclicker">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE962;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Test de estabilidad" Tag="estabilidad">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D2;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Monitor de sensores" Tag="sensores">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE957;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Optimizaciones" Tag="optimizaciones">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Repair" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Herramientas y funciones" Tag="herramientas">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Manage" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Panel de Windows" Tag="panelwindows">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="NewWindow" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Reparación" Tag="reparacion">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Refresh" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Windows Update" Tag="actualizaciones">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Download" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationViewItem Content="Configuración" Tag="configuracion">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Setting" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.FooterMenuItems>

        <muxc:NavigationView.Content>
            <muxc:Frame x:Name="ContentFrame" Margin="0,0,0,0" />
        </muxc:NavigationView.Content>
    </muxc:NavigationView>
</Window>
