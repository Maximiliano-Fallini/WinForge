<Window
    x:Class="WHPO_UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="WinForge">

<!-- El fondo del navbar vive en los recursos de tema de la app (App.xaml +
         AccentOverrides.xaml): el key NavigationViewDefaultPaneBackground también
         lo define WinUI, y por eso se redefine en un diccionario mergeado DESPUÉS
         de XamlControlsResources para que el override gane (si se define solo en
         el raíz de App.xaml, el panel queda con el AcrylicBrush por defecto). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<!-- ===== Barra de título PROPIA (48 px) =====
             La barra nativa mide 32 px fijos —los fija Windows según el DPI— y no hay
             API para agrandarla sin dejar de usarla. Por eso la app dibuja la suya, con
             el alto que da TitleBarHeightOption.Tall: 48 px, un 50% más que los 32
             estándar. Los botones de minimizar/maximizar/cerrar los sigue dibujando
             Windows ENCIMA, más altos y con el glifo centrado (ver SetupCustomTitleBar).

             Mismo color que el navbar para que la ventana sea un solo bloque, y el logo
             con el nombre a la izquierda (eso lo mostraba la barra nativa). El resto de
             la barra es la zona de arrastre: doble clic maximiza y clic derecho abre el
             menú del sistema, como en la barra de Windows. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48"
              Background="{ThemeResource NavigationViewDefaultPaneBackground}">
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="14,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <!-- DecodePixelWidth: el PNG es de 1024x1024 (1,3 MB). Sin esto el
                     decodificador reserva un bitmap de ~4 MB para dibujarlo a 22 px. -->
                <Image Width="22" Height="22">
                    <Image.Source>
                        <BitmapImage UriSource="/logos/WinForge.png" DecodePixelWidth="44"/>
                    </Image.Source>
                </Image>
                <TextBlock Text="WinForge" FontSize="13" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

    <muxc:NavigationView
        x:Name="NavigationViewControl"
        Grid.Row="1"
        PaneDisplayMode="Left"
        CompactPaneLength="48"
        OpenPaneLength="256"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        Margin="0,0,0,0"
        Padding="0,0,0,0"
        Background="{ThemeResource NavigationViewDefaultPaneBackground}">

<!-- ====== SET CORE: pestañas "si o si" con la app ====== -->
<!-- Estas 5 + Configuración (footer) NUNCA se ocultan: el resto del navbar se
             genera en código desde ComponentRegistry (navbar dinámico del Workshop). -->
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Sistema" Tag="sistema">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="AllApps" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Red" Tag="red">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Globe" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Núcleos y Plan de energía" Tag="nucleos">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE950;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Biblioteca de juegos" Tag="procesos">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7FC;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Workshop" Tag="workshop">
                <muxc:NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE719;" FontSize="16"/>
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationViewItem Content="Configuración" Tag="configuracion">
                <muxc:NavigationViewItem.Icon>
                    <muxc:SymbolIcon Symbol="Setting" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.FooterMenuItems>

<!-- Selector de idiomas: DENTRO del navbar, en la misma fila del botón ☰ de
             achicar, pegado al extremo derecho del panel. PaneHeader se dibuja en la
             fila superior del panel (columna estirable a la derecha del ☰) y el
             template del control lo colapsa solo cuando el panel queda compacto
             (achicado): ahí el botón de idiomas desaparece, como pediste. -->
        <muxc:NavigationView.PaneHeader>
            <Grid Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LanguageButton"
                            Click="LanguageButton_Click"
                            VerticalAlignment="Center"
                            CornerRadius="10"
                            Padding="10,6"
                            Background="Transparent"
                            BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="LanguageFlagImage" Width="24" Height="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LanguageNameText" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </muxc:NavigationView.PaneHeader>

        <muxc:NavigationView.Content>
            <muxc:Frame x:Name="ContentFrame" Margin="0,0,0,0" />
        </muxc:NavigationView.Content>
    </muxc:NavigationView>

<!-- Botón "Actualizar" sobre el borde de la ventana (barra de título). Es
             HERMANO de AppTitleBar (no hijo) a propósito: SetTitleBar convierte a
             AppTitleBar en zona de arrastre y un botón dentro de ella no recibiría
             clics fiables. Margin derecho ~150 px: deja lugar a los botones de
             ventana (minimizar/maximizar/cerrar) que Windows dibuja encima.
             Aparece con el chequeo al abrir (BeginUpdateCheck): con versión más
             nueva muestra la pastilla de acento "Actualizar" (tooltip "Actualizar
             a vX"); si la build está adelantada al repo, el ícono de info con
             "Versión X en desarrollo". -->
        <Button x:Name="UpdateButton"
                Grid.Row="0"
                Click="UpdateButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="12"
                Padding="12,5"
                Margin="0,0,150,0"
                Background="{StaticResource UpdateButtonBrush}"
                BorderThickness="0"
                BorderBrush="{StaticResource UpdateButtonBrush}">
            <!-- Modo "Actualizar": verde llamativo FIJO (UpdateButtonBrush) con texto en
                 verde casi negro, en TODOS los temas (claro/oscuro/sistema/Rosa/Negro-Azul).
                 Los pinceles viven FUERA de los diccionarios de tema (StaticResource en App.xaml)
                 para que ninguna paleta los pise. ¡OJO con el hover!: el estilo default del Button
                 repinta el fondo con el acento del tema al pasar el mouse — por eso se pisan acá
                 ButtonBackgroundPointerOver/Pressed con verdes fijos (mismos valores que
                 UpdateButtonPointerOverBrush/PressedBrush en App.xaml; ApplyUpdateIndicator
                 los re-afirma en código al volver de "Desarrollo").
                 Modo "Desarrollo": ApplyUpdateIndicator alterna el glifo al de info,
                 quita estos overrides (hover default del tema) y el fondo pasa a tarjeta
                 (ese modo SÍ sigue al tema). -->
            <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF16A34A"/>
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF15803D"/>
            </Button.Resources>
            <StackPanel x:Name="UpdateTextPanel" Orientation="Horizontal" Spacing="7">
                <FontIcon x:Name="UpdateButtonIconGlyph" FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE896;" FontSize="13"
                          Foreground="{StaticResource UpdateButtonForegroundBrush}"/>
                <TextBlock x:Name="UpdateButtonText" Text="Actualizar" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource UpdateButtonForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

<!-- Overlay de arrastre: línea indicadora de dónde va a caer la pestaña que se
     arrastra. IsHitTestVisible=False: es solo feedback visual, no roba input.
     Vive en la misma celda del Grid que el NavigationView, por lo que sus
     coordenadas son 1:1 con las que calcula el drag en MainWindow.xaml.cs. -->
    <Canvas x:Name="NavDragLayer" Grid.Row="1" IsHitTestVisible="False">
        <Border x:Name="NavDragIndicator"
                Height="3"
                CornerRadius="1.5"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="Collapsed" />
    </Canvas>
    </Grid>
</Window>
