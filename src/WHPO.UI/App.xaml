<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WHPO_UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WHPO_UI">
    <Application.Resources>
        <ResourceDictionary>
<!-- Pinceles semánticos por tema (claro/oscuro): el resto de la app usa estos
                 recursos para que el modo claro se vea coherente y legible. -->
            <ResourceDictionary.ThemeDictionaries>
<!-- Paleta: el NAVBAR es negro en oscuro / blanco en claro, y el fondo del
                     contenido es GRIS (más claro que el negro, más oscuro que el blanco) para
                     que el sidebar siempre se diferencie de las vistas. Las cards se separan
                     del fondo por color + borde. -->
                <ResourceDictionary x:Key="Dark">
<!-- Paleta base oscura = ex "Oscuro Negro Test" (estilo Blur-AutoClicker:
                         fondo negro puro #0C0C0E, superficies grises) con el acento AZUL
                         de la app en vez del verde original. El navbar y las cards
                         comparten el gris #151517 (definido también en AccentOverrides.xaml). -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0C0C0E"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF151517"/>
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FF151517"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3A3A3C"/>
<!-- Borde de las CARDS: TRANSPARENTE. Las cards de la app no llevan contorno (ver
                         CardStyle en Controls/Cards.xaml). Antes era un filete al 10 % y además el
                         ajuste de transparencia lo llevaba al tope del vidrio cuando el desenfoque
                         estaba encendido (0,62), así que se veía como un reborde marcado —el caso
                         #19000000 -> #9E000000 del log—. La clave queda declarada para que un tema o
                         un estilo puedan darle contorno cuando sea intencional. -->
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF9FA0A2"/>
<!-- Texto principal del tema, para lo que se pinta desde código: mismo valor que el
                         TextFillColorPrimaryBrush de WinUI en oscuro. Ver ThemeBrushes/FanIcon: las claves
                         del sistema NO se pueden pedir desde código, porque se resuelven con el tema del
                         SISTEMA y no con el que eligió la app (sistema oscuro + app clara = icono blanco
                         sobre fondo blanco). -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF"/>

<!-- Acento de la app: azul claro (identidad de la app). -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF8AB4F8"/>
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF101418"/>

<!-- Gráficas (uso/temperatura/potencia): fondo y paleta de series. -->
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FF0A0A0C"/>
                    <SolidColorBrush x:Key="ChartBackgroundHotBrush" Color="#FF150B0B"/>
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#FF202022"/>
                    <SolidColorBrush x:Key="ChartCrosshairBrush" Color="#FF4A4A4C"/>
                    <SolidColorBrush x:Key="ChartAxisTextBrush" Color="#FF808082"/>
                    <SolidColorBrush x:Key="ChartHoverBadgeBgBrush" Color="#FF202022"/>
                    <SolidColorBrush x:Key="ChartHoverBadgeBorderBrush" Color="#FF3A3A3C"/>
                    <SolidColorBrush x:Key="ChartHoverTextBrush" Color="#FFF2F4F8"/>

<!-- Colores semánticos de métricas (series y valores destacados). -->
                    <SolidColorBrush x:Key="MetricUsageBrush" Color="#FF4CC2C9"/>
                    <SolidColorBrush x:Key="MetricTempBrush" Color="#FF4CC257"/>
                    <SolidColorBrush x:Key="MetricPowerBrush" Color="#FFFFC93C"/>

<!-- Grilla del Monitor de sensores (grupos = color de card/navbar). -->
                    <SolidColorBrush x:Key="SensorGridLineBrush" Color="#FF3A3A3C"/>
                    <SolidColorBrush x:Key="SensorGroupFillBrush" Color="#FF151517"/>
                    <SolidColorBrush x:Key="SensorCategoryFillBrush" Color="#FF141416"/>

<!-- Card "Desactivar actualizaciones" (intencionalmente oscura/roja). -->
                    <SolidColorBrush x:Key="DisabledCardBackgroundBrush" Color="#FF2B1C1C"/>
                    <SolidColorBrush x:Key="DisabledCardTextBrush" Color="#FFFFC1BC"/>

<!-- Hover/selección de cards en code-behind (Optimizaciones) y tint del acento (Panel Windows). -->
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF242424"/>
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#FF262626"/>
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#228AB4F8"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF9A9A9C"/>

<!-- Asistente de primera configuración: fondo con gradiente oscuro. -->
                    <LinearGradientBrush x:Key="OnboardingBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.0" Color="#FF0C0C0E"/>
                            <GradientStop Offset="0.55" Color="#FF141722"/>
                            <GradientStop Offset="1.0" Color="#FF1A2233"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>

<!-- Capa sobre el banner del asistente: oscurece en tema oscuro. -->
                    <SolidColorBrush x:Key="OnboardingScrimBrush" Color="#55000000"/>
                    <SolidColorBrush x:Key="OnboardingSurfaceBrush" Color="#D9151517"/>

<!-- Chips de instrucciones del procesador (Sistema). -->
                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FF262626"/>

<!-- Cards de núcleos (Núcleos): mismo color que las cards/navbar. -->
                    <SolidColorBrush x:Key="CoreCardBackgroundBrush" Color="#FF151517"/>
                    <SolidColorBrush x:Key="CoreTrackBackgroundBrush" Color="#FF0F0F11"/>

<!-- ===== Capa de fondo de la ventana (ver MainWindow.xaml) =====
                         Piezas del fondo: el relleno base y dos resplandores radiales que
                         se colocan en las esquinas de la ventana. Acá —en los temas
                         clásicos— el relleno es un color PLANO igual al del fondo de las
                         páginas y los resplandores van transparentes: la capa existe pero no
                         se ve, así que estos temas se ven exactamente igual que antes. Los
                         temas con backdrop propio (Marea) los pisan desde
                         ThemePalettes con un gradiente. -->
                    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#FF0C0C0E"/>
                    <SolidColorBrush x:Key="WindowGlowABrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="WindowGlowBBrush" Color="#00000000"/>

<!-- ===== Fondo de la VENTANA (imagen del tema, ver MainWindow.xaml) =====
                         Va detrás de TODO: menú, barra de título y contenido. Acá —temas
                         clásicos— está vacía (transparente), así la ventana se ve como
                         siempre; los temas con fondo propio (Marea, Aurora y
                         Brasa) la pisan desde su archivo en Themes\ con un ImageBrush y
                         dejan transparentes el fondo de las páginas y el del contenido del
                         NavigationView para que la imagen se vea a través de ellos. -->
                    <SolidColorBrush x:Key="WindowWallpaperBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="WindowWallpaperScrimBrush" Color="#00000000"/>

<!-- ===== Botón "Actualizar" de la barra de título =====
                         Pastilla del ACENTO del tema: el azul de la app acá (en los temas
                         clásicos) y el acento de cada tema con paleta propia en los suyos,
                         que sale de los colores de su imagen de fondo (menta en Aurora,
                         naranja en Brasa, turquesa en Marea). Vive en
                         los diccionarios de tema para que ThemePalettes lo escriba junto
                         con el resto de la paleta y el snapshot lo restaure al volver a un
                         tema clásico. El texto es el mismo par del tema
                         (AccentBrush/AccentForegroundBrush): oscuro sobre el azul claro, con
                         mucho contraste; hover/pressed son la rampa del acento
                         (SystemAccentColorLight1/Dark1). ApplyUpdateIndicator lo aplica desde
                         código con pinceles live (ver MainWindow.xaml.cs). -->
                    <SolidColorBrush x:Key="UpdateButtonBrush" Color="#FF8AB4F8"/>
                    <SolidColorBrush x:Key="UpdateButtonForegroundBrush" Color="#FF101418"/>
                    <SolidColorBrush x:Key="UpdateButtonPointerOverBrush" Color="#FFA2C2FA"/>
                    <SolidColorBrush x:Key="UpdateButtonPressedBrush" Color="#FF6D9EF6"/>

<!-- ===== Desenfoque de paneles =====
                         El desenfoque NO es una capa de ventana: con el deslizador encendido,
                         el relleno de CADA superficie (cards, menú, chips) pasa a un pincel
                         acrílico con el color del panel como tinte — cada panel desenfoca la
                         imagen del fondo a través de su propio relleno, y lo no tapado queda
                         nítido. Los pinceles los arma PanelAppearance en tiempo de ejecución
                         (WriteSurfaceBrush), así que acá no se declara ningún recurso. -->
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFE8EAEE"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFD8DDE3"/>
<!-- Ver la nota del tema oscuro: las cards no llevan contorno, la clave queda
                         declarada en transparente para un contorno intencional. -->
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5C6470"/>
<!-- Ver la nota del tema oscuro: mismo valor que el TextFillColorPrimaryBrush de WinUI en claro
                         (#E4000000), para que en el caso normal el icono se vea exactamente igual que antes. -->
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4000000"/>

<!-- Acento de la app en claro: azul más saturado, legible sobre blanco. -->
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF3D7EDB"/>
                    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF101418"/>

<!-- Gráficas: fondo claro con series más oscuras para contraste. -->
                    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FFF4F6F8"/>
                    <SolidColorBrush x:Key="ChartBackgroundHotBrush" Color="#FFFBE9EC"/>
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#FFD8DEE6"/>
                    <SolidColorBrush x:Key="ChartCrosshairBrush" Color="#FF98A2B0"/>
                    <SolidColorBrush x:Key="ChartAxisTextBrush" Color="#FF5D636B"/>
                    <SolidColorBrush x:Key="ChartHoverBadgeBgBrush" Color="#FFE8EEF6"/>
                    <SolidColorBrush x:Key="ChartHoverBadgeBorderBrush" Color="#FFB8C4D4"/>
                    <SolidColorBrush x:Key="ChartHoverTextBrush" Color="#FF1A1A1A"/>

                    <SolidColorBrush x:Key="MetricUsageBrush" Color="#FF2AA0A8"/>
                    <SolidColorBrush x:Key="MetricTempBrush" Color="#FF3A9A4A"/>
                    <SolidColorBrush x:Key="MetricPowerBrush" Color="#FFC99600"/>

                    <SolidColorBrush x:Key="SensorGridLineBrush" Color="#FFD8DEE6"/>
                    <SolidColorBrush x:Key="SensorGroupFillBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="SensorCategoryFillBrush" Color="#FFEFF1F4"/>

                    <SolidColorBrush x:Key="DisabledCardBackgroundBrush" Color="#FFFBE9E6"/>
                    <SolidColorBrush x:Key="DisabledCardTextBrush" Color="#FF8A4A42"/>

                    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFF0F2F5"/>
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#FFE2E9F6"/>
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#223D7EDB"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#FF6E7683"/>

<!-- Asistente de primera configuración: fondo con gradiente claro. -->
                    <LinearGradientBrush x:Key="OnboardingBackdropBrush" StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.GradientStops>
                            <GradientStop Offset="0.0" Color="#FFEFF2F7"/>
                            <GradientStop Offset="0.55" Color="#FFE3EAF5"/>
                            <GradientStop Offset="1.0" Color="#FFD6E2F5"/>
                        </LinearGradientBrush.GradientStops>
                    </LinearGradientBrush>

<!-- Capa sobre el banner del asistente: aclara en tema claro. -->
                    <SolidColorBrush x:Key="OnboardingScrimBrush" Color="#73FFFFFF"/>
                    <SolidColorBrush x:Key="OnboardingSurfaceBrush" Color="#E6FFFFFF"/>

                    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#FFEFF1F4"/>

                    <SolidColorBrush x:Key="CoreCardBackgroundBrush" Color="#FFF4F6F8"/>
                    <SolidColorBrush x:Key="CoreTrackBackgroundBrush" Color="#FFE6EAEF"/>

<!-- Capa de fondo de la ventana: ver la nota del tema oscuro (acá el relleno
                         plano es el mismo gris claro del fondo de las páginas). -->
                    <SolidColorBrush x:Key="WindowBackdropBrush" Color="#FFE8EAEE"/>
                    <SolidColorBrush x:Key="WindowGlowABrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="WindowGlowBBrush" Color="#00000000"/>
<!-- Ver la nota del tema oscuro: en los temas clásicos el fondo de la ventana va vacío. -->
                    <SolidColorBrush x:Key="WindowWallpaperBrush" Color="#00000000"/>
                    <SolidColorBrush x:Key="WindowWallpaperScrimBrush" Color="#00000000"/>

<!-- Botón "Actualizar" (ver la nota del tema oscuro): en claro el texto es BLANCO, así
                         que la pastilla arranca en el escalón oscuro del acento
                         (SystemAccentColorDark1) para conservar el contraste; el hover sube
                         al acento y el pressed baja un escalón más (Dark2). -->
                    <SolidColorBrush x:Key="UpdateButtonBrush" Color="#FF2C63B8"/>
                    <SolidColorBrush x:Key="UpdateButtonForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="UpdateButtonPointerOverBrush" Color="#FF3D7EDB"/>
                    <SolidColorBrush x:Key="UpdateButtonPressedBrush" Color="#FF2554A1"/>


                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
<!-- Override del acento del sistema: DEBE ir después de XamlControlsResources
                     para que sus claves ganen el lookup (si va antes, el diccionario de
                     XamlControlsResources pisa el azul con el acento del sistema). -->
                <ResourceDictionary Source="Controls/AccentOverrides.xaml"/>
<!-- Reusable Controls - Phase 4 -->
                <ResourceDictionary Source="Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Controls/Cards.xaml"/>
                <ResourceDictionary Source="Controls/Toggles.xaml"/>
                <ResourceDictionary Source="Controls/Dialogs.xaml"/>
                <ResourceDictionary Source="Controls/Notifications.xaml"/>
                <ResourceDictionary Source="Controls/CustomControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
<!-- Paleta de estado (coincide con Feedback.cs) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50"/>
<!-- Fondo de una pastilla de estado (mismo verde, con alfa): vive con SuccessBrush, FUERA de
                 los diccionarios de tema, porque el verde de "disponible" no cambia entre claro y
                 oscuro — igual que el del propio SuccessBrush. -->
            <SolidColorBrush x:Key="SuccessTintBrush" Color="#284CAF50"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC107"/>
<!-- Fondo de una tarjeta de advertencia (mismo ámbar, con alfa): acompaña a WarningBrush
                 y vive igual de fijo en los dos temas, como el verde de SuccessTintBrush. -->
            <SolidColorBrush x:Key="WarningTintBrush" Color="#28FFC107"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#FFF0616D"/>
<!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
