<Window
    x:Class="WHPO_UI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bienvenido a WinForge">

    <Grid x:Name="RootGrid" Background="{ThemeResource OnboardingBackdropBrush}">
        <Grid.Resources>
            <Style x:Key="OnboardingCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource OnboardingSurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="OnboardingOptionStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
        </Grid.Resources>

        <Image Source="/logos/backgroundinstaller/banner.png"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>
        <Border Background="{ThemeResource OnboardingScrimBrush}" IsHitTestVisible="False"/>

        <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
<!-- Cabecera: logo + marca SOLOS. El subtítulo va fuera de la fila porque es lo único que
             cambia con el idioma y su largo define el ancho de la fila: centrada como unidad,
             el logo y el título se corrían horizontalmente al cambiar de idioma (en alemán
             quedaban pegados al borde, en chino bien adentro). "WinForge" es igual en todos
             los idiomas, así que la fila ahora mide lo mismo siempre y no se mueve nunca. -->
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                <Image Source="/logos/WinForge.png" Width="64" Height="64" VerticalAlignment="Center"/>
                <TextBlock Text="WinForge" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
<!-- Subtítulo: línea propia, centrada y con wrap (sin él, los idiomas largos se
             recortaban al tope de 640 px). -->
            <TextBlock x:Name="SubtitleText" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}"
                       TextWrapping="Wrap" TextAlignment="Center"/>

<!-- Altura FIJA de la card: las fases tienen distinto contenido y, si la
                 card creciera/encogiera, los botones de abajo saltarían de posición
                 (rompe el feedback visual al pasar de fase). El contenido de cada
                 fase se centra en la fila sobrante. -->
<!-- El tema del onboarding se aplica SOLO a esta card (la "ventana"):
                 el fondo (RootGrid: banner + scrim) queda fijo y no cambia al tocar
                 los temas, y los botones de tema usan colores literales fijos.
                 La barra de título de la ventana SÍ reacciona al tema (se colorea
                 desde UpdateOnboardingTheme). En la app, en cambio, el tema sí
                 afecta al fondo porque ThemeApplier aplica RequestedTheme al
                 contenido raíz de MainWindow. -->
<!-- La altura fija sube a 360: el escalón más alto es el del tema (sube a ~190 con las
                 tres mini-ventanas) y, al estar el contenido centrado en una fila de alto fijo,
                 un contenido más alto se recortaba por arriba y por abajo. Con 360 entra el peor
                 caso —tema, o idioma con el subtítulo en 2 líneas y el estado de descarga
                 visible— con margen, y los botones no saltan entre fases porque la altura sigue
                 siendo la misma para las tres. -->
            <Border x:Name="ContentCard" Style="{StaticResource OnboardingCardStyle}" Padding="28" Height="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

<!-- Riel de fases: su propia fila, arriba y centrado. Cada paso es su punto (o pastilla
                     ancha si es el actual) con el rótulo debajo; los tres escalones miden igual,
                     así la card —de alto fijo— no cambia de tamaño al avanzar. -->
                    <StackPanel x:Name="ProgressDots" Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,20"/>

<!-- ===== FASE 1: IDIOMA =====
                         El asistente arranca acá: el idioma decide en qué idioma se ve todo
                         lo demás. Un desplegable con bandera + nombre; los idiomas que la app
                         no trae llevan la marca de descarga y, al elegirlos, se bajan del
                         repositorio en el momento y quedan activos. -->
                    <StackPanel x:Name="PhaseLanguage" Grid.Row="1" Spacing="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Elegí tu idioma" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="WinForge ya está en el idioma de tu PC. Elegí otro de la lista: si no está instalado, se descarga solo."
                                   FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
<!-- El anillo de descarga vive en una columna de ancho FIJO: al aparecer no corre
                             al desplegable de lugar. -->
                        <Grid HorizontalAlignment="Center" ColumnSpacing="10" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LanguageComboBox" MinWidth="280" MaxWidth="320"
                                      HorizontalAlignment="Center"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                            <ProgressRing x:Name="LanguageDownloadRing" Grid.Column="1"
                                          Width="18" Height="18" Opacity="0" IsActive="False"
                                          IsIndeterminate="True" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="LanguageStatusText" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

<!-- ===== FASE 2: TEMA ===== -->
                    <StackPanel x:Name="PhaseTheme" Grid.Row="1" Spacing="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="Elegí el tema" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tu apariencia, tu estilo. Podés cambiarlo en Configuración."
                                   FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <Grid Width="476" ColumnSpacing="12" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

<!-- ===== Oscuro =====
                                 Colores LITERALES fijos (no reactivos al tema): el preview es
                                 SIEMPRE una mini-ventana oscura con barra de título y líneas de
                                 contenido, toque el tema que se toque. -->
                            <Border x:Name="ThemeDarkCard" Style="{StaticResource OnboardingOptionStyle}" Padding="10,14,10,12"
                                    Grid.Column="0" Tapped="ThemeOption_Tapped"
                                    Background="#1E1E1E" BorderBrush="#3F3F3F">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="56" HorizontalAlignment="Center">
                                        <Border CornerRadius="8" Background="#141414" BorderBrush="#454545" BorderThickness="1">
                                            <StackPanel>
<!-- Barra de título de la mini-ventana -->
                                                <Border Height="11" Background="#262626" CornerRadius="7,7,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="9,8,9,0" Spacing="5">
                                                    <Border Height="5" Width="44" CornerRadius="2.5" Background="#4A4A4A" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="32" CornerRadius="2" Background="#333333" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="24" CornerRadius="2" Background="#2A2A2A" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ThemeDarkCheck" Width="20" Height="20" CornerRadius="10"
                                                Background="{ThemeResource AccentBrush}" BorderThickness="2" BorderBrush="#1E1E1E"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-7,-7,0" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Oscuro" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

<!-- ===== Claro =====
                                 Colores LITERALES fijos: el preview es SIEMPRE una mini-ventana
                                 blanca, independientemente del tema elegido. -->
                            <Border x:Name="ThemeLightCard" Style="{StaticResource OnboardingOptionStyle}" Padding="10,14,10,12"
                                    Grid.Column="1" Tapped="ThemeOption_Tapped"
                                    Background="#FFFFFF" BorderBrush="#C9C9C9">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="56" HorizontalAlignment="Center">
                                        <Border CornerRadius="8" Background="#FFFFFF" BorderBrush="#C9C9C9" BorderThickness="1">
                                            <StackPanel>
                                                <Border Height="11" Background="#F1F1F1" CornerRadius="7,7,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="9,8,9,0" Spacing="5">
                                                    <Border Height="5" Width="44" CornerRadius="2.5" Background="#C4C4C4" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="32" CornerRadius="2" Background="#DDDDDD" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="24" CornerRadius="2" Background="#E8E8E8" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ThemeLightCheck" Width="20" Height="20" CornerRadius="10"
                                                Background="{ThemeResource AccentBrush}" BorderThickness="2" BorderBrush="#FFFFFF"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-7,-7,0" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Claro" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#111111"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

<!-- ===== Usar sistema =====
                                 Colores LITERALES fijos: el preview es SIEMPRE una mini-ventana
                                 partida (mitad oscura / mitad clara). -->
                            <Border x:Name="ThemeSystemCard" Style="{StaticResource OnboardingOptionStyle}" Padding="10,14,10,12"
                                    Grid.Column="2" Tapped="ThemeOption_Tapped"
                                    Background="#FFFFFF" BorderBrush="#C9C9C9">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Grid Width="84" Height="56" HorizontalAlignment="Center">
<!-- Mitad oscura (izquierda) -->
                                        <Border Width="42" HorizontalAlignment="Left" CornerRadius="8,0,0,8"
                                                Background="#141414" BorderBrush="#454545" BorderThickness="1,1,0,1">
                                            <StackPanel>
                                                <Border Height="11" Background="#262626" CornerRadius="7,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                        <Ellipse Width="3" Height="3" Fill="#4A4A4A"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="6,8,0,0" Spacing="5">
                                                    <Border Height="5" Width="20" CornerRadius="2.5" Background="#4A4A4A" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="14" CornerRadius="2" Background="#333333" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
<!-- Mitad clara (derecha) -->
                                        <Border Width="42" HorizontalAlignment="Right" CornerRadius="0,8,8,0"
                                                Background="#FFFFFF" BorderBrush="#C9C9C9" BorderThickness="0,1,1,1">
                                            <StackPanel>
                                                <Border Height="11" Background="#F1F1F1" CornerRadius="0,7,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center" Spacing="3">
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                        <Ellipse Width="3" Height="3" Fill="#C4C4C4"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Margin="6,8,0,0" Spacing="5">
                                                    <Border Height="5" Width="20" CornerRadius="2.5" Background="#C4C4C4" HorizontalAlignment="Left"/>
                                                    <Border Height="4" Width="14" CornerRadius="2" Background="#DDDDDD" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ThemeSystemCheck" Width="20" Height="20" CornerRadius="10"
                                                Background="{ThemeResource AccentBrush}" BorderThickness="2" BorderBrush="#FFFFFF"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-7,-7,0" Visibility="Collapsed">
                                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Usar sistema" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#111111"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

<!-- ===== FASE 3: ANTIVIRUS (salud de la exclusión de Defender) =====
                         WinForge toca el sistema, así que Defender puede marcarlo como
                         sospechoso; el instalador agrega las exclusiones para que no lo
                         bloquee. Acá se VERIFICAN en vivo (cada medio segundo mientras la
                         fase está en pantalla): el estado se lee del registro de Defender,
                         que es el mismo dato que usa el instalador. -->
                    <StackPanel x:Name="PhaseHealth" Grid.Row="1" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock Text="WinForge y tu antivirus" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Windows Defender puede marcar a WinForge como sospechoso porque optimiza el sistema. Estas son las exclusiones que lo evitan, y se verifican en vivo."
                                   FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>

<!-- Veredicto general: ícono + color + frase. Lo llena el código en cada
                             verificación (ver RenderHealth). -->
                        <Border x:Name="HealthBanner" CornerRadius="10" Padding="12,10" BorderThickness="1"
                                Margin="0,4,0,0" HorizontalAlignment="Center" MinWidth="420"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon x:Name="HealthBannerIcon" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HealthBannerText" FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

<!-- Una fila por exclusión esperada: las arma el código (BuildHealthRows) y
                             solo se ACTUALIZAN en cada verificación, no se recrean. -->
                        <StackPanel x:Name="HealthRowsHost" Spacing="4" Margin="0,4,0,0" HorizontalAlignment="Center"/>
<!-- Solo aparece si una acción falla (agregar la exclusión, abrir la ubicación):
                             el estado de cada fila se verifica en vivo, así que no hay nada que
                             anunciar cuando todo sale bien. -->
                        <TextBlock x:Name="HealthActionText" FontSize="11"
                                   Foreground="{ThemeResource SecondaryTextBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                                   Visibility="Collapsed"/>
                    </StackPanel>

<!-- ===== FASE 4: GRATIS + ESTRELLA ===== -->
                    <StackPanel x:Name="PhaseThanks" Grid.Row="1" Spacing="14" VerticalAlignment="Center" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </StackPanel.RenderTransform>
                        <FontIcon Glyph="&#xE734;" FontSize="34" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="100% Gratuito" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="WinForge es totalmente gratuito y lo seguirá siendo: todas las funciones están desbloqueadas. Si te resulta útil, apoyalo con una estrella."
                                   FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="StarButton" Content="Dejar una estrella en GitHub" Style="{StaticResource AccentButtonStyle}"
                                Padding="16,10" HorizontalAlignment="Center" Click="StarButton_Click"/>
                    </StackPanel>

                </Grid>
            </Border>

            <Grid ColumnSpacing="10" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="Atrás" Visibility="Collapsed" Click="BackButton_Click" Padding="18,10"/>
                <Button x:Name="NextButton" Content="Continuar" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        Padding="22,10" Click="NextButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
